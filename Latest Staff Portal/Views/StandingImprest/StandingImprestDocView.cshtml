@model Latest_Staff_Portal.ViewModel.NewStandingImprest
@{
    ViewBag.Title = "StandingImprestDocView";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    hr {
        margin: 4px;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div style="background-color: black;">
    <a href="#" onclick="ImprestRequisitionLink();" style="color:yellow"><<< Back To Standing Imprest Requisition List</a>
</div>
<div class="card">
    <div class="card-title">Standing Imprest Document Details(@Model.DocNo)</div>
    <hr />
    @*<div style="text-align:right" id="HideEditButton">
            <input type="button" class="btn btn-danger BtnPadding" id="btnEdit" value="Edit Header" onclick="EditDocument();" />
            <hr />
        </div>*@
    <div style="border:2px solid">
        <div class="card-body">
            <b>Receiving Details</b>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Recieving Region", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Dim1, Model.ListOfDim1, "--select Receiving Station--", new { @class = "form-control", @id = "ddlDim1" })
                            @Html.ValidationMessageFor(model => model.Dim1, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Receiving Unit/Station", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Dim2, Model.ListOfDim2, "--select Receiving Station--", new { @class = "form-control", @id = "ddlDim2" })
                            @Html.ValidationMessageFor(model => model.Dim2, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Reciept Responsibility Center", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.RespC, Model.ListOfResponsibility, "--select Reciept Responsibility Center--", new { @class = "form-control", @id = "ddlRespC" })
                            @Html.ValidationMessageFor(model => model.RespC, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Receiving Account", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Receiving_BnkAccount, Model.ListOfBankAccounts, "--select Receiving Account--", new { @class = "form-control", @id = "ddlBankAccount" })
                            @Html.ValidationMessageFor(model => model.Receiving_BnkAccount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Receiving Amount", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(model => model.Receiving_Amount, new { @class = "form-control", @id = "txtReceivingAmount" })
                            @Html.ValidationMessageFor(model => model.Receiving_Amount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        @Html.Label("Remarks", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control", @id = "txtRemarks" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        <div class="card-body">
            <b>Sending Details</b>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Sending Region", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Dim11, Model.ListOfDim1, "--select sending Station--", new { @class = "form-control", @id = "ddlDim11" })
                            @Html.ValidationMessageFor(model => model.Dim11, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Sending Unit/Station", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Dim21, Model.ListOfDim2, "--select sending Station--", new { @class = "form-control", @id = "ddlDim21" })
                            @Html.ValidationMessageFor(model => model.Dim21, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Sending Responsibility Center", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.RespC1, Model.ListOfResponsibility, "--select Sending Responsibility Center--", new { @class = "form-control", @id = "ddlRespC1" })
                            @Html.ValidationMessageFor(model => model.RespC, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label("Sending Account", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Sending_BnkAccount, Model.ListOfBankAccounts1, "--select sending Account--", new { @class = "form-control", @id = "ddlSendingBank" })
                            @Html.ValidationMessageFor(model => model.Receiving_BnkAccount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <b>Attachments</b>
                    <div id="divAttachDocs"></div>
                </div>
            </div>
            <hr style="border:1px solid black" />
            <div align="right" id="DivSendForApproval">
                <input type="button" class="btn btn-danger BtnPadding" value="Send For Approval >>>" onclick="SendDocForApproval();" />
            </div>
            <hr />
        </div>
    </div>
</div>

@*//////////////////////Modal View Doc////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">Attachment</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
        GetDocumentAttachments();
    });
    var GetDocumentAttachments = function () {
        ShowProgress();
        var DocNo = `@Model.DocNo`;
        var Status = `@Model.Status`;
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ DocNo: DocNo, TableID: 70135167, Status: Status}),
            url: "/Common/DocumentAttachments",
            success: function (data) {
                HideProgress();
                $("#divAttachDocs").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var ImprestRequisitionLink = function () {
        ShowProgress();
        window.location = "/StandingImprest/StandingImprestRequisitionList";
    }
    var AddAttachment = function () {
        $("#lblTitl").text("File Upload");
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            datatype: "html",
            url: '/StandingImprest/FileUploadForm',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var SaveDocAttachmentFile = function () {
        var DocNo = `@Model.DocNo`;
        var filename; var base64String; var filetype;
        var files = document.getElementById('DocfileAttachment').files;
        if (files.length) {
            ShowProgress();
            var file = files[0];
            if (file.size > 10000000) {
                Swal.fire('Warning', 'Please only files less than 10MB allowed. Thanks!!', 'warning');
            }
            else {
                var blob = file.slice();
                filetype = file.type;
                filename = file.name;
                var reader = new FileReader();
                reader.onloadend = function (evt) {
                    if (evt.target.readyState == FileReader.DONE) { // DONE == 2
                        var cont = evt.target.result
                        base64String = getB64Str(cont);
                        //Send the JSON array to Controller using AJAX.
                        $.ajax({
                            type: "POST",
                            url: "/Common/SaveAttachedFile",
                            data: JSON.stringify({ DocNo: DocNo, base64Upload: base64String, fileName: filename, Extn: filetype, TableID: 70135167 }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            traditional: true,
                            async: false,
                            cache: false,
                            success: function (data) {
                                if (data.success) {
                                   HideProgress();
                                    GetDocumentAttachments();
                                    $("#myModal").modal("hide");
                                    Swal.fire('Success', data.message, 'success');
                                }
                                else {
                                    Swal.fire('Warning', data.message, 'warning');
                                    HideProgress();
                                }
                            },
                            error: function (err) {
                                HideProgress();
                                Swal.fire('Warning', err.Message, 'warning');
                            }
                        });
                    }
                };
                reader.readAsArrayBuffer(blob);
            }
        }
    };
    function getB64Str(buffer) {
        var binary = '';
        var bytes = new Uint8Array(buffer);
        var len = bytes.byteLength;
        for (var i = 0; i < len; i++) {
            binary += String.fromCharCode(bytes[i]);
        }
        return window.btoa(binary);
    }
    var ViewAttachment = function (tbl, No, Id,fName, ext) {
        $.ajaxSetup({ cache: false });
        ShowProgress();
        $.ajax({
            cache: false,
            url: '/Common/DocumentAttachmentview',
            type: "POST",
            datatype: "json",
            cache: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ tblID: tbl, No: No, ID: Id, fileName: fName, ext: ext }),
            success: function (data) {
                console.log(data.message);
                if (data.success == true) {
                    if (data.view == true) {
                        var viewer = $("#modalAttachmentBody");
                        if (ext == "pdf") {
                            PDFObject.embed("data:application/" + ext + ";base64," + data.message + "", viewer);
                        }
                        if (ext == "png" || ext == "jpg") {
                            PDFObject.embed("data:image/" + ext + ";base64," + data.message + "", viewer);
                        }
                        $("#myModalAttachment").modal("show");
                        HideProgress();
                    }
                    else {
                        window.location = '/Common/AttachmentDownload?fileName=' + data.message;
                        Swal.fire('Success', 'Document Downloaded successfully', 'success');
                        HideProgress();
                    }
                }
                else {
                    HideProgress();
                    console.log(data.message);
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                HideProgress();
                console.log(err.responseText);
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var DeleteAttachment = function (tbl, No, Id) {
        $.ajaxSetup({ cache: false });
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    cache: false,
                    url: '/Common/DeleteAttachedDocument',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ DocNo: No, tblID: tbl, DocID: Id }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            GetDocumentAttachments();
                            Swal.fire('Success', 'File Deleted Successfully', 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Attachment File has not been deleted', 'error');
            }
        });
    };
    var SendDocForApproval = function () {
        var DocNo = `@Model.DocNo`;
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, Redirect: "Y" }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/StandingImprest/SendForApproval',
            success: function (data) {
                if (data.success == true) {
                    if (data.LogOut == true) {
                        window.location = data.message;
                    }
                    else {
                        window.location = "/StandingImprest/StandingImprestRequisitionList";
                    }
                }
                else {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

