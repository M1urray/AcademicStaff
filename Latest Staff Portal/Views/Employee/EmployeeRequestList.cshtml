    var ViewApprovalTrail = function (docNo) {
        $("#labelF").text("Document Approval Trail");
        window.ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: docNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Common/DocumentApprovalTrail',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalLinks").modal("hide");
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var ViewDocComments = function (docNo) {
        $("#labelF").text("Document Comments");
        window.ShowProgress();
        var RecordID = "Purchase Header: Quote," + docNo;
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ RecID: RecordID }),
            contentType: "application/json; charset = utf-8",
