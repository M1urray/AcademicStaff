@model Latest_Staff_Portal.ViewModel.PurchaseQuote
@if (Model.Status == "Open")
{
    <div>
        <a href="#" onclick="ConfirmDoc('@Model.No');" class="btn btn-primary BtnPadding">Confirm Document</a>
    </div>
    <hr/>
}
<div class="row">
    <div class="col-md-6">
        <b>Vendor</b>
        @Html.TextBoxFor(m => m.BuyFromVendorName, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Document Date</b>
        @Html.TextBoxFor(m => m.DocumentDate, new { @class = "form-control", @readonly = "readonly" })
    </div>

</div>
<div class="row">
    <div class="col-md-6">
        <b>RFQ No</b>
        @Html.TextBoxFor(m => m.RfqNo, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>PRF No</b>
        @Html.TextBoxFor(m => m.PrfNo, new { @class = "form-control", @readonly = "readonly" })
    </div>

</div>
<div class="row">
    <div class="col-md-6">
        <b>Posting Description</b>
        @Html.TextBoxFor(m => m.PostingDescription, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Expected Closing Date</b>
        @Html.TextBoxFor(m => m.ExpectedClosingDate, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <b>Status </b>
        @Html.TextBoxFor(m => m.Status, new { @class = "form-control", @readonly = "readonly" })
    </div>

</div>
<hr style="border:1px solid black" />
<b>Purchase Lines</b>
<hr />
<div class="pre-scrollable">
    <table class="table table-hover" id="PRVLines">
        <thead>
            <tr>
                <th>Type</th>
                <th>Item</th>
                <th>Description</th>
                <th>Description 2</th>
                <th>Store</th>
                <th class="text-center">Quantity</th>
                <th>Unit Measure</th>
                <th class="text-left">Unit Amount</th>
                <th class="text-left">Amount</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfPurchaseLines != null && Model.ListOfPurchaseLines.Any())
                {
                    foreach (var item in Model.ListOfPurchaseLines)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.LineType)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Item)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ItemDesc)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description2)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Location)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.Qnty)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UnitM)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.Amount)
                            </td>
                            <td class="text-left">
                                @Html.DisplayFor(modelItem => item.LineAmount)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
