@model Latest_Staff_Portal.ViewModel.LocationList
<style>
    .ui-front {
        z-index: 2000 !important;
    }

    .ui-autocomplete {
        /* these sets the height and width */
        max-height: 200px;
        max-width: 236px;
        /* these make it scroll for anything outside */
        overflow-x: scroll;
        overflow-y: scroll;
    }
</style>
<div class="bg-soft-dark" style="color:black">
    <div class="row" id="DivService">
        <div class="col-md-6">
            Search Item
            <input type="text" class="form-control" id="IdItems" />
        </div>
        <div class="col-md-6">
            Quantity
            <input type="text" class="form-control" id="txtQuantity" onkeypress="return functionx(event)" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            Issuing Store
            @Html.DropDownListFor(model => model.Code, Model.ListOfLocations, "--select Location--", new { @class = "form-control", @id = "ddlLocation" })

        </div>
        <div class="col-md-6">
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            Description(50 Characters)
            <textarea id="txtDescription" class="form-control" maxlength="50"></textarea>
        </div>
    </div>
    <hr />
    <div align="center">
        <input type="button" class="btn btn-primary waves-effect waves-light" value="Add Line" onclick="AddLineItem();" />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        GetItemList();
        $("#ddlLocation").select2({
            width: '100%'
        });
    });
    var GetItemList = function () {
        ShowProgress();
        var url;
        url = '@Url.Action("GetItemList", "Common")',
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: url,
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    $(function () {
        $('#IdItems').autocomplete({
            source: function (request, response) {
                ShowProgress();
                $.getJSON('@Url.Action("GetItem", "Common")', { Item: request.term },
                    function (data) {
                        response(data.ItemList);
                        appendTo: "#IdItems"
                    });
                HideProgress();
            },
            minLength: 1,
        });
    });

    function functionDecimal(evt, val) {
        try {
            var charCode = (evt.which) ? evt.which : event.keyCode;

            if (charCode == 46) {
                if (!(val.indexOf(".") > -1)) {
                    return true;
                }
                else {
                    Swal.fire('Warning', 'Kindly ensure to specify decimals only', 'warning');
                }
            }
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                Swal.fire('Warning', 'Kindly ensure to specify decimals only', 'warning');
                return false;
            }
            return true;
        } catch (w) {
            Swal.fire(w);
        }
    }
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>

