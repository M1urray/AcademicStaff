@model Latest_Staff_Portal.ViewModel.NewStoreRequisition
@{
    ViewBag.Title = "NewStoreRequest";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<div style="background-color: black;">
    <a href="#" onclick="StoreRequisitionLink();" style="color:yellow"><<< Back To Store Requisition List</a>
</div>
<div class="card pre-scrollable">
    <div class="card-body">
        <b>Store Header</b>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Date required:", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <input type="datetime" class="form-control" placeholder="dd/mm/yyyy" id="dtPicker" onkeydown="return false;" autocomplete="off" />
                        <div class='a'></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Campus", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Campus, Model.ListOfCampus, "--select Campus--", new { @class = "form-control", @id = "ddlCampus" })
                        @Html.ValidationMessageFor(model => model.Campus, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Department, Model.ListOfDepartment, "--select Department--", new { @class = "form-control", @id = "ddlDepartment" })
                        @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Responsibility Center", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.RespC, Model.ListOfResponsibility, "--select Responsibility Center--", new { @class = "form-control", @id = "ddlRespC" })
                        @Html.ValidationMessageFor(model => model.RespC, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    @Html.Label("Purpose:(100 characters)", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <textarea id="txtRemarks" class="form-control" maxlength="100"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        <b>Store Lines</b>
        <hr />
        <div class="pre-scrollable">
            <table class="table table-hover" id="StoreLines">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Description 2</th>
                        <th style="text-align:center">Quantity</th>
                        <th>Requesting From</th>
                        <th style="text-align:right">Action</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                <tfoot>
                    <tr class="NoRecords">
                        <td colspan="5">
                            <span style="color:red" id="NoRecords">No Lines Added</span>
                        </td>
                        <td class="text-right">
                            <input type="button" value="Add Item Line" class="btn btn-danger BtnPadding" onclick="AddStoreLines();" />
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <hr />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Submit Request" onclick="SubmitStoreRequisition();" />
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" ke aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel">New Store Line</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('#dtPicker').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-0:+2',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy',
            minDate: 0
        });
        $(window).resize(function () {
            $('#dtPicker').datepicker('hide');
            $('#dtPicker').blur();
        });
        $("#ddlDepartment,#ddlRespC").select2({
            width: '100%'
        });
    });
    var AddStoreLines = function () {
        var dateNeeded = $("#dtPicker").val();
        var Remarks = $("#txtRemarks").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Campus = $("#ddlCampus").children("option:selected").val();
        var Department = $("#ddlDepartment").children("option:selected").val();
        var RespoC = $("#ddlRespC").children("option:selected").val();

        if (dateNeeded == "") {
            Swal.fire('Warning', "Select Date needed", 'warning');
            return;
        }
        else if (Campus == "") {
            Swal.fire('Warning', "Select Campus", 'warning');
            return;
        }
        else if (Department == "") {
            Swal.fire('Warning', "Select Department", 'warning');
            return;
        }
        else if (RespoC == "") {
            Swal.fire('Warning', "Select Responsibility center", 'warning');
            return;
        }
        else if (Remarks == "") {
            Swal.fire('Warning', "Enter Purpose for the purchase", 'warning');
            return;
        }
        else if (Remarks.length > 100) {
            Swal.fire('Warning', "Your Reason should have a maximum of 150 characters", 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '@Url.Action("NewStoreLine", "Store")',
                success: function (data) {
                    $("#modalBody").html(data);
                    HideProgress();
                    $("#myModal").modal("show");
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var StoreRequisitionLink = function () {
        ShowProgress();
        window.location = '@Url.Action("StoreRequisitionList", "Store")';
    }
    var AddLineItem = function () {
        var itemvalue = $("#IdItems").val();
        var Qnty = $("#txtQuantity").val();
        var Location = $("#ddlLocation").children("option:selected").val();
        var ItemDescription = $("#txtDescription").val();

        if (itemvalue == "") {
            Swal.fire('Warning', "Enter Item", 'warning');
            return;
        }
        else if (Qnty == "") {
            Swal.fire('Warning', "Enter Quantity", 'warning');
            return;
        }
        else if (Location == "") {
            Swal.fire('Warning', "Select the Location needed", 'warning');
            return;
        }
        else if (ItemDescription == "") {
            Swal.fire('Warning', "Give brief description of the item", 'warning');
            return;
        }
        else if (ItemDescription.length > 50) {
            Swal.fire('Warning', "Your Item Description should have a maximum of 50 characters", 'warning');
            return;
        }
        else {
            if (itemvalue != "") {
                var s = itemvalue.split('~');

                Item = s[0];
                ItemDesc = s[1];
            }

            var StoreLines = {};
            StoreLines.Item = Item;
            StoreLines.ItemDesc = ItemDesc;
            StoreLines.Description2 = ItemDescription;
            StoreLines.Qnty = Qnty;
            StoreLines.Location = Location;

            ShowProgress();
            $.ajax({
                type: "POST",
                url:'@Url.Action("CheckstockLevel", "Store")',
                data: JSON.stringify({ storeLine: StoreLines }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        //Get the reference of the Table's TBODY element.
                        var tBody = $("#StoreLines > TBODY")[0];

                        //Add Row.
                        var row = tBody.insertRow(-1);

                        //Add Item.
                        var cell = $(row.insertCell(-1));
                        cell.html(Item);

                        //Add Item Desc.
                        var cell = $(row.insertCell(-1));
                        cell.html(ItemDesc);

                        //Add Item Desc2.
                        var cell = $(row.insertCell(-1));
                        cell.html(ItemDescription);

                        //Add Qnty.
                        var cell = $(row.insertCell(-1));
                        cell.attr("align", "center");
                        cell.html(Qnty);

                        //Add location.
                        var cell = $(row.insertCell(-1));
                        cell.html(Location);

                        //Add Button cell.
                        cell = $(row.insertCell(-1));
                        cell.attr("align", "right");
                        var btnRemove = $("<input />");
                        btnRemove.attr("type", "button");
                        btnRemove.addClass("btn btn-primary BtnPadding");
                        btnRemove.attr("onclick", "Remove(this);");
                        btnRemove.val("Remove");
                        cell.append(btnRemove);

                        DetermineNoOfRows();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', "store line added successfully", 'success');
                        HideProgress();
                        //Clear the TextBoxes.
                        $("#IdItems").val('')
                        $("#txtQuantity").val('');
                        $('#ddlLocation').val('').select2();
                        $("#txtDescription").val('');
                    }
                    else {
                        $("#IdItems").val('')
                        $("#txtQuantity").val('');
                        $('#ddlLocation').val('').select2();
                        $("#txtDescription").val('');
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var DetermineNoOfRows = function () {
        var totalRowCount = $("#StoreLines TBODY tr").length;
        if (totalRowCount > 0) {
            $("#NoRecords").hide();
        }
        else {
            $("#NoRecords").show();
        }
    }
    function Remove(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var Item = $("TD", row).eq(0).html();
        var ItemDesc = $("TD", row).eq(0).html();
        if (confirm("Do you want to remove: " + Item + "~" + ItemDesc)) {
            //Get the reference of the Table.
            var table = $("#StoreLines")[0];

            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        }
        DetermineNoOfRows();
    };
    var SubmitStoreRequisition = function () {
        var dateNeeded = $("#dtPicker").val();
        var Remarks = $("#txtRemarks").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Campus = $("#ddlCampus").children("option:selected").val();
        var Department = $("#ddlDepartment").children("option:selected").val();
        var RespoC = $("#ddlRespC").children("option:selected").val();

        if (dateNeeded == "") {
            Swal.fire('Warning', "Select Date needed", 'warning');
            return;
        }
        else if (Campus == "") {
            Swal.fire('Warning', "Select Campus", 'warning');
            return;
        }
        else if (Department == "") {
            Swal.fire('Warning', "Select Department", 'warning');
            return;
        }
        else if (RespoC == "") {
            Swal.fire('Warning', "Select Responsibility center", 'warning');
            return;
        }
        else if (Remarks == "") {
            Swal.fire('Warning', "Enter Reason for the purchase", 'warning');
            return;
        }
        else if (Remarks.length > 100) {
            Swal.fire('Warning', "Your Reason should have a maximum of 150 characters", 'warning');
            return;
        }
        else {
            ShowProgress();
            var StoretHeader = {};
            StoretHeader.DateNeeded = dateNeeded;
            StoretHeader.Remarks = Remarks;
            StoretHeader.Campus = Campus;
            StoretHeader.Department = Department;
            StoretHeader.RespC = RespoC;

            //Loop through the Table rows and build a JSON array.
            var StoreLines = new Array();
            $("#StoreLines TBODY TR").each(function () {
                debugger
                var row = $(this);
                var StoreLine = {};
                StoreLine.Item = row.find("TD").eq(0).html();
                StoreLine.ItemDesc = row.find("TD").eq(1).html();
                StoreLine.Description2 = row.find("TD").eq(2).html();
                StoreLine.Qnty = row.find("TD").eq(3).html();
                StoreLine.Location = row.find("TD").eq(4).html();
                StoreLines.push(StoreLine);
            });
            if (StoreLines.length < 1) {
                Swal.fire('Warning', 'You have not Added any Store Requisition line(s)', 'warning');
                HideProgress();
                return;
            }
            else {
                //Send the JSON array to Controller using AJAX.
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SubmitStoreRequisition", "Store")',
                    data: JSON.stringify({ storeHeader: StoretHeader, storeLines: StoreLines }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.success) {
                            window.location = '@Url.Action("StoreRequisitionList", "Store")';
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
        }
    };
</script>

