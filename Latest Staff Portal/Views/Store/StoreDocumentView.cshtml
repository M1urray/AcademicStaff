@model Latest_Staff_Portal.ViewModel.StoretHeader
@{
    ViewBag.Title = "StoreDocumentView";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    hr {
        margin: 4px;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div style="background-color: black;">
    <a href="#" onclick="StoreRequisitionLink();" style="color:yellow"><<< Back To Store Requisition List</a>
</div>
<div class="card">
    <div class="card-title">Store Document Details(@Model.No)</div>
    <hr />
    <div style="text-align:right" id="HideEditButton">
        <input type="button" class="btn btn-danger BtnPadding" id="btnEdit" value="Edit Header" onclick="EditDocument();" />
        <hr />
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <b>Document No</b>
                @Html.TextBoxFor(m => m.No, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
            </div>
            <div class="col-md-6">
                <b>Date Needed</b>
                @Html.TextBoxFor(m => m.DateNeeded, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd", @id = "dtPicker", @onkeydown = "return false;", @autocomplete = "off" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <b>Date Requested</b>
                @Html.TextBoxFor(m => m.DateRequested, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
            </div>
            <div class="col-md-6">
                <b>Campus</b>
                @Html.TextBoxFor(m => m.CampusName, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd", @id = "txtCampus" })
                <select class="form-control" id="ddlCampus" name="ddlCampus">
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <b>Department</b>
                @Html.TextBoxFor(m => m.DepartmentName, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd", @id = "txtDepartment" })
                <div id="divDepartment">
                    <select class="form-control" id="ddlDepartment" name="ddlDepartment">
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <b>Responsibility Center</b>
                @Html.TextBoxFor(m => m.RespC, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd", @id = "txtRespC" })
                <div id="divRespC">
                    <select class="form-control" id="ddlRespC" name="ddlRespC">
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <b>Purpose</b>
                @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", @readonly = "readonly", @rows = 5, @style = "background-color:#dedebd", @id = "txtPurpose" })
            </div>
            <div class="col-md-6">
                <b>Status</b>
                @Html.TextBoxFor(m => m.Status, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
            </div>
        </div>
        <hr />
        <div align="center" id="DivUpdateButton">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Update Header" onclick="UpdateStoreHeader();" />
        </div>
        <div id="DivStoreRegLine">
            <hr style="border:1px solid black" />
            <b>Store Lines</b>
            <hr />
            <div id="divStoreLines"></div>
            <hr />
            <div align="right" id="DivSendForApproval">
                <input type="button" class="btn btn-danger BtnPadding" value="Send For Approval >>>" onclick="SendDocForApproval();" />
            </div>
            <hr />
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" ke aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel"><label id="lblT"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadStoreDocumentLines(`@Model.No`,`@Model.Status`);
        HideHeaderEditInput();
        var status = `@Model.Status`;
        if (status == "Open") {
            $("#HideEditButton").show();
            $("#HideLineButton").show();
            $("#DivSendForApproval").show();
        }
        else {
            $("#HideEditButton").hide();
            $("#HideLineButton").hide();
            $("#DivSendForApproval").hide();
        }
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        var Errormsg = '@Request.RequestContext.HttpContext.Session["ErrorMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success',true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("NullibySessions", "Common")'
            });
        }
        if (Errormsg != "") {
            Swal.fire('Warning', Errormsg, 'warning',true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("NullibySessions", "Common")'
            });
        }
    });
    var LoadStoreDocumentLines = function (DocNo, Status) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ DocNo: DocNo, Status: Status }),
            url: '@Url.Action("StoreDocumentLines", "Store")',
            success: function (data) {
                $("#divStoreLines").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var StoreRequisitionLink = function () {
        ShowProgress();
        window.location = '@Url.Action("StoreRequisitionList", "Store")';
    }
    var EditDocument = function () {
        if ($("#btnEdit").val() == "Edit Header") {
            var Campus = `@Model.Campus`;
            var Department = `@Model.Department`;
            var RespC = `@Html.Raw(HttpUtility.HtmlDecode(Model.RespC).Replace("'", "\\'"))`;
            ShowProgress();
            $('#ddlCampus').empty().append('<option selected="selected" value="">--Select Campus--</option>');
            $('#ddlDepartment').empty().append('<option selected="selected" value="">--Select Department--</option>');
            $('#ddlRespC').empty().append('<option selected="selected" value="">--Select Responsibility Center--</option>');

            $.getJSON('@Url.Action("GetCommonDropdwnListData", "Common")', null,
                function (data) {
                    $('#ddlCampus').empty().append('<option selected="selected" value="">--Select Campus--</option>');
                    $('#ddlDepartment').empty().append('<option selected="selected" value="">--Select Department--</option>');
                    $('#ddlRespC').empty().append('<option selected="selected" value="">--Select Responsibility Center--</option>');
                    $.each(data.DropDownData.ListOfCampus, function () {
                        $("#ddlCampus").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    $('#ddlCampus').val(Campus.trim());
                    $.each(data.DropDownData.ListOfDepartments, function () {
                        $("#ddlDepartment").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    $("#ddlDepartment").val(Department.trim());
                    $.each(data.DropDownData.ListOfRespC, function () {
                        $("#ddlRespC").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    $("#ddlRespC").val(RespC.trim());
                    HideProgress();
                });

            $("#btnEdit").val("Clear Header Edit");
            $("#ddlDepartment,#ddlRespC").select2({
                width: '100%'
            });
            ShowHeaderEditInput();
        }
        else {
            HideHeaderEditInput();
            $("#btnEdit").val("Edit Header");
        }
    }
    var HideHeaderEditInput = function () {
        $("#txtCampus,#txtDepartment,#txtRespC,#DivStoreRegLine").show();
        $("#ddlCampus,#divDepartment,#divRespC,#DivUpdateButton").hide();
        $("#dtPicker,#txtPurpose").css("background-color", "#dedeb");
        $("#dtPicker,#txtPurpose").attr("readonly", true);
        $('#dtPicker').datepicker("destroy");
    }
    var ShowHeaderEditInput = function () {
        $("#txtCampus,#txtDepartment,#txtRespC,#DivStoreRegLine").hide();
        $("#ddlCampus,#divDepartment,#divRespC,#DivUpdateButton").show();
        $("#dtPicker,#txtPurpose").css("background", "white");
        $("#dtPicker,#txtPurpose").attr("readonly", false);
        $('#dtPicker').datepicker({
            enable: true,
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-0:+2',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy',
            minDate: 0
        });
        $(window).resize(function () {
            $('#dtPicker').datepicker('hide');
            $('#dtPicker').blur();
        });
    }
    var UpdateStoreHeader = function () {
        var DocNo = `@Model.No`;
        var dateNeeded = $("#dtPicker").val();
        var Remarks = $("#txtPurpose").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Campus = $("#ddlCampus").children("option:selected").val();
        var CampusName = $("#ddlCampus").children("option:selected").text();
        var Department = $("#ddlDepartment").children("option:selected").val();
        var DepartmentName = $("#ddlDepartment").children("option:selected").text();
        var RespoC = $("#ddlRespC").children("option:selected").val();
        if (dateNeeded == "") {
            Swal.fire('Warning', "Select Date needed", 'warning');
            return;
        }
        else if (Campus == "") {
            Swal.fire('Warning', "Select Campus", 'warning');
            return;
        }
        else if (Department == "") {
            Swal.fire('Warning', "Select Department", 'warning');
            return;
        }
        else if (RespoC == "") {
            Swal.fire('Warning', "Select Responsibility center", 'warning');
            return;
        }
        else if (Remarks == "") {
            Swal.fire('Warning', "Enter Reason for the purchase", 'warning');
            return;
        }
        else if (Remarks.length > 100) {
            Swal.fire('Warning', "Your Reason should have a maximum of 150 characters", 'warning');
            return;
        }
        else {
            var StoretHeader = {};
            StoretHeader.DateNeeded = dateNeeded;
            StoretHeader.Remarks = Remarks;
            StoretHeader.Campus = Campus;
            StoretHeader.Department = Department;
            StoretHeader.RespC = RespoC;

            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateStoreHeader", "Store")',
                data: JSON.stringify({ DocNo: DocNo, storeHeader: StoretHeader }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        HideHeaderEditInput();
                        $("#btnEdit").val("Edit Header");
                        $("#txtPurpose").val(Remarks);
                        $("#txtCampus").val(CampusName);
                        $("#txtDepartment").val(DepartmentName);
                        $("#txtRespC").val(RespoC);
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    function getB64Str(buffer) {
        var binary = '';
        var bytes = new Uint8Array(buffer);
        var len = bytes.byteLength;
        for (var i = 0; i < len; i++) {
            binary += String.fromCharCode(bytes[i]);
        }
        return window.btoa(binary);
    }
    var EditItem = function (DocNo, LnNo, ItemNo) {
        $("#lblT").text("Edit Store Line");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ LnNo: LnNo, DocNo: DocNo, ItemNo: ItemNo }),
            url: '@Url.Action("EditStoreLine", "Store")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var AddStoreLine = function () {
        $("#lblT").text("Add Store Line");
        var dateNeeded = `@Model.DateNeeded`;
        var Remarks = `@Model.Remarks`;
        var Campus = `@Model.Campus`;
        var Department = `@Model.Department`;
        var RespoC = `@Model.RespC`;

        if (dateNeeded == "") {
            Swal.fire('Warning', "Select Date needed", 'warning');
            return;
        }
        else if (Campus == "") {
            Swal.fire('Warning', "Select Campus", 'warning');
            return;
        }
        else if (Department == "") {
            Swal.fire('Warning', "Select Department", 'warning');
            return;
        }
        else if (RespoC == "") {
            Swal.fire('Warning', "Select Responsibility center", 'warning');
            return;
        }
        else if (Remarks == "") {
            Swal.fire('Warning', "Enter Purpose for the purchase", 'warning');
            return;
        }
        else if (Remarks.length > 100) {
            Swal.fire('Warning', "Your Reason should have a maximum of 150 characters", 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '@Url.Action("NewStoreLine", "Store")',
                success: function (data) {
                    $("#modalBody").html(data);
                    HideProgress();
                    $("#myModal").modal("show");
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var AddLineItem = function () {
        var itemvalue = $("#ddlItems").children("option:selected").val();
        var ItemDesc = $("#ddlItems").children("option:selected").text();
        var Qnty = $("#txtQuantity").val();
        var Location = $("#ddlLocation").children("option:selected").val();
        var ItemDescription = $("#txtDescription").val();

        if (itemvalue == "") {
            Swal.fire('Warning', "Select Item", 'warning');
            return;
        }
        else if (Qnty == "") {
            Swal.fire('Warning', "Enter Quantity", 'warning');
            return;
        }
        else if (Location == "") {
            Swal.fire('Warning', "Select the Location needed", 'warning');
            return;
        }
        else if (ItemDescription == "") {
            Swal.fire('Warning', "Give brief description of the item", 'warning');
            return;
        }
        else if (ItemDescription.length > 50) {
            Swal.fire('Warning', "Your Item Description should have a maximum of 50 characters", 'warning');
            return;
        }
        else {
            ShowProgress();
            var DocNo = `@Model.No`;
            var StoreLines = {};
            StoreLines.Item = itemvalue;
            StoreLines.ItemDesc = ItemDesc;
            StoreLines.Description2 = ItemDescription;
            StoreLines.Qnty = Qnty;
            StoreLines.Location = Location;
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckstockLevel", "Store")',
                data: JSON.stringify({ storeLine: StoreLines }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("SubmitStoreLine", "Store")',
                            data: JSON.stringify({ DocNo: DocNo, storeLine: StoreLines }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (data) {
                                if (data.success) {
                                    HideProgress();
                                    LoadStoreDocumentLines(DocNo, 'Open');
                                    $("#myModal").modal("hide");
                                    Swal.fire('Success', data.message, 'success');
                                }
                                else {
                                    Swal.fire('Warning', data.message, 'warning');
                                    HideProgress();
                                }
                            },
                            error: function (err) {
                                HideProgress();
                                Swal.fire('Warning', err, 'warning');
                            }
                        });
                    }
                    else {
                        $("#IdItems").val('')
                        $("#txtQuantity").val('');
                        $('#ddlLocation').val('').select2();
                        $("#txtDescription").val('');
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var RemoveItem = function (DocNo, LnNo,ItemNo) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("RemoveStoreLine", "Store")',
                    data: JSON.stringify({ DocNo: DocNo, LnNo: LnNo, ItemNo: ItemNo }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.success) {
                            HideProgress();
                            LoadStoreDocumentLines(DocNo, 'Open');
                            $("#myModal").modal("hide");
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Store line has not been deleted', 'error');
            }
        });
    };
    var UpdateLineItem = function (DocNo, LnNo,ItemNo) {
        var Amount = $("#txtAmount").val();
        var Qnty = $("#txtQuantity").val();
        var Location = $("#ddlLocation").children("option:selected").val();
        var ItemDescription = $("#txtDescription").val().replace(/(\r\n|\n|\r)/gm, " ");

        if (Amount == "") {
            Swal.fire('Warning', "Enter Amount", 'warning');
            return;
        }
        else if (Qnty == "") {
            Swal.fire('Warning', "Enter Quantity", 'warning');
            return;
        }
        else if (Location == "") {
            Swal.fire('Warning', "Select the Location needed", 'warning');
            return;
        }
        else if (ItemDescription == "") {
            Swal.fire('Warning', "Give brief description of the item", 'warning');
            return;
        }
        else if (ItemDescription.length > 50) {
            Swal.fire('Warning', "Item description should not exceed 50 characters", 'warning');
            return;
        }
        else {
            ShowProgress();
            var StoreLine = {};
            StoreLine.DocNo = DocNo;
            StoreLine.Item = ItemNo;
            StoreLine.Description2 = ItemDescription;
            StoreLine.Qnty = Qnty;
            StoreLine.Location = Location;
            StoreLine.LnNo = LnNo;

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateStoreLine", "Store")',
                data: JSON.stringify({ storeLine: StoreLine }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        LoadStoreDocumentLines(DocNo, 'Open');
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var SendDocForApproval = function () {
        var rowCount = $('#StoreLines tr').length;
        if (rowCount < 1) {
            Swal.fire('Warning', 'You have not Added any Store Requisition line(s)', 'warning');
            return;
        }
        else {
            var DocNo = `@Model.No`;
            ShowProgress();
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                data: JSON.stringify({ DocNo: DocNo,Redirect: "Y"  }),
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '@Url.Action("SendStoreAppForApproval", "Store")',
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        HideHeaderEditInput();
                        LoadStoreDocumentLines('@Model.No', 'Pending Approval');
                        $("#txtStatus").val("Pending Approval");
                        $("#HideEditButton").hide();
                        $("#HideLineButton").hide();
                        $("#DivSendForApproval").hide();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
</script>

