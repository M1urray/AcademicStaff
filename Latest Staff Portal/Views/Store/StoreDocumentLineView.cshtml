@model Latest_Staff_Portal.ViewModel.StoreLinesList
<div class="table-responsive">
    <table class="table table-centered table-nowrap" id="StoreLines">
        <thead>
            <tr>
                <th>Item</th>
                <th>Description</th>
                <th>Issuing Store</th>
                <th class="text-center">Quantity</th>
                <th style="text-align:center" class="tdAction">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfStoreLines != null && Model.ListOfStoreLines.Count() > 0)
                {
                    foreach (var item in Model.ListOfStoreLines)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Item)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ItemDesc)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Location)
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.Qnty)
                            </td>
                            <td style="text-align:center" class="tdAction">
                                <a href="javascript:void(0);" class="mr-3 text-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EditItem('@item.DocNo','@item.LnNo','@item.Item');"><i class="mdi mdi-pencil font-size-16"></i></a>
                                <a href="javascript:void(0);" class="text-danger" data-toggle="tooltip" data-placement="top" title="" data-original-title="Delete" onclick="RemoveItem('@item.DocNo','@item.LnNo','@item.Item');"><i class="mdi mdi-close font-size-16"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr class="HideLineButton">
                <td class="text-right" colspan="5">
                    <input type="button" value="Add Item Line" class="btn btn-danger BtnPadding" onclick="AddStoreLine();" />
                </td>
            </tr>
        </tfoot>
    </table>
</div>
