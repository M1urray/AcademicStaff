@model IEnumerable<Latest_Staff_Portal.ViewModel.StoreReqList>
<div class="pre-scrollable">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead style="background-color:black;color:white">
            <tr>
                <th>Action</th>
                <th>No</th>
                <th>Request Date</th>
                <th>Required Date</th>
                <th>Description</th>
                <th>Function Name</th>
                <th>Budget Center Name</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <input type="button" onclick="SelectedRow('@item.No','@item.Status');" class="btn btn-sm btn-danger" value="Select" />
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.No)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ReqDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DateRequired)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Function)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BudgetCeter)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
