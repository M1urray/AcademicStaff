
@{
    ViewBag.Title = "ImprestSurrenderRequisitionList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-title">Imprest Surrender List</div>
    <hr />
    <div class="card-body">
        <a href="#" onclick="NewImprestSurrenderRequisition();" class="btn btn-primary BtnPadding">New Surrender</a>
        <a href="#" onclick="ViewDoc();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <a href="#" onclick="SendDocForApproval();" class="btn btn-primary BtnPadding disabled" id="SendDocAppr">Send Approval Request</a>
        <a href="#" onclick="CancelDocForApproval();" class="btn btn-primary BtnPadding disabled" id="CancelDocAppr">Cancel Approval Request</a>
        <a href="#" onclick="ViewApprovalTrail();" class="btn btn-danger BtnPadding disabled" id="AppTrail">Document Approval Trail</a>
        <a href="#" onclick="ViewDocComments();" class="btn btn-primary BtnPadding disabled" id="AppComments">Document Comments</a>
        <hr />
        <div id="divRegList"></div>
    </div>
</div>
@*//////////////////////My Imprest Doc List////////////////////////////*@
<div class="modal fade" id="myImprestModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">My Imprest Documents</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalImpBody">
                <div class="row">
                    <div class="col-md-12">
                        <span style="font-weight: bold">Imprest Document List</span>
                        <select class="form-control" id="ddlImpDocs" name="ddlImpDocs">
                        </select>
                    </div>
                </div>
                <hr />
                <div align="center">
                    <input type="button" class="btn btn-primary waves-effect waves-light" value="Surrender Imprest" onclick="SurrenderImprestDoc();" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadImprestSurrenderList();
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        var Errormsg = '@Request.RequestContext.HttpContext.Session["ErrorMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success',true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
        if (Errormsg != "") {
            Swal.fire('Warning', Errormsg, 'warning',true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
    });
    var LoadImprestSurrenderList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/ImprestSurrender/ImprestSurrenderListPartialView",
            success: function (data) {
                $("#divRegList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewImprestSurrenderRequisition = function () {
        $("#myImprestModal").modal("show");
        ShowProgress();
        $.getJSON("/ImprestSurrender/NewImprestSurrender", null,
            function (data) {
                $('#ddlImpDocs').empty().append('<option selected="selected" value="">--Select Imprest Document--</option>');
                $.each(data.ImpSurrender.ListOfImprests, function () {
                    $("#ddlImpDocs").append($("<option></option>").val(this['Value']).html(this['Text']));
                });
                $("#myImprestModal").modal("show");
                HideProgress();
            });
    }
    var SurrenderImprestDoc = function () {
        var DocNo = $("#ddlImpDocs").val();
        if (DocNo == "") {
            Swal.fire('Warning', 'Select imprest document to surrender', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: "/ImprestSurrender/SubmitImprestSurrender",
                //data: data,
                data: JSON.stringify({ DocNo: DocNo }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        window.location = "/ImprestSurrender/ViewSurrenderDocument?DocNo=" + data.DocNo;
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            var row = $('#datatable-buttons tr.selectedTableRow');
            var Status = row.find("td").eq(7).html().trim();
            $("#ViewDoc").removeClass("disabled");
            $("#AppComments").removeClass("disabled");
            if (Status == "Pending") {
                $("#SendDocAppr").removeClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else if (Status == "Pending Approval") {
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").removeClass("disabled");
                $("#AppTrail").removeClass("disabled");
            }
            else if (Status == "Approved") {
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else {
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
        });
    }
    var ViewDoc = function () {
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        window.location = "/ImprestSurrender/ViewSurrenderDocument?DocNo=" + DocNo;
    }
    var SendDocForApproval = function () {
        $("#labelF").text("Imprest Surrender Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/ImprestSurrender/SendImprestSurrenderForApproval',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadImprestReqList();
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var CancelDocForApproval = function () {
        $("#labelF").text("Imprest Surrender Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/ImprestSurrender/CancelImprestSurrenderForApproval',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadImprestReqList();
                    DiableButtons();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });

    }
    var ViewApprovalTrail = function () {
        $("#labelF").text("Document Approval Trail");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Common/DocumentApprovalTrail',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DiableButtons = function () {
        $("#ViewDoc").addClass("disabled");
        $("#SendDocAppr").addClass("disabled");
        $("#CancelDocAppr").addClass("disabled");
        $("#AppTrail").addClass("disabled");
        $('table tbody tr').siblings().removeClass("selectedTableRow");
    }
    var DisplayAlert = function (msg) {
        Swal.fire(msg);
    }
    var ViewDocComments = function () {
        $("#labelF").text("Document Comments");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Common/DocumentApprovalComments',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

