@model Latest_Staff_Portal.ViewModel.ImprestSurrenderLinesList
<div class="table-responsive">
    <table class="table table-centered table-nowrap" id="ImpLines">
        <thead>
            <tr>
                <th>Account No</th>
                <th>Account Name</th>
                <th style="text-align:center">Amount</th>
                <th class="tdAction">Actual Spend</th>
                <th>Receipt No</th>
                <th class="tdAction">Receipt Amount</th>
                <th class="tdAction">Total Amount</th>
                @if (Model.Status == "Pending")
                {
                    <th>Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfImprestSurrenderLines != null && Model.ListOfImprestSurrenderLines.Count() > 0)
                {
                    foreach (var item in Model.ListOfImprestSurrenderLines)
                    {
                        string Total = (Convert.ToDecimal(item.ActaulSpend) + Convert.ToDecimal(item.ReceiptAmount)).ToString("#,##0.00");
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountName)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.Amount)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.ActaulSpend)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ReceiptNo)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.ReceiptAmount)
                            </td>
                            <td style="text-align:center">
                                @Total
                            </td>
                            @if (Model.Status == "Pending")
                            {
                                <td style="text-align:right" class="tdAction">
                                    <a href="javascript:void(0);" class="mr-3" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EditItem('@item.SurrenderDocNo', '@item.AccountNo', '@item.Amount', '@item.LnNo');"><i class="mdi mdi-pencil font-size-16"></i></a>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

