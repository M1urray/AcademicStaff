@model IEnumerable<Latest_Staff_Portal.ViewModel.ScoreCardObjectives>
<style>
    .BtnPadding {
        padding: 4px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableScoreCard" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>Doc No</th>
                <th>Objective</th>
                <th>Key Performance Indicator</th>
                <th>Targets</th>
                @*<th>Weight</th>*@
                <th>Achievents</th>
                <th>Self Ratings</th>
                <th>Supervisor Ratings</th>
                <th>Review</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    {
                        if (Model.Count() > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.DocumentNo)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Objective)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.KeyPerformanceIndicator)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Targets)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Achievements)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ratings)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.SupervisorRating)
                                    </td>
                                    <td>
                                        <a href="javascript:void(0);" class="mr-3 text-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EditRecord();"><i class="mdi mdi-pencil font-size-18"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>

