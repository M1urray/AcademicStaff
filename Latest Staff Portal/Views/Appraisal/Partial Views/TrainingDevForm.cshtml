<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-6">
            <span style="font-weight: bold">Name of Course</span>
            <input type="text" id="CourseName" class="form-control" />
        </div>
        <div class="col-md-6">
            <span style="font-weight: bold">Duration of Course</span>
            <div class="row">
                <div class="col-md-4">
                    <input type="text" id="txtDuration" class="form-control" onkeypress="return functionx(event)" />
                </div>
                <div class="col-md-8">
                    <select class="form-control" id="ddlDuration">
                        <option value="">----</option>
                        <option value="D">Day(s)</option>
                        <option value="W">Week(s)</option>
                        <option value="M">Month(s)</option>
                        <option value="Y">Year(s)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <span style="font-weight: bold">Expected Start Date</span>
            <input type="text" id="txtStartDate" class="form-control" placeholder="dd/mm/yyyy" onkeydown="return false;" autocomplete="off" />
        </div>
        <div class="col-md-6">
            <span style="font-weight: bold">Reaction on the Training Attended</span>
            <textarea class="form-control" id="txtReaction"></textarea>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <span style="font-weight: bold">
                Learning Obtained from the Training
            </span>
            <textarea class="form-control" id="txtLearningObtained"></textarea>
        </div>
        <div class="col-md-6">
            <span style="font-weight: bold">
                Behavior Changes Adopted
            </span>
            <textarea class="form-control" id="txtBeahavoiurChange"></textarea>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <span style="font-weight: bold">
                Results Obtained
            </span>
            <textarea class="form-control" id="txtResults"></textarea>
        </div>
        <div class="col-md-6">
            <span style="font-weight: bold">Comments</span>
            <textarea class="form-control" id="txtComments"></textarea>
        </div>
    </div>
    <hr />
    <div align="center">
        <input type="button" class="btn btn-primary" value="Save Record" onclick="SaveTrainingDevRecord();" />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#txtStartDate').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-0:+2',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy',
            minDate: 0
        });
        $(window).resize(function () {
            $('#txtStartDate').datepicker('hide');
            $('#txtStartDate').blur();
        });
    });
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>



