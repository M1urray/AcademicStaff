@model Latest_Staff_Portal.ViewModel.SectionDetails
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableSkillDev" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th width="5%">#</th>
                <th>Area of Improvement</th>
                <th width="15%">Weight</th>
                <th style="text-align:right" width="10%">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    {
                        if (Model.ObjList.Count() > 0)
                        {
                            int i = 1;
                            foreach (var item in Model.ObjList)
                            {
                                <tr class="HasData">
                                    <td>
                                        @i
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Objective)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.weight)
                                    </td>
                                    <td style="text-align:right">
                                        <a href="javascript:void(0);" class="text-danger" onclick="RemoveAreaImprovItem('@item.LineNo','@item.DocumentNo');">Remove</a>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="NoData">
                                <td colspan="4" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
        @if (Model.Level == "A")
        {
            <tfoot>
                <tr style="border-top:1px solid black">
                    <td colspan="4" class="text-right">
                        <hr style="border-color:black" />
                        <input type="button" value="Add Area of Improvement" class="btn btn-danger BtnPadding" onclick="AddAreaOfImprovement();" />
                    </td>
                </tr>
            </tfoot>
        }
    </table>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <b>Appraisee Comments</b>
        @Html.TextAreaFor(m => m.AppraiseeComment, new { @class = "form-control", @id = "SkillsDevAppraiseeComments" })
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <b>Supervisor Comments</b>
        @Html.TextAreaFor(m => m.SuporvisorComment, new { @class = "form-control", @id = "SkillsDevAppraisorComments" })
    </div>
</div>
<hr />
<div align="center">
    <input type="button" value="Save Comments" class="btn btn-primary" onclick="SaveComments('4','@Model.Level');" />
</div>
<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.Level' == "A") {
            $("#SkillsDevAppraisorComments").attr("readonly", true);
            $("#SkillsDevAppraisorComments").css("background-color", "#dedebd");
        }
        else if ('@Model.Level' == "S") {
            $("#SkillsDevAppraiseeComments").attr("readonly", true);
            $("#SkillsDevAppraiseeComments").css("background-color", "#dedebd");
        }
        else {
            $("#SkillsDevAppraiseeComments,#SkillsDevAppraisorComments").attr("readonly", true);
            $("#SkillsDevAppraiseeComments,#SkillsDevAppraisorComments").css("background-color", "#dedebd");
        }
    })
</script>
