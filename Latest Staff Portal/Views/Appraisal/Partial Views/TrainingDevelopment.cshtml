@model IEnumerable<Latest_Staff_Portal.ViewModel.TrainingDev>
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableScoreCard" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>Name of the Course</th>
                <th>Duration of Course</th>
                <th>Expected Start Date</th>
                <th>Expected End Date</th>
                <th>
                    Reaction of Training Attended
                </th>
                <th>
                    Behavior Changes Adopted
                </th>
                <th>
                    Results Obtained
                </th>
                <th>
                    Remarks Appraisee
                </th>
                <th>
                    Remarks Supervisor
                </th>
                <th style="text-align:right" width="5%">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    {
                        if (Model.Count() > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name_of_the_Course)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Duration_of_Course)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Expected_Start_Date)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Expected_End_Date)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Reaction)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Behavior_Changes_Adopted)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Results_Obtained)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Remarks_Appraisee)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Remarks_Supervisor)
                                    </td>
                                    <td style="text-align:right">
                                        <a href="javascript:void(0);" class="text-danger" onclick="DropTrainingDevRecord('@item.Appraisal_No','@item.Line_No');">Remove</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>
<div align="right">
    <input type="button" value="Add Training and Development" class="btn btn-danger BtnPadding" onclick="AddTrainingDev();" />
</div>



