
@{
    ViewBag.Title = "ScoreCardNonTeachingStaff";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card">
    <div class="card-title">Appraisal Document(Document No : @Request.QueryString["AppDoc"])</div>
    <div class="card-body">
        <div id="accordion" role="tablist" aria-multiselectable="true">
            <div class="card mb-1 shadow-none">
                <div class="card-header" id="headingOne" aria-controls="collapseOne" aria-expanded="true" data-toggle="collapse" href="#collapseOne">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-up"></span>General Information
                    </h6>
                </div>
                <div id="collapseOne" class="panel-collapse collapse show" aria-labelledby="headingOne" data-parent="#accordion">
                    <div class="card-body">
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Apprisal Code</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning" id="DocNo">@Model.ApprisalCode</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">User ID</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.UserID</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Staff Number</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.StaffNo</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Staff Name</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.StaffName</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Supervisor</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.SupervisorName</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Apprisal Type</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.AppraisalType</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Apprisal Period</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning" id="AppPeriod">@Model.ApprisalPeriod</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Department</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.Department</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none">
                <div class="card-header" id="headingTwo" aria-expanded="false" aria-controls="collapseTwo" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span> Appraisal Objective Settings
                    </h6>
                </div>
                <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo"
                     data-parent="#accordion">
                    <div class="card-body">
                        <div id="divScoreCard"></div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none">
                <div class="card-header" id="headingThree" aria-expanded="false" aria-controls="collapseThree" data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span> Appraisal Objective Evaluation
                    </h6>
                </div>
                <div id="collapseThree" class="collapse" aria-labelledby="headingThree"
                     data-parent="#accordion">
                    <div class="card-body">
                        <div id="divScoreCardEval"></div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none">
                <div class="card-header" id="headingNine" aria-expanded="false" aria-controls="collapseNine" data-toggle="collapse" href="#collapseNine">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span>General Comments
                    </h6>
                </div>
                <div id="collapseNine" class="collapse" aria-labelledby="headingNine" data-parent="#accordion">
                    <div class="card-body">
                        <div id="divGeneralComm"></div>
                    </div>
                </div>
            </div>
            <hr />
            <div align="right">
                <input type="button" value="Send To Supervisor >>>" class="btn btn-primary" onclick="SendDocForApproval();" />
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('.shadow-none').on('shown.bs.collapse', function () {
            $(this).find('.fa-arrow-down').removeClass('fa-arrow-down').addClass('fa-arrow-up');
        }).on('hidden.bs.collapse', function () {
            $(this).find('.fa-arrow-up').removeClass('fa-arrow-up').addClass('fa-arrow-down');
        });

        var DocNo = $("#DocNo").html();
        LoadScoreCardObjective(DocNo);
        LoadScoreCardObjectiveEvaluation(DocNo);
        LoadGeneralComments(DocNo);
    });

    ///////////////Load Data////////////////
    var LoadScoreCardObjective = function (DocNo) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Type: "S" }),
            url: "/Appraisal/LoadScoreCardObjectives",
            success: function (data) {
                $("#divScoreCard").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var LoadScoreCardObjectiveEvaluation = function (DocNo) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Type: "E" }),
            url: "/Appraisal/LoadScoreCardObjectives",
            success: function (data) {
                $("#divScoreCardEval").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var LoadGeneralComments = function (DocNo) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo }),
            url: "/Appraisal/LoadGeneralComments",
            success: function (data) {
                $("#divGeneralComm").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    ///////////////End of Load////////////////////
    ///////////////Objective////////////////////
    var NewObjectiveLine = function () {
        $("#labelF").text("New Objective Line");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Appraisal/NewObjectiveLine',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SaveObjectiveRecord = function () {
        var DocNo = $("#DocNo").html();
        var AppPeriod = $("#AppPeriod").html();
        var Obj = $('#txtObj').val();
        var KeyP = $('#txtPerIndicator').val();
        var Target = $('#txtTarget').val();
        if (DocNo == "") {
            Swal.fire('error', 'Appraisal Doc No cannot be empty', 'error');
            return;
        }
        else if (AppPeriod == "") {
            Swal.fire('error', 'Appraisal period cannot be empty', 'error');
            return;
        }
        else if (Obj == "") {
            Swal.fire('error', 'Enter Objective', 'error');
            return;
        }
        else if (KeyP == "") {
            Swal.fire('error', 'Enter Key Performance Indicator', 'error');
            return;
        }
        else if (Target == "") {
            Swal.fire('error', 'Enter Target', 'error');
            return;
        }
        else {
            var ApprisalObjective = {};
            ApprisalObjective.DocNo = DocNo;
            ApprisalObjective.Objective = Obj;
            ApprisalObjective.KeyPerformance = KeyP;
            ApprisalObjective.AppraisalPeriod = AppPeriod;
            ApprisalObjective.Target = Target;

            ShowProgress();
            $.ajax({
                type: "post",
                url: "/Appraisal/SubmitAppraisalObjectiveLine",
                data: JSON.stringify({ AppObjective: ApprisalObjective }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        Swal.fire('Success', data.message, 'success');
                        HideProgress();
                        LoadScoreCardObjective(DocNo);
                        LoadScoreCardObjectiveEvaluation(DocNo);
                        $("#myModal").modal("hide");
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var RemoveObjectiveItem = function (LineNo, DocNo) {
        ShowProgress();
        $.ajax({
            type: "post",
            url: "/Appraisal/DeleteAppraisalObjectiveLine",
            data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    Swal.fire('Success', data.message, 'success');
                    HideProgress();
                    LoadScoreCardObjective(DocNo);
                    LoadScoreCardObjectiveEvaluation(DocNo);
                    $("#myModal").modal("hide");
                }
                else {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('error', data.message, 'error');
            }
        });
    }
    var EvalObjectiveItem = function (LineNo, DocNo) {
        $("#labelF").text("Evaluate Objective Line");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            url: "/Appraisal/EvaluateAppraisalObjectiveLine",
            data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SaveEvaluationLine = function (LineNo, DocNo) {
        var EvalValueachvmnt = $("#txtAchvmnt").val();
        var ratings = $("#txtSupRating").val();
        if (EvalValueachvmnt == "") {
            Swal.fire('error', 'Enter achievement for the objective', 'error');
            return;
        }
        else if (ratings == "") {
            Swal.fire('error', 'Enter self ratings', 'error');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/Appraisal/SaveAppraisalObjectiveLineAchievement",
                data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo, achvmnt: EvalValueachvmnt, ratings: ratings }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        Swal.fire('Success', data.message, 'success');
                        HideProgress();
                        LoadScoreCardObjectiveEvaluation(DocNo);
                        $("#myModal").modal("hide");
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    ///////////////End Objective////////////////////
    ///////////////Save Comments////////////////////
    var SaveComments = function (section) {
        var DocNo = $("#DocNo").html();
        if (DocNo == "") {
            Swal.fire('error', 'Appraisal Doc No cannot be empty', 'error');
            return;
        }
        else {
            if (section == "1") {
                var rows = $("#tableObj > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your objectives", 'error');
                }
                else {
                    var comments = $("#ObjAppraiseeComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee Objective Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "2") {
                var rows = $("#tableObjReview > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your objectives", 'error');
                }
                else {
                    var comments = $("#ObjReviewComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee Objective review Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "3") {
                var rows = $("#tableSkillComp > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your Skills and Competences", 'error');
                }
                else {
                    var comments = $("#SkillCompAppraiseeComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee skills and competence Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "4") {
                var rows = $("#tableSkillDev > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your skills and development", 'error');
                }
                else {
                    var comments = $("#SkillsDevAppraiseeComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee Skills and Development Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "5") {
                var comments = $("#GeneralAppraiseeComments").val();
                if (comments == "") {
                    Swal.fire('error', 'Enter appraisee general Comment', 'error');
                    return;
                }
                else {
                    SubmitSectionComments(DocNo, section, comments);
                }
            }
            else {
                Swal.fire('error', "Failed to save comments", 'error');
                return;
            }
        }
    }
    var SubmitSectionComments = function (DocNo, section, comment) {
        ShowProgress();
        $.ajax({
            type: "post",
            url: "/Appraisal/SaveAppriseeComments",
            data: JSON.stringify({ DocNo: DocNo, Comment: comment, sectioon: section }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    Swal.fire('Success', data.message, 'success');
                    HideProgress();
                    if (section == "1") {
                        LoadScoreCardObjective(DocNo);
                    }
                    if (section == "2") {
                        LoadScoreCardObjectiveEvaluation(DocNo);
                    }
                    if (section == "3") {
                        LoadCoreSkillsCompValues(DocNo);
                    }
                    if (section == "4") {
                        LoadPImprSkillsDevPlan(DocNo);
                    }
                    if (section == "5") {
                        LoadGeneralComments(DocNo);
                    }
                    $("#myModal").modal("hide");
                }
                else {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('error', data.message, 'error');
            }
        });
    }
    ///////////////End////////////////////
    var SendDocForApproval = function () {
        var DocNo = $("#DocNo").html();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Appraisal/SendAppraisalForApproval',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadSectionData();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

