@model Latest_Staff_Portal.ViewModel.SectionDetails
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableObj" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th width="5%">#</th>
                <th>Objective</th>
                <th>KPI</th>
                <th>Targets</th>
                @if (Model.Level == "A")
                {
                    <th style="text-align:right" width="10%">Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    {
                        if (Model.ObjList.Count() > 0)
                        {
                            int i = 1;
                            foreach (var item in Model.ObjList)
                            {
                                <tr class="HasData">
                                    <td>
                                        @i
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.Objective)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.KeyPerformanceIndicator)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Targets)
                                    </td>
                                    @if (Model.Level == "A")
                                    {
                                        <td style="text-align:right">
                                            <a href="javascript:void(0);" class="text-danger" onclick="RemoveObjectiveItem('@item.LineNo','@item.DocumentNo');">Remove</a>
                                        </td>
                                    }
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="NoData">
                                <td colspan="5" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
        @if (Model.Level == "A")
        {
            <tfoot>
                <tr>
                    <td colspan="5" class="text-right">
                        <hr style="border-color:black" />
                        <input type="button" value="Add Objective" class="btn btn-danger BtnPadding" onclick="NewObjectiveLine();" />
                    </td>
                </tr>
            </tfoot>
        }
    </table>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <b>Appraisee Comments</b>
        @Html.TextAreaFor(m => m.AppraiseeComment, new { @class = "form-control", @id = "ObjAppraiseeComments" })
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <b>Supervisor Comments</b>
        @Html.TextAreaFor(m => m.SuporvisorComment, new { @class = "form-control", @id = "ObjAppraisorComments" })
    </div>
</div>
<hr />
<div align="center">
    <input type="button" value="Save Comments" class="btn btn-primary" onclick="SaveComments('1','@Model.Level');" />
</div>
<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.Level' == "A") {
            $("#ObjAppraisorComments").attr("readonly", true);
            $("#ObjAppraisorComments").css("background-color", "#dedebd");
        }
        else if ('@Model.Level' == "S") {
            $("#ObjAppraiseeComments").attr("readonly", true);
            $("#ObjAppraiseeComments").css("background-color", "#dedebd");
        }
        else {
            $("#ObjAppraiseeComments,#ObjAppraisorComments").attr("readonly", true);
            $("#ObjAppraiseeComments,#ObjAppraisorComments").css("background-color", "#dedebd");
        }
    });
</script>

