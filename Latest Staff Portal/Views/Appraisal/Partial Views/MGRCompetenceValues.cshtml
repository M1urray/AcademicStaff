@model IEnumerable<Latest_Staff_Portal.ViewModel.CompetenceValues>
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableScoreCard" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th>Assessment</th>
                <th>Score</th>
                <th>Score Descriptor</th>
                <th width="5%" style="text-align:right">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    {
                        if (Model.Count() > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Code)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Description)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Appraisal_Assesment)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Score)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Score_Descriptors)
                                    </td>
                                    <td style="text-align:right">
                                        <a href="javascript:void(0);" class="text-danger" onclick="EvalCompValueItem('@item.Appraisal_No','@item.Line_No','2');">Evaluate</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>





