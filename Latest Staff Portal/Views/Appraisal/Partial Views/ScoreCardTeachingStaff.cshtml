    var SendDocForApproval = function () {
        var DocNo = $("#DocNo").html();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, SendTo: "1" }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Appraisal/SendDocumentTo',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
