@model IEnumerable<Latest_Staff_Portal.ViewModel.EvaluationLines>
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableScoreCard" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>Activity</th>
                <th>Resources Required</th>
                <th>Expected Results</th>
                <th>Performance Indicator</th>
                <th>Time Frame</th>
                <th>Appraisee Score</th>
                <th>Supervisor Score</th>
                <th>Agreed Score</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    {
                        if (Model.Count() > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Activity)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Resources_Required)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Expected_Results)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Performance_Indicator)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Time_Frame)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Appraisee_Score)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Supervisor_Score)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Agreed_Score)
                                    </td>
                                    <td style="text-align:right" class="tdAction">
                                        <a href="javascript:void(0);" class="mr-3 text-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EvaluateEvaluationLine('@item.Entry_No');"><i class="mdi mdi-pencil font-size-16"></i></a>
                                       @* <a href="javascript:void(0);" class="text-danger" data-toggle="tooltip" data-placement="top" title="" data-original-title="Delete" onclick="RemoveTargetActivityItem('@item.Entry_No');"><i class="mdi mdi-close font-size-16"></i></a>*@
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>


