@model Latest_Staff_Portal.ViewModel.SectionDetails
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableScoreCard" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>Agreed Performance Indicator</th>
                <th>Key Performance Indicator</th>
                <th>Results Achieved</th>
                @*<th>Self-Assessment (Results Achieved)</th>*@
                @*<th>
                        Self-Score
                    </th>
                    <th>
                        Supervisor's Assessment (Results Achieved)
                    </th>
                    <th>
                        Supervisors Score
                    </th>
                    <th>Agreed Assessment (Results Achieved)</th>*@
                <th>
                    Performance Score
                </th>

                @*<th>
                        Appraisee Comments
                    </th>
                    <th>
                        Supervisor Comments
                    </th>*@
                @if (Model.Level == "S")
                {
                    <th width="5%" style="text-align:right">Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.KPIList != null)
                {
                    {
                        if (Model.KPIList.Count() > 0)
                        {
                            foreach (var item in Model.KPIList)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Agreed_Performance_Targets)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Key_Performance_Indicator)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Key_Result_Areas_Output)
                                    </td>
                                    @*<td>
                                            @Html.DisplayFor(modelItem => item.Self_Assesment)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Self_Score)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Supervisor_Assesment)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Supervisors_Score)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Agreed_Assesment_Results)
                                        </td>*@
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Agreed_Score)
                                    </td>
                                    @*<td>
                                            @Html.DisplayFor(modelItem => item.Appraisee_Comments)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Supervisor_Comments)
                                        </td>*@
                                    @if (Model.Level == "S")
                                    {
                                        <td style="text-align:right">
                                            <a href="javascript:void(0);" class="text-danger" onclick="EvalKPIItem('@item.Appraisal_No','@item.Line_No','@Model.Level');">Evaluate</a>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>



