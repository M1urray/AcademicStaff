    var SaveComments = function (section) {
        var DocNo = $("#DocNo").html();
        if (DocNo == "") {
            Swal.fire('error', 'Appraisal Doc No cannot be empty', 'error');
            return;
        }
        else {
            if (section == "1") {
                var rows = $("#tableObj > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your objectives", 'error');
                }
                else {
                    var comments = $("#ObjAppraiseeComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee Objective Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "2") {
                var rows = $("#tableObjReview > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your objectives", 'error');
                }
                else {
                    var comments = $("#ObjReviewComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee Objective review Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "3") {
                var rows = $("#tableSkillComp > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your Skills and Competences", 'error');
                }
                else {
                    var comments = $("#SkillCompAppraiseeComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee skills and competence Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "4") {
                var rows = $("#tableSkillDev > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your skills and development", 'error');
                }
                else {
                    var comments = $("#SkillsDevAppraiseeComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter appraisee Skills and Development Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments);
                    }
                }
            }
            else if (section == "5") {
                var comments = $("#GeneralAppraiseeComments").val();
                if (comments == "") {
                    Swal.fire('error', 'Enter appraisee general Comment', 'error');
                    return;
                }
                else {
                    SubmitSectionComments(DocNo, section, comments);
                }
            }
            else {
                Swal.fire('error', "Failed to save comments", 'error');
                return;
            }
        }
    }
    var SubmitSectionComments = function (DocNo, section, comment) {
        ShowProgress();
        $.ajax({
            type: "post",
            url: "/Appraisal/SaveAppriseeComments",
            data: JSON.stringify({ DocNo: DocNo, Comment: comment, sectioon: section }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    Swal.fire('Success', data.message, 'success');
                    HideProgress();
                    if (section == "1") {
                        LoadScoreCardObjective(DocNo);
                    }
                    if (section == "2") {
                        LoadScoreCardObjectiveEvaluation(DocNo);
                    }
                    if (section == "3") {
                        LoadCoreSkillsCompValues(DocNo);
                    }
                    if (section == "4") {
                        LoadPImprSkillsDevPlan(DocNo);
                    }
                    if (section == "5") {
                        LoadGeneralComments(DocNo);
                    }
                    $("#myModal").modal("hide");
                }
                else {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('error', data.message, 'error');
            }
        });
    }
