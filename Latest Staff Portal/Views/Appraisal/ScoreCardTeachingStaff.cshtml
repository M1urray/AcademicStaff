    var SaveSkillDevelopmentLine = function () {
        var DocNo = $("#DocNo").html();
        var AppPeriod = $("#AppPeriod").html();
        var SkillDev = $('#txtAreaOfImprovement').val();
        var weight = $("#ddlweight").children("option:selected").val();

        if (DocNo == "") {
            Swal.fire('error', 'Appraisal Doc No cannot be empty', 'error');
            return;
        }
        else if (AppPeriod == "") {
            Swal.fire('error', 'Appraisal period cannot be empty', 'error');
            return;
        }
        else if (SkillDev == "") {
            Swal.fire('error', 'Enter Area of Improvement', 'error');
            return;
        }
        else if (weight == "") {
            Swal.fire('error', 'Select weight', 'error');
            return;
        }

        else {
            var ApprisalObjective = {};
            ApprisalObjective.DocNo = DocNo;
            ApprisalObjective.Objective = SkillDev;
            ApprisalObjective.AppraisalPeriod = AppPeriod;
            ApprisalObjective.weight = weight;
            ShowProgress();
            $.ajax({
                type: "post",
                url: '@Url.Action("SubmitSkillDevelopmentValue", "Appraisal")',
                data: JSON.stringify({ AppObjective: ApprisalObjective }),
                contentType: "application/json; charset = utf-8",
