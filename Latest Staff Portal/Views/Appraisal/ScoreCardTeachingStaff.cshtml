    }
    var SaveCoreCompetenceValueLine = function () {
        var DocNo = $("#DocNo").html();
        var AppPeriod = $("#AppPeriod").html();
        var myTableArray = [];
        $('#tableAddSkillComp tbody tr').each(function () {
            var arrayOfThisRow = [];
            var tableData = $(this).find('td');
            if (tableData.length > 0) {
                tableData.each(function () {
                    if ($(this).find("input[type=text]").length) {
                        var myText = $(this).find("input[type=text]").val();

                        arrayOfThisRow.push(myText);
                    }
                    else arrayOfThisRow.push($(this).text());
                });

                myTableArray.push(arrayOfThisRow);
            }
        });
        if (DocNo == "") {
            Swal.fire('error', 'Appraisal Doc No cannot be empty', 'error');
            return;
        }
        else if (AppPeriod == "") {
            Swal.fire('error', 'Appraisal period cannot be empty', 'error');
            return;
        }
        else if (myTableArray.length < 1) {
            Swal.fire('Warning', 'You have not Added any installment line(s)', 'warning');
            return;
        }
        else {
            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: '@Url.Action("SubmitCoreCompetenceValue", "Appraisal")',
                data: { DocNo: DocNo, AppPeriod: AppPeriod, skillComp: myTableArray },
                contenttype: "text/plain; charset=utf-8",
                success: function (data) {
