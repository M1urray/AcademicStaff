
@{
    ViewBag.Title = "MyReviewAppraisalList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-title">My Appraisal Review List</div>
    <div class="card-body">
        <a href="#" onclick="ViewAppraisalDoc();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <a href="#" onclick="SendDocTo('0');" class="btn btn-primary BtnPadding disabled" id="SendToAppraisee"><<< Send Back to Appraisee</a>
        <a href="#" onclick="SendDocTo('1');" class="btn btn-danger BtnPadding disabled" id="SendToSup">Send to Supervisor >>></a>
        <a href="#" onclick="SendDocTo('3');" class="btn btn-danger BtnPadding disabled" id="SendToHR">Send to HR >>></a>
        <hr />
        <div id="divAppraisalList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {       
        LoadAppraisalReviewList();
    });
    var LoadAppraisalReviewList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            //data: JSON.stringify({ Level: level }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: "/Appraisal/AppraisalReviewListPartialView",
            success: function (data) {
                HideProgress();
                $("#divAppraisalList").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            $("#ViewDoc").removeClass("disabled");
            $("#SendToAppraisee").removeClass("disabled");
            $("#SendToPeer").removeClass("disabled");
            $("#SendToSup").removeClass("disabled");
            $("#SendToHR").removeClass("disabled");
        });
    }
    var ViewAppraisalDoc = function () {        
        var row = $('#tableScoreCard tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        
        window.location = "/Appraisal/AppraisalReviewScoreCard?AppDoc=" + DocNo;
    }
    var SendDocTo = function (SendTo) {
        var level = GetParameterValues('Level');
        function GetParameterValues(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
        var row = $('#tableScoreCard tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, SendTo: SendTo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Appraisal/SendDocumentTo',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadAppraisalReviewList(level);
                    DiableButtons();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DiableButtons = function () {
        $("#ViewDoc").addClass("disabled");
        $("#SendToAppraisee").addClass("disabled");
        $("#SendToPeer").addClass("disabled");
        $("#SendToSup").addClass("disabled");
        $("#SendToHR").addClass("disabled");
        $('table tbody tr').siblings().removeClass("selectedTableRow");
    }
</script>


