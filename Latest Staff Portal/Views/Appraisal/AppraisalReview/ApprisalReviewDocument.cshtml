@model Latest_Staff_Portal.ViewModel.AppraisalCardList
@{
    ViewBag.Title = "ApprisalReviewDocument";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div style="background-color: black;">
    <a href="#" onclick="AppRequisitionLink();" style="color:yellow"><<< Back To Appraisal Review List</a>
</div>
<div class="card">
    <div class="card-title">Appraisal Document(Document No : @Request.QueryString["AppDoc"])</div>
    <div class="card-body">
        <div id="accordion" role="tablist" aria-multiselectable="true">
            <div class="card mb-1 shadow-none">
                <div class="card-header" id="headingOne" aria-controls="collapseOne" aria-expanded="true" data-toggle="collapse" href="#collapseOne">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-up"></span>General Information
                    </h6>
                </div>
                <div id="collapseOne" class="panel-collapse collapse show" aria-labelledby="headingOne" data-parent="#accordion">
                    <div class="card-body">
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Apprisal Code</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning" id="DocNo">@Model.ApprisalCode</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">User ID</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.UserID</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Staff Number</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.StaffNo</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Staff Name</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.StaffName</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="padding: 2px">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Apprisal Period</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning" id="AppPeriod">@Model.ApprisalPeriod</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Apprisal Type</label>
                                    </div>
                                    <div class="col-md-8">
                                        <span class="label label-warning">@Model.AppraisalType</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row" style="padding: 2px" id="divPeerAssign">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label style="font-size: 12px; font-weight: bold">Peer Reviewer</label>
                                    </div>
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.No, Model.ListOfEmployee, "--select Peer--", new { @class = "form-control", @id = "ddlPeer" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row">
                                    <input type="button" class="btn btn-primary waves-effect waves-light" value="Assign Peer" onclick="AssignDocPeer();" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none" id="divObjSettings">
                <div class="card-header" id="headingTwo" aria-expanded="false" aria-controls="collapseTwo" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span> Appraisal Objective Settings
                    </h6>
                </div>
                <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo"
                     data-parent="#accordion">
                    <div class="card-body">
                        <div id="divScoreCard"></div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none" id="divObjSettingReview">
                <div class="card-header" id="headingThree" aria-expanded="false" aria-controls="collapseThree" data-toggle="collapse" data-parent="#accordion" href="#collapseThree">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span> Appraisal Objective Evaluation
                    </h6>
                </div>
                <div id="collapseThree" class="collapse" aria-labelledby="headingThree"
                     data-parent="#accordion">
                    <div class="card-body">
                        <div id="divScoreCardEval"></div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none" id="divSkillsComp">
                <div class="card-header" id="headingSix" aria-expanded="false" aria-controls="collapseSix" data-toggle="collapse" href="#collapseSix">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span>Core Skills & Competencies
                    </h6>
                </div>
                <div id="collapseSix" class="collapse" aria-labelledby="headingSix" data-parent="#accordion">
                    <div class="card-body">
                        <div id="divCoreCompVal"></div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none" id="divSkillsDev">
                <div class="card-header" id="headingSeven" aria-expanded="false" aria-controls="collapseSeven" data-toggle="collapse" href="#collapseSeven">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span>Performance Improvement Plan
                    </h6>
                </div>
                <div id="collapseSeven" class="collapse" aria-labelledby="headingSeven" data-parent="#accordion">
                    <div class="card-body">
                        <div id="divPImpPlan"></div>
                    </div>
                </div>
            </div>
            <div class="card mb-1 shadow-none" id="divGeneralComments">
                <div class="card-header" id="headingNine" aria-expanded="false" aria-controls="collapseNine" data-toggle="collapse" href="#collapseNine">
                    <h6 class="m-0">
                        <span class="fa fa-arrow-down"></span>General Comments
                    </h6>
                </div>
                <div id="collapseNine" class="collapse" aria-labelledby="headingNine" data-parent="#accordion">
                    <div class="card-body">
                        <div id="divGeneralComm"></div>
                    </div>
                </div>
            </div>
            <hr />
            <div>
                <div class="row">
                    <div class="col-md-4">
                        <input type="button" value="<<< Send Back to Appraisee" class="btn btn-primary" onclick="SendDocTo('0');" id="btnAppraisee" />
                        <input type="button" value="<<< Send Back to Supervisor" class="btn btn-primary" onclick="SendDocTo('1');" id="btnSupervisor" />
                    </div>
                    <div class="col-md-4">
                        <input type="button" value="Send To Peer >>>" class="btn btn-primary" onclick="SendDocTo('2');" id="btnPeer" />
                    </div>
                    <div class="col-md-4">
                        <input type="button" value="Send To HR >>>" class="btn btn-primary" onclick="SendDocTo('3');" id="btnHR" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('.shadow-none').on('shown.bs.collapse', function () {
            $(this).find('.fa-arrow-down').removeClass('fa-arrow-down').addClass('fa-arrow-up');
        }).on('hidden.bs.collapse', function () {
            $(this).find('.fa-arrow-up').removeClass('fa-arrow-up').addClass('fa-arrow-down');
        });
        $("#ddlPeer").select2({
            width: '100%'
        });
        var level = GetParameterValues('Level');
        function GetParameterValues(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
        if (level == "P") {
            $("#divPeerAssign").hide();
            $("#divObjSettings").hide();
            $("#divSkillsDev").hide();
            $("#divGeneralComments").hide();
            $("#btnAppraisee").hide();
            $("#btnPeer").hide();
            $("#btnHR").hide();
        }
        else {
            $("#divPeerAssign").show();
            $("#btnSupervisor").hide();
        }
        LoadSectionData(level);
    });
    var LoadSectionData = function (level) {
        ShowProgress();
        var DocNo = $("#DocNo").html();
        LoadScoreCardObjective(DocNo, level);
        LoadScoreCardObjectiveEvaluation(DocNo, level);
        LoadCoreSkillsCompValues(DocNo, level);
        LoadPImprSkillsDevPlan(DocNo, level);
        LoadGeneralComments(DocNo, level);
        HideProgress();
    };
    ///////////////Load Data////////////////
    var LoadScoreCardObjective = function (DocNo, level) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Type: "S", Level: level }),
            url: "/Appraisal/LoadScoreCardObjectives",
            success: function (data) {
                $("#divScoreCard").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var LoadScoreCardObjectiveEvaluation = function (DocNo, level) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Type: "E", Level: level }),
            url: "/Appraisal/LoadScoreCardObjectives",
            success: function (data) {
                $("#divScoreCardEval").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var LoadCoreSkillsCompValues = function (DocNo, level) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Level: level }),
            url: "/Appraisal/LoadCoreSkillsCompetenceValues",
            success: function (data) {
                $("#divCoreCompVal").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var LoadPImprSkillsDevPlan = function (DocNo, level) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Level: level }),
            url: "/Appraisal/LoadPImprovementSkillsDevPlan",
            success: function (data) {
                $("#divPImpPlan").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var LoadGeneralComments = function (DocNo, level) {
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: DocNo, Level: level }),
            url: "/Appraisal/LoadGeneralComments",
            success: function (data) {
                $("#divGeneralComm").html(data);
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    ///////////////End of Load////////////////////
    ///////////////Objective////////////////////
    var EvalObjectiveItem = function (LineNo, DocNo, Level) {
        $("#labelF").text("Evaluate Objective Line");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            url: "/Appraisal/EvaluateAppraisalObjectiveLine",
            data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo, Level: Level }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SaveEvaluationLine = function (LineNo, DocNo, Level) {
        var ratings = $("#txtRating").val();
        if (ratings == "") {
            Swal.fire('error', 'Enter self ratings', 'error');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/Appraisal/SaveAppraisalObjectiveLineAchievement",
                data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo, achvmnt: "", ratings: ratings, Level: Level }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        Swal.fire('Success', data.message, 'success');
                        HideProgress();
                        LoadScoreCardObjectiveEvaluation(DocNo, Level);
                        $("#myModal").modal("hide");
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    ///////////////End Objective////////////////////
    ///////////////Skills Compe////////////////////
    var EditSkillCompItem = function (LineNo, DocNo, Level) {
        $("#labelF").text("Skill $ Competence Score");
        ShowProgress();
        $.ajax({
            type: "post",
            url: "/Appraisal/EditSkillCompetenceValue",
            data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo, Level: Level }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SaveSkillCompScore = function (LineNo, DocNo, Level) {
        var Score = $("#txtRating").val();
        if (Score == "") {
            Swal.fire('error', 'Enter your Ratings', 'error');
            return;
        }
        else {
            var from;
            if (Level == "A") {
                from = "0";
            }
            if (Level == "S") {
                from = "1";
            }
            if (Level == "P") {
                from = "2";
            }
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/Appraisal/SubmitSkillCompScore",
                data: JSON.stringify({ LnNo: LineNo, DocNo: DocNo, score: Score, from: from }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        Swal.fire('Success', data.message, 'success');
                        HideProgress();
                        LoadCoreSkillsCompValues(DocNo, Level);
                        $("#myModal").modal("hide");
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    ///////////////end Skills Compe////////////////////
    ///////////////Save Comments////////////////////
    var SaveComments = function (section, Level) {
        var DocNo = $("#DocNo").html();
        if (DocNo == "") {
            Swal.fire('error', 'Appraisal Doc No cannot be empty', 'error');
            return;
        }
        else {
            if (section == "1") {
                var rows = $("#tableObj > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your objectives", 'error');
                }
                else {
                    var comments = $("#ObjAppraisorComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter supervisor Objective Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments, Level);
                    }
                }
            }
            else if (section == "2") {
                var rows = $("#tableObjReview > tbody > tr.HasData").length;

                var comments = $("#ObjReviewAppraisorComments").val();
                if (comments == "") {
                    Swal.fire('error', 'Enter supervisor Objective review Comment', 'error');
                    return;
                }
                else {
                    SubmitSectionComments(DocNo, section, comments, Level);
                }
            }
            else if (section == "3") {
                var rows = $("#tableSkillComp > tbody > tr.HasData").length;

                var comments = $("#ObjSkillsCompeAppraisorComments").val();
                if (comments == "") {
                    Swal.fire('error', 'Enter supervisor skills and competence Comment', 'error');
                    return;
                }
                else {
                    SubmitSectionComments(DocNo, section, comments, Level);
                }
            }
            else if (section == "4") {
                var rows = $("#tableSkillDev > tbody > tr.HasData").length;
                if (parseInt(rows) < 1) {
                    Swal.fire('error', "You have not entered your skills and development", 'error');
                }
                else {
                    var comments = $("#SkillsDevAppraisorComments").val();
                    if (comments == "") {
                        Swal.fire('error', 'Enter supervisor Skills and Development Comment', 'error');
                        return;
                    }
                    else {
                        SubmitSectionComments(DocNo, section, comments, Level);
                    }
                }
            }
            else if (section == "5") {
                var comments = $("#GeneralAppraisorComments").val();
                if (comments == "") {
                    Swal.fire('error', 'Enter supervisor general Comment', 'error');
                    return;
                }
                else {
                    SubmitSectionComments(DocNo, section, comments, Level);
                }
            }
            else {
                Swal.fire('error', "Failed to save comments", 'error');
                return;
            }
        }
    }
    var SubmitSectionComments = function (DocNo, section, comment, Level) {
        if (Level == "") {
            Swal.fire('Error', "Comment from cannot be empty", 'error');
            return;
        }
        else {
            var from;
            if (Level == "A") {
                from = "0";
            }
            if (Level == "S") {
                from = "1";
            }
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/Appraisal/SaveAppraisalComments",
                data: JSON.stringify({ DocNo: DocNo, Comment: comment, section: section, from: from }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        Swal.fire('Success', data.message, 'success');
                        HideProgress();
                        if (section == "1") {
                            LoadScoreCardObjective(DocNo, Level);
                        }
                        if (section == "2") {
                            LoadScoreCardObjectiveEvaluation(DocNo, Level);
                        }
                        if (section == "3") {
                            LoadCoreSkillsCompValues(DocNo, Level);
                        }
                        if (section == "4") {
                            LoadPImprSkillsDevPlan(DocNo, Level);
                        }
                        if (section == "5") {
                            LoadGeneralComments(DocNo, Level);
                        }
                        $("#myModal").modal("hide");
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    ///////////////End////////////////////
    var SendDocTo = function (SendTo) {
        var DocNo = $("#DocNo").html();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, SendTo: SendTo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Appraisal/SendDocumentTo',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    var level = GetParameterValues('Level');
                    function GetParameterValues(name) {
                        name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
                        var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
                        var results = regex.exec(location.search);
                        return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
                    }
                    window.location = "/Appraisal/MyReviewAppraisalList?Level=" + level;
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var AppRequisitionLink = function () {
        var level = GetParameterValues('Level');
        function GetParameterValues(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
        ShowProgress();
        window.location = "/Appraisal/MyReviewAppraisalList?Level=" + level;
    }
    var AssignDocPeer = function () {
        var DocNo = $("#DocNo").html();
        var Peer = $("#ddlPeer").children("option:selected").val();
        if (Peer == "") {
            Swal.fire('Error', "Select Peer Reviewer", 'error');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                data: JSON.stringify({ DocNo: DocNo, Peer: Peer }),
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '/Appraisal/UpdatePeerReviewer',
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadSectionData();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function (err) {
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
</script>


