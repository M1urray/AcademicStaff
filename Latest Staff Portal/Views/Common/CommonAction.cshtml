@model Latest_Staff_Portal.ViewModel.DocumentNumber
<div>
    <b>Document Number =></b> @Model.Code
</div>
<hr />
<ol class="list-group">
    <li class="list-group-item"><a href="#" onclick="ViewDoc('@Model.Code');" class="btn btn-primary form-control" style="padding: .5rem .5rem">View Document</a></li>
    @if (Model.Status == "Open" || Model.Status == "Pending" || Model.Status == "New")
    {
        <li class="list-group-item"><a href="#" onclick="SendDocForApproval('@Model.Code');" class="btn btn-primary form-control" style="padding: .5rem .5rem">Send Approval Request</a></li>
    }
    @if (Model.Status == "Pending Approval")
    {
        if (@Model.DocType != "LV")
        {
            <li class="list-group-item"><a href="#" onclick="CancelDocForApproval('@Model.Code');" class="btn btn-primary form-control" style="padding: .5rem .5rem">Cancel Approval Request</a></li>
        }
        <li class="list-group-item"><a href="#" onclick="ViewApprovalTrail('@Model.Code');" class="btn btn-primary form-control" style="padding: .5rem .5rem">Document Approval Trail</a></li>
    }
    <li class="list-group-item"><a href="#" onclick="ViewDocComments('@Model.Code');" class="btn btn-primary form-control" style="padding: .5rem .5rem">Document Comments</a></li>
</ol>
