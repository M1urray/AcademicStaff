@model Latest_Staff_Portal.ViewModel.IndividualObjectives
<div>
    <b>Document Number =></b> @Model.Code
</div>
<hr />
<ol class="list-group">
    <li class="list-group-item"><a href="#" onclick="ObjectiveTarget('@Model.EntryNo');" class="btn btn-success form-control" style="padding: .5rem .5rem">Objective Targets</a></li>
    <li class="list-group-item"><a href="#" onclick="UpdateObjectiveForm(`@Model.Obj`, `@Model.EntryNo`);" class="btn btn-primary form-control" style="padding: .5rem .5rem">Edit Objective</a></li>
    <li class="list-group-item"><a href="#" onclick="DeleteObjective('@Model.EntryNo');" class="btn btn-danger form-control" style="padding: .5rem .5rem">Delete Objective</a></li>
</ol>

