@model Latest_Staff_Portal.ViewModel.Fuel
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-body">
        <b>Top-Up Card Form</b>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Directorate", htmlAttributes: new { @class = "control-label col-md-12" })
                    @*<div class="col-md-12">
                        @Html.DropDownListFor(model => model.Directorate, Model.ListOfDirectorate, "--select Directorate--", new { @class = "form-control", @id = "ddlDirectorate", @readonly = "readonly", @style = "background-color:#dedebd" })
                        @Html.ValidationMessageFor(model => model.Directorate, "", new { @class = "text-danger" })
                    </div>*@
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Amount To Top-Up", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Amount_To_Topup, new { @clas = "form-control", @id = "txtTopupAmnt" })
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Create Document" onclick="SubmitImprestRequisition('@Model.DisDir');" />
        </div>
    </div>
</div>


