@model IEnumerable<Latest_Staff_Portal.ViewModel.Fuel>
<div class="table-responsive">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap">
        <thead>
            <tr>
                <th>No</th>
                <th>Card No</th>
                <th>Vehicle</th>
                <th>Max. Amount Allocated</th>
                <th>Amount Consumed</th>
                <th>Amount To Topup</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.No)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Driver)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Vehicle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Max_Amount)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.Amount_Consumed)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.Amount_To_Topup)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<hr />
