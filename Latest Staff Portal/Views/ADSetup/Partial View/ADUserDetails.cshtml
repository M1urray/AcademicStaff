@model Latest_Staff_Portal.ViewModel.UserDetails
<div class="bg-soft-dark" style="color:black">
    <div class="row" id="DivService">
        <div class="col-md-6">
            First Name<span style="color:red">*</span>
            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @id = "txtFName", @autocomplete = "off" })
        </div>
        <div class="col-md-6">
            Last Name<span style="color:red">*</span>
            @Html.TextBoxFor(m => m.Surname, new { @class = "form-control", @id = "txtLName", @autocomplete = "off" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            User Login Name(User ID)<span style="color:red">*</span>
            @Html.TextBoxFor(m => m.SamAccountName, new { @class = "form-control", @id = "txtLoginName", @autocomplete = "off" })
        </div>
        <div class="col-md-6">
            Email Address<span style="color:red">*</span>
            @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", @id = "txtEmAddress", @autocomplete = "off" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            Phone Number
            @Html.TextBoxFor(m => m.TelephoneNumber, new { @class = "form-control", @id = "txtPNo", @autocomplete = "off" })
        </div>
        <div class="col-md-6">
            Employee ID
            @Html.TextBoxFor(m => m.EmployeeId, new { @class = "form-control", @id = "txtEmp_ID", @autocomplete = "off" })
        </div>
    </div>
    @if (Model.SamAccountName == null || Model.SamAccountName == "")
    {
        <div class="row">
            <div class="col-md-6">
                Password<span style="color:red">*</span>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", @id = "txtPwrd", @autocomplete = "off" })
            </div>
            <div class="col-md-6">
                Confirm Password<span style="color:red">*</span>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @id = "txtCPwrd", @autocomplete = "off" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <hr style="border: 1px solid black" />
                <div class="title"><b><u>Password Policy</u></b></div>
                Your Password should include :
                <ul style="font-size: 12px">
                    <li>Uppercase—for example, A to Z</li>
                    <li>Lowercase—for example, a to z</li>
                    <li>Numeric—0 to 9</li>
                    <li>Nonalphanumeric—symbols such as !, #, %, or &</li>
                </ul>
            </div>
        </div>
        <hr />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Add New User" onclick="SubmitNewUser();" />
        </div>
    }
    else
    {
        <hr />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Update User Details" onclick="UpdateUserDetails();" />
        </div>
    }
</div>
