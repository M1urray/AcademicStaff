@model Latest_Staff_Portal.ViewModel.ChangePassword
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-12">
            <h4>Change Password for @Html.DisplayFor(m => m.DisplayName)</h4>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            Password
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @id = "txtCPwrd" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            Confirm Password
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @id = "txtCCPwrd" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <hr style="border: 1px solid black" />
            <div class="title"><b><u>Password Policy</u></b></div>
            Your Password should include :
            <ul style="font-size: 12px">
                <li>Uppercase—for example, A to Z</li>
                <li>Lowercase—for example, a to z</li>
                <li>Numeric—0 to 9</li>
                <li>Nonalphanumeric—symbols such as !, #, %, or &</li>
            </ul>
        </div>
    </div>
    <hr />
    <div align="center">
        <input type="button" class="btn btn-primary waves-effect waves-light" value="Change Password" onclick="SubmitNewPassword('@Model.UserID');" />
    </div>
</div>
