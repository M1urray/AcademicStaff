
@{
    ViewBag.Title = "ListofUsers";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 7px;
        font-size: 12px;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">AD User Management</div>
    <hr />
    <div class="card-body">
        <a href="#" onclick="EnterNewUser();" class="btn btn-primary BtnPadding">Create New User</a>
        <hr />
        <div id="divADUserList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">User Details</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
   $(document).ready(function () {
        LoadADUserList();
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        var Errormsg = '@Request.RequestContext.HttpContext.Session["ErrorMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success', true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("NullibySessions", "Common")'
            });
        }
        if (Errormsg != "") {
            Swal.fire('Warning', Errormsg, 'warning', true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("NullibySessions", "Common")'
            });
        }
    });
    var LoadADUserList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("GetListofUsers", "ADSetup")',
            success: function (data) {
                $("#divADUserList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire("Error","There is some problem to process your request. Please try after some time","error");
            }
       });
    }
    var EnterNewUser = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("NewADUser", "ADSetup")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitNewUser = function () {
        var FirstName = $("#txtFName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Surname = $("#txtLName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var EmailAddress = $("#txtEmAddress").val().replace(/(\r\n|\n|\r)/gm, " ");
        var SamAccountName = $("#txtLoginName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Telephone = $("#txtPNo").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Password = $("#txtPwrd").val().replace(/(\r\n|\n|\r)/gm, " ");
        var ConfPassword = $("#txtCPwrd").val().replace(/(\r\n|\n|\r)/gm, " ");
        if (FirstName == "") {
            Swal.fire('Warning', "Enter First Name", 'warning');
            return;
        }
        else if (Surname == "") {
            Swal.fire('Warning', "Enter Last Name", 'warning');
            return;
        }
        else if (SamAccountName == "") {
            Swal.fire('Warning', "Enter User Login Name", 'warning');
            return;
        }
        else if (EmailAddress == "") {
            Swal.fire('Warning', "Enter User Email Address", 'warning');
            return;
        }
        else if (Password == "") {
            Swal.fire('Warning', "Enter User Login Password", 'warning');
            return;
        }
        else if (ConfPassword == "") {
            Swal.fire('Warning', "Confirm User Login Password", 'warning');
            return;
        }
        else if (Password != ConfPassword) {
            $("#NewPassword").val('');
            $("#confirmPass").val('');
            Swal.fire('Warning', 'Passwords do not match. Enter them again', 'warning');
            return;
        }
        else {
            ShowProgress();
            var UserDetails = {};
            UserDetails.FirstName = FirstName;
            UserDetails.Surname = Surname;
            UserDetails.EmailAddress = EmailAddress;
            UserDetails.SamAccountName = SamAccountName;
            UserDetails.TelephoneNumber = Telephone;
            UserDetails.Password = Password;
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                data: JSON.stringify({ userD: UserDetails }),
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '@Url.Action("SubmitADUserDetails", "ADSetup")',
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        $("#myModal").modal("hide");
                        LoadADUserList();
                        Swal.fire('Success', data.Message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Error', data.Message, 'error');
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var UpdateUserDetails = function () {
        var FirstName = $("#txtFName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Surname = $("#txtLName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var EmailAddress = $("#txtEmAddress").val().replace(/(\r\n|\n|\r)/gm, " ");
        var SamAccountName = $("#txtLoginName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Telephone = $("#txtPNo").val().replace(/(\r\n|\n|\r)/gm, " ");
        if (FirstName == "") {
            Swal.fire('Warning', "Enter First Name", 'warning');
            return;
        }
        else if (Surname == "") {
            Swal.fire('Warning', "Enter Last Name", 'warning');
            return;
        }
        else if (SamAccountName == "") {
            Swal.fire('Warning', "Enter User Login Name", 'warning');
            return;
        }
        else if (EmailAddress == "") {
            Swal.fire('Warning', "Enter User Email Address", 'warning');
            return;
        }
        else {
            ShowProgress();
            var UserDetails = {};
            UserDetails.FirstName = FirstName;
            UserDetails.Surname = Surname;
            UserDetails.EmailAddress = EmailAddress;
            UserDetails.SamAccountName = SamAccountName;
            UserDetails.TelephoneNumber = Telephone;
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                data: JSON.stringify({ userD: UserDetails }),
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '@Url.Action("UpdateADUserDetails", "ADSetup")',
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        $("#myModal").modal("hide");
                        LoadADUserList();
                        Swal.fire('Success', data.Message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Error', data.Message, 'error');
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var ChangePassword = function (UserID,DisplayName) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ UserID: UserID, DisplayName: DisplayName}),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("ChangePassword", "ADSetup")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitNewPassword = function (UserID) {
        var Password = $("#txtCPwrd").val().replace(/(\r\n|\n|\r)/gm, " ");
        var ConfPassword = $("#txtCCPwrd").val().replace(/(\r\n|\n|\r)/gm, " ");
        if (Password == "") {
            Swal.fire('Warning', "Enter new Password", 'warning');
            return;
        }
        else if (ConfPassword == "") {
            Swal.fire('Warning', "Confirm new Password", 'warning');
            return;
        }
        else if (Password != ConfPassword) {
            $("#txtCPwrd").val('');
            $("#txtCCPwrd").val('');
            Swal.fire('Warning', 'Passwords do not match. Enter them again', 'warning');
            return;
        }
        $.ajaxSetup({ cache: false });
        Swal.fire({
            title: 'Are you sure?',
            text: "You to change password for this user!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Change!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    cache: false,
                    url: '@Url.Action("SubmitChangedPassword", "ADSetup")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ UserID: UserID, Password: Password }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            $("#myModal").modal("hide");
                            LoadADUserList();
                            Swal.fire('Success', data.Message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.Message, 'warning');
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Attachment File has not been deleted', 'error');
            }
        });
    };
    var ViewDetails = function (UserID) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ UserID: UserID }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("ADUserDetails", "ADSetup")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>


