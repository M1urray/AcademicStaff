@using Latest_Staff_Portal.Models;
@{
    Layout = null;
    string imgSrc = "", gender = "", Name = "";
    bool HOD = false, Dean = false, Director = false, Lecturer = false, PartTimeLec = false;
    if (Session["Username"] == null)
    {
        Html.Action("Login", "Login");
    }
    else
    {
        if (Session["ImgProfile"] == null)
        {
            var base64 = CommonClass.ProfilePicture(Session["Username"].ToString());
            if (base64 != "")
            {
                imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                Session["ImgProfile"] = imgSrc;
            }
        }
        else
        {
            imgSrc = Session["ImgProfile"].ToString();
        }

        if (Session["StaffDetails"] == null)
        {
            string[] s = CommonClass.GetStaffDetails(Session["Username"].ToString());
            gender = s[0];
            Name = s[1];
            if (s[2] == "False")
            {
                HOD = false;
            }
            else
            {
                HOD = true;
            }
            if (s[3] == "False")
            {
                Dean = false;
            }
            else
            {
                Dean = true;
            }
            if (s[4] == "False")
            {
                Director = false;
            }
            else
            {
                Director = true;
            }
            if (s[5] == "False")
            {
                Lecturer = false;
            }
            else
            {
                Lecturer = true;
            }
            if (s[6] == "False")
            {
                PartTimeLec = false;
            }
            else
            {
                PartTimeLec = true;
            }
            Session["StaffDetails"] = s;
        }
        else
        {
            string[] s = (string[])Session["StaffDetails"];
            gender = s[0];
            Name = s[1];
            if (s[2] == "False")
            {
                HOD = false;
            }
            else
            {
                HOD = true;
            }
            if (s[3] == "False")
            {
                Dean = false;
            }
            else
            {
                Dean = true;
            }
            if (s[4] == "False")
            {
                Director = false;
            }
            else
            {
                Director = true;
            }
            if (s[5] == "False")
            {
                Lecturer = false;
            }
            else
            {
                Lecturer = true;
            }
            if (s[6] == "False")
            {
                PartTimeLec = false;
            }
            else
            {
                PartTimeLec = true;
            }
        }
    }
}
