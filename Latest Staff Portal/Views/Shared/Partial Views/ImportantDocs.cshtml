@model Latest_Staff_Portal.ViewModel.DocumentAttachmentList
<style>
    .btnPadding {
        padding: 5px;
        font-size: 10px;
    }
</style>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                File Extention
            </th>
            <th>
                Document Type
            </th>
            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.DocList != null)
            {
                if (Model.DocList.Count() > 0)
                {
                    foreach (var item in Model.DocList)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.FileName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FileExt)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DocType)
                            </td>
                            <td>
                                <button id="btnview" class="btn btn-primary btnPadding" onclick="ViewAttachment('@item.TabelID','@item.No','@item.ID','@item.FileName','@item.FileExt');">View Attachment</button>
                                @if (Model.Status == "Pending" || Model.Status == "Open")
                                {
                                    <button id="btndelete" class="btn btn-danger btnPadding" onclick="DeleteAttachment('@item.TabelID','@item.No','@item.ID');">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="color:red">
                            No Files Found
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
    <tfoot>
        <tr class="HideLineButton">
            <td class="text-right" colspan="8">
                <input type="button" value="Add Attachment" class="btn btn-danger BtnPadding" onclick="AddAttachment();" />
            </td>
        </tr>
    </tfoot>
</table>
<script type="text/javascript">
    $(document).ready(function () {
        var status = '@Model.Status';
        if (status == "Pending" || status == "Open") {
            $(".HideLineButton").show();
        }
        else {
            $(".HideLineButton").hide();
        }
    });
</script>
