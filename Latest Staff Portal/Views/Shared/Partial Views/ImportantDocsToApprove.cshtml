@model IEnumerable<Latest_Staff_Portal.ViewModel.DocumentAttachment>
<style>
    .btnPadding {
        padding: 5px;
        font-size: 10px;
    }
</style>
<table class="table table-bordered table-hover">
    <thead style="background-color:black;color:white">
        <tr>
            <th>
                Name
            </th>
            <th>
                File Extention
            </th>
            <th>
                Document Type
            </th>
            <th>
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                if (Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.FileName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FileExt)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DocType)
                            </td>
                            <td>
                                <button id="btnview" class="btn btn-primary btnPadding" onclick="ViewAttachment('@item.TabelID','@item.No','@item.ID','@item.FileName','@item.FileExt');">View Attachment</button>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="color:red">
                            No Files Found
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>

