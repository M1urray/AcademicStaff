@using System.Web.Optimization
@{
    Layout = null;
    string Greetings = "";
    if ((DateTime.Now.Hour >= 0) && (DateTime.Now.Hour < 12))
    {
        Greetings = "Good Morning";
    }
    else if ((DateTime.Now.Hour >= 12) && (DateTime.Now.Hour < 17))
    {
        Greetings = "Good Afternoon";
    }
    else
    {
        Greetings = "Good Evening";
    }
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>AIC -  KIJABE HOSPITAL | Staff Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="AIC -  KIJABE HOSPITAL | Staff Portal" name="description" />
    <meta content="Themesbrand" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">
    <!-- App Css-->
    @*<link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />*@

    @Styles.Render("~/asset/css/MyLoginCSS");
    <script src="~/assets/js/jquery2.0.3.min.js"></script>
    <style>
        .card-body {
            background-image: linear-gradient(to bottom,#38b8ea, #4b4f52);
        }

        .text-muted {
            color: #192f59 !important;
        }

        .lblClass {
            color: wheat;
        }
        .bg-soft-primary {
            height:179px
        }
        .login-body {
            background-image: url('../../assets/images/login-bg2.jpg');
            background-size: cover;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body class="login-body">
    <link href="~/assets/css/Loader.css" rel="stylesheet" />
    <div class="loading" align="center" id="divLoader">
        <br />
        <img src="~/assets/images/ajax-loader2.gif" alt="" width="150" height="150" />
    </div>
    @*<script src="~/assets/js/ObfuscateSite.js"></script>*@
    <div class="account-pages my-5 pt-sm-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6 col-xl-5">
                    <div class="card overflow-hidden">
                        <div class="bg-soft-primary">
                            <div class="row">
                                <div class="col-12">
                                    <img src="~/assets/images/retina_logo3.png" alt="" width="100%" height="100%">
                                </div>
                            </div>
                        </div>
                        <div class="card-body pt-0">
                            <hr />
                            @RenderBody()
                        </div>
                    </div>
                    <div class="mt-5 text-center">
                        <p>© @DateTime.Now.Year. Designed <i class="mdi mdi-heart text-danger"></i> by <a href="http://dsl.ke/" target="_blank">DSL Systems</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Sweet Alerts js -->
    <script src="~/assets/js/sweetalert2.min.js"></script>
</body>
</html>
