@model Latest_Staff_Portal.ViewModel.NewGatePassForm
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-6">
            <span style="font-weight: bold">Asset Transfer No</span>
            @Html.DropDownListFor(m => m.GatePassDoc.AssetTransferNo, new SelectList(Model.ListOfAssetTransfer, "Value", "Text", Model.GatePassDoc.EmployeeNo), "--Select Asset No--", new { @id = "ddlAssetNo", @class = "form-control" })
        </div>
        <div class="col-md-6">
            <span style="font-weight: bold">Asset To be Returned</span><br />
            <div class="custom-control custom-radio mb-2">
                <input type="radio" id="customRadio1" name="customRadio" class="custom-control-input" value="1">
                <label class="custom-control-label" for="customRadio1">Yes</label>
            </div>
            <div class="custom-control custom-radio">
                <input type="radio" id="customRadio2" name="customRadio" class="custom-control-input" value="2">
                <label class="custom-control-label" for="customRadio2">No</label>
            </div>
        </div>
    </div>
    <hr />
    <div align="center">
        <input type="button" class="btn btn-primary waves-effect waves-light" value="Create Gate Pass" onclick="CreateGatePass();" />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlPersontoSee,#ddlDepartment").select2({
            width: '100%',
            placeholder: 'Search...'
        });
    });
</script>



