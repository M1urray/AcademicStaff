
@{
    ViewBag.Title = "GatePassList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }

    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">Gate Pass List</div>
    <hr />
    <div class="card-body">
        <a href="#" onclick="NewGatePassForm();" class="btn btn-primary BtnPadding">New Gate Pass</a>
        <a href="#" onclick="SendDocForApproval();" class="btn btn-danger BtnPadding disabled" id="SendDocAppr">Send Approval Request</a>
        <hr />
        <div id="divGatePassList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">New Gate Pass Form</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadGatePassList();
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        var Errormsg = '@Request.RequestContext.HttpContext.Session["ErrorMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success', true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
        if (Errormsg != "") {
            Swal.fire('Warning', Errormsg, 'warning', true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
    });
    var LoadGatePassList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ Status: "Open" }),
            url: "/GatePass/GatePassListPartialView",
            success: function (data) {
                $("#divGatePassList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewGatePassForm = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/GatePass/NewGatePassRequest',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var ViewDoc = function (DocNo) {
        $("#labelF").text("Purchase Details Document");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Visitors/NewVisitDocumentView',
            data: JSON.stringify({ DocNo: DocNo }),
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var CreateGatePass = function () {
        var AssetNo = $("#ddlAssetNo").children("option:selected").val();
        var TbReturned = $('input[name="customRadio"]:checked').length;
        var checkedVal = $('input[name="customRadio"]:checked').val();
        
        if (AssetNo == "") {
            Swal.fire('Warning', "Select Asset Transfer No", 'warning');
            return;
        }
        else if (TbReturned < 1) {
            Swal.fire('Warning', "Select if the Asset will be Returned", 'warning');
            return;
        }

        else {
            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/GatePass/SubmitGatePassData",
                data: JSON.stringify({ AsstTransferNo: AssetNo, Return: checkedVal }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        LoadGatePassList();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var AdmitVisitor = function (DocNo) {
        ShowProgress();
        //Send the JSON array to Controller using AJAX.
        $.ajax({
            type: "POST",
            url: "/Visitors/AdmiVisitor",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success) {
                    HideProgress();
                    LoadVisitorsList();
                    $("#myModal").modal("hide");
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
</script>
