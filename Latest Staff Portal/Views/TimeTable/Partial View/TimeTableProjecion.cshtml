@model IEnumerable<Latest_Staff_Portal.ViewModel.TimeTableView>
<div class="pre-scrollable">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead style="background-color:black;color:white">
            <tr>
                <th>Unit</th>
                <th>Section</th>
                <th>Campus</th>
                <th>Semester</th>
                <th>Day of Week</th>
                <th>Period</th>
                <th>Room</th>
                <th>Lecturer</th>
                <th>Class Size</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Unit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Section)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Campus)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Semester)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Day_of_Week)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Period)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Lecture_Room)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LecturerName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ClassSize)
                            </td>
                            <td style="text-align:center" class="tdAction">
                                <a href="javascript:void(0);" class="mr-3 text-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EditProjection('@item.Unit', '@item.Section', '@item.Campus', '@item.Semester', '@item.Day_of_Week', '@item.Period', '@item.Lecture_Room', '@item.Lecturer', '@item.ClassSize', '@item.EntryNo');"><i class="mdi mdi-pencil font-size-16"></i></a>
                                <a href="javascript:void(0);" class="text-danger" data-toggle="tooltip" data-placement="top" title="" data-original-title="Delete" onclick="DeleteProjection('@item.EntryNo');"><i class="mdi mdi-close font-size-16"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                {
                    extend: 'excel',
                    text:"Export to Excel",
                    title: 'Timetable Projections'
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });   
</script>


