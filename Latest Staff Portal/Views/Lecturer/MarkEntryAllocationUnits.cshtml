    var ExamSetUpForm = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: "/Lecturer/ExamEntrySetupForm",
            success: function (data) {
                HideProgress();
                $('#myModalLinks').modal("hide");
                $("#modalBodySetup").html(data);
                $("#myExamEntryModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DetermineNoOfRows = function () {
        var totalRowCount = $("#ExamSetLines TBODY tr").length;
        if (totalRowCount > 0) {
            $("#NoRecords").hide();
        }
        else {
            $("#NoRecords").show();
        }
    }
    var SubmitExamEntrySetup = function () {
        var myTableArray = [];
        $('#ExamSetLines tbody tr').each(function () {
            var arrayOfThisRow = [];
            var tableData = $(this).find('td');
            if (tableData.length > 0) {
                tableData.each(function () {
                    if ($(this).find("input[type=text]").length) {
                        var myText = $(this).find("input[type=text]").val();
                        arrayOfThisRow.push(myText);
                    }
                    else arrayOfThisRow.push($(this).text());
                });

                myTableArray.push(arrayOfThisRow);
            }
        });
        if (myTableArray.length < 1) {
            Swal.fire('Warning', 'You have not Added any Setup line(s)', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                async: true,
                type: "POST",
                //datatype: "json",
                data: { Rows: myTableArray },
                url: "/Lecturer/DeleteExamSetupEntry",
                contenttype: "text/plain; charset=utf-8",
                success: function (data) {
                    if (data.success == true) {
                        //Send the JSON array to Controller using AJAX.
                        $.ajax({
                            type: "POST",
                            url: "/Lecturer/SubmitExamSetupEntry",
                            data: { Rows: myTableArray, Insert: true },
                            contenttype: "text/plain; charset=utf-8",
                            success: function (data) {
                                if (data.success) {
                                    HideProgress();
                                    EntrySetUp();
                                    Swal.fire('Success', data.message, 'success');
                                }
                                else {
                                    Swal.fire('Warning', data.message, 'warning');
                                    HideProgress();
                                }
                            },
                            error: function (err) {
                                HideProgress();
                                console.log(err);
                                Swal.fire('Warning', err, 'warning');
                            }
                        });
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var UpdateSetup = function () {
        var myTableArray = [];
        $('#ExamSetUpLines tbody tr').each(function () {
            var arrayOfThisRow = [];
            var tableData = $(this).find('td');
            if (tableData.length > 0) {
                tableData.each(function () {
                    if ($(this).find("input[type=text]").length) {
                        var myText = $(this).find("input[type=text]").val();
                        arrayOfThisRow.push(myText);
                    }
                    else arrayOfThisRow.push($(this).text());
                });

                myTableArray.push(arrayOfThisRow);
            }
        });
        if (myTableArray.length < 1) {
            Swal.fire('Warning', 'You have not Added any Setup line(s)', 'warning');
            return;
        }
        else {
            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/Lecturer/ModifyExamSetupEntry",
                data: { Rows: myTableArray, Insert: false },
                contenttype: "text/plain; charset=utf-8",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        ExamSetUpForm();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    console.log(err);
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var AddSetup = function () {
        var Cat = $("#ddlCategory").children("option:selected").text();
        var Descr = $("#txtDesc").val().replace(/(\r\n|\n|\r)/gm, " ");
        if (Cat == "") {
            Swal.fire('Warning', "Select Category", 'warning');
            return;
        }
        else if (Descr == "") {
            Swal.fire('Warning', "Give a brief description", 'warning');
            return;
        }
        else {
            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                datatype: "json",
                contentType: "application/json; charset = utf-8",
                url: "/Lecturer/InsertExamSetuEnry",
                data: JSON.stringify({ ExamType: Cat, Description: Descr }),
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        ExamSetUpForm();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var RemoveEntrySetup = function (ExamT, EntryNo) {
        ShowProgress();
        //Send the JSON array to Controller using AJAX.
        $.ajax({
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            url: "/Lecturer/DeleteExamSetupEntry",
            data: JSON.stringify({ ExamT: ExamT, EntryNo: EntryNo }),
            success: function (data) {
                if (data.success) {
                    HideProgress();
                    ExamSetUpForm();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
</script>