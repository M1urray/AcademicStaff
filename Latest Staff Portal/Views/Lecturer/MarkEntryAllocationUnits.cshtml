@model IEnumerable<Latest_Staff_Portal.ViewModel.LecturerAssignedUnits>
@{
    ViewBag.Title = "MarkEntryAllocationUnits";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">Course Allocation List</div>
    <div class="card-body">
        <table id="datatable-buttons" class="table table-responsive-sm table-bordered" style="border-collapse: collapse; border-spacing: 0; width: 100%; font-size:12px">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Code</th>
                    <th>Stage</th>
                    <th>Semester</th>
                    <th>Unit</th>
                    <th>Unit Name</th>
                    <th>Campus</th>
                    <th>@*Settlement Type*@</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null)
                    {
                        {
                            if (Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <button onclick="SelectedRow('@item.Code','@item.Stage','@item.Semester', '@item.Unit', '@item.Unit_Name', '@item.Campus_Code','@item.Student_Type');" class="btn btn-sm btn-danger">Select</button>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Code)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Stage)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Campus_Code)
                                        </td>
                                        @*<td>
                                                @Html.DisplayFor(modelItem => item.Student_Type)
                                            </td>*@
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" style="color:red">
                                        No lecturer Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@*//////////////////////Modal Links////////////////////////////*@
<div class="modal fade" id="myModalLinks" data-toggle="modal" tabindex="-1" data-dismiss="modal" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelLnks"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyLinks">
                <div>
                    <b>Unit =></b> <label id="lblUnit"></label>-<label id="lblUnitName"></label>
                </div>
                <hr />
                <ol class="list-group">
                    <li class="list-group-item"><a href="#" onclick="EnterClassAttendance();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Class Attendance</a></li>
                    @*<li class="list-group-item"><a href="#" onclick="ExamSetUpForm();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Exam Entry Setup</a></li>*@
                    <li class="list-group-item"><a href="#" onclick="AssignMarks();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Assign Marks</a></li>
                    <li class="list-group-item"><a href="#" onclick="GetSpecialExamList();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Special Exam Marks</a></li>
                    <li class="list-group-item"><a href="#" onclick="RetportType('EXAMATT');" class="btn btn-primary form-control" style="padding: .5rem .5rem">Print Exam Attendance</a></li>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Report Type////////////////////////////*@
<div class="modal fade" id="myReportTModal" data-toggle="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel">Report Type</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyReportT">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" data-toggle="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody" style="width:100%;height:450px">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    }
                },
                {
                    extend: 'pdf',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    }
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });
   var SelectedRow = function (Prog,Stage,Sem, Unit, UnitName, Campus) {
        var UnitStudentListFilters = {};
        UnitStudentListFilters.Prog = Prog;
        UnitStudentListFilters.Stage = Stage;
        UnitStudentListFilters.Sem = Sem;
        UnitStudentListFilters.Unit = Unit;
        UnitStudentListFilters.UnitName = UnitName;
        UnitStudentListFilters.Campus = Campus;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("AssignAssignedUnitSessions", "lecturer")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ StudentUnitFilters: UnitStudentListFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    $("#lblUnit").text(Unit);
                    $("#lblUnitName").text(UnitName);
                    $("#labelLnks").text("Unit Links");
                    HideProgress();
                    $("#myModalLinks").modal("show");
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                Swal.fire('Error', err, 'error');
            }
        });
    }
    var EnterClassAttendance = function () {
        ShowProgress();
        window.location = '@Url.Action("ClassAttendanceList", "lecturer")?Section=ME';
    }
    var AssignMarks = function (Prog, Descr) {
        ShowProgress();
        window.location = '@Url.Action("StudentUnitList", "lecturer")';
    }
    var GetSpecialExamList = function () {
        ShowProgress();
        window.location = '@Url.Action("SpecialExamList", "lecturer")';
    }
    var RetportType = function (ReportType) {
        ShowProgress();
        $.ajax({
            url: '@Url.Action("ReportTypeForm", "Common")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Rep: ReportType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#modalBodyReportT").html(data);
                HideProgress();
                $("#myModalLinks").modal("hide");
                $("#myReportTModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var PrintUnitReports = function (ReportType) {
        var RType = $("#ddlType").children("option:selected").val().trim();
        ShowProgress();
        $.ajax({
            url: '@Url.Action("GetUnitReports", "Lecturer")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ ReportType: ReportType, RType: RType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    $("#myReportTModal").modal("hide");
                    if (RType == "1") {
                        var viewer = $("#modalBody");
                        PDFObject.embed(data.message, viewer);
                        $("#myModalUnits").modal("show");
                    }
                    else {
                        window.location = '@Url.Action("AttachmentDownload", "Common")?fileName=' + data.message;
                        Swal.fire('Success', 'Document Downloaded successfully', 'success');
                    }
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
                HideProgress();
            }
        });
    }
</script>
