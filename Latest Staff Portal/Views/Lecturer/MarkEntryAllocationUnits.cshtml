@model Latest_Staff_Portal.ViewModel.LecAssignedUnits
@{
    ViewBag.Title = "MarkEntryAllocationUnits";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">Course Allocation List</div>
    <div class="card-body">
        <h4>List of Assigned Units</h4>
        <table id="datatable-buttons" class="table table-hover nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%; font-size:12px">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Unit</th>
                    <th>Section</th>
                    <th>Unit Name</th>
                    <th>Day</th>
                    <th>Period</th>
                    <th>Room</th>
                    <th>Campus</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null)
                    {
                        {
                            if (Model.ListOfAssignedUnits.Count() > 0)
                            {
                                foreach (var item in Model.ListOfAssignedUnits)
                                {
                                    <tr>
                                        <td>
                                            <button onclick="SelectedRow(`@item.Semester`, `@item.Unit`, `@item.Unit_Name`, `@item.Campus_Code`,`@item.CourseClass`,false);" class="btn btn-sm btn-danger">Select</button>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.CourseClass)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Day)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Period)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Room)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Campus_Code)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.stdCount)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" style="color:red">
                                        No lecturer Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
        <hr />
        <h4>List of Associate Units</h4>
        <table id="datatable" class="table table-hover nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%; font-size:12px">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Unit</th>
                    <th>Section</th>
                    <th>Unit Name</th>
                    <th>Day</th>
                    <th>Period</th>
                    <th>Room</th>
                    <th>Campus</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null)
                    {
                        {
                            if (Model.ListOfAssociateUnits.Count() > 0)
                            {
                                foreach (var item in Model.ListOfAssociateUnits)
                                {
                                    <tr>
                                        <td>
                                            <button onclick="SelectedRow(`@item.Semester`, `@item.Unit`, `@item.Unit_Name`, `@item.Campus_Code`,`@item.CourseClass`,true);" class="btn btn-sm btn-danger">Select</button>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.CourseClass)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Day)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Period)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Room)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Campus_Code)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.stdCount)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" style="color:red">
                                        No lecturer Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@*//////////////////////Modal Links////////////////////////////*@
<div class="modal fade" id="myModalLinks" data-toggle="modal" tabindex="-1" data-dismiss="modal" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelLnks"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyLinks">
                <div>
                    <b>Unit =></b> <label id="lblUnit"></label>-<label id="lblUnitName"></label>
                </div>
                <hr />
                <ol class="list-group">
                    <li class="list-group-item"><a href="#" onclick="EnterClassAttendance();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Class Attendance</a></li>
                    <li class="list-group-item"><a href="#" onclick="ExamSetUpForm();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Exam Entry Setup</a></li>
                    <li class="list-group-item"><a href="#" onclick="StudentUnitList();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Assign Marks</a></li>
                    <li class="list-group-item"><a href="#" onclick="GetSpecialExamList();" class="btn btn-primary form-control" style="padding: .5rem .5rem">Special Exam Marks</a></li>
                    <li class="list-group-item"><a href="#" onclick="RetportType('EXAMATT');" class="btn btn-primary form-control" style="padding: .5rem .5rem">Exam Attendance</a></li>
                </ol>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Exam entry setup////////////////////////////*@
<div class="modal fade" id="myExamEntryModal" data-toggle="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel">Exam Entry Setup</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodySetup">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Report Type////////////////////////////*@
<div class="modal fade" id="myReportTModal" data-toggle="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel">Report Type</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyReportT">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
