<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    }
                },
                {
                    extend: 'pdf',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    }
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });
    var SelectedRow = function (Sem, Unit, UnitName, Campus, Class,User) {
        var UnitStudentListFilters = {};
        UnitStudentListFilters.Prog = "";
        UnitStudentListFilters.Stage = "";
        UnitStudentListFilters.Sem = Sem;
        UnitStudentListFilters.Unit = Unit;
        UnitStudentListFilters.UnitName = UnitName;
        UnitStudentListFilters.Campus = Campus;
        UnitStudentListFilters.ClassCode = Class;
        UnitStudentListFilters.IsLecAssociate = User;
        //ShowProgress();
        $.ajax({
            url: "/Lecturer/AssignAssignedUnitSessions",
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ StudentUnitFilters: UnitStudentListFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                //HideProgress();
                if (data.success == true) {
                    $("#lblUnit").text(Unit);
                    $("#lblUnitName").text(UnitName);
                    $("#labelLnks").text("Unit Links");
                    $("#myModalLinks").modal("show");
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                Swal.fire('Error', err, 'error');
            }
        });
    }
    var EnterClassAttendance = function () {
        ShowProgress();
        window.location = "/Lecturer/ClassAttendanceList?Section=ME";
    }
    var StudentUnitList = function () {
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/Lecturer/ProgrammeExamSetup",
//            data: JSON.stringify({ Prog: prog, Unit: unit, Sem: Sem, classCode: classCode }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    window.location = "/Lecturer/StudentUnitList";
                }
                else {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('error', err.message, 'error');
            }
        });
    }
    var GetSpecialExamList = function () {
        ShowProgress();
        window.location = "/Lecturer/SpecialExamList";
    }
    var RetportType = function (ReportType) {
        ShowProgress();
        $.ajax({
            url: '/Common/ReportTypeForm',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Rep: ReportType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#modalBodyReportT").html(data);
                HideProgress();
                $("#myModalLinks").modal("hide");
                $("#myReportTModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var PrintUnitReports = function (ReportType) {
        var RType = $("#ddlType").children("option:selected").val().trim();
        ShowProgress();
        $.ajax({
            url: '/Lecturer/GetUnitReports',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ ReportType: ReportType, RType: RType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    $("#myReportTModal").modal("hide");
                    if (RType == "1") {
                        var viewer = $("#modalBody");
                        PDFObject.embed(data.message, viewer);
                        $("#myModalUnits").modal("show");
                    }
                    else {
                        window.location = '/Common/AttachmentDownload?fileName=' + data.message;
                        Swal.fire('Success', 'Document Downloaded successfully', 'success');
                    }
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
                HideProgress();
            }
        });
    }
