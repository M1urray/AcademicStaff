@model IEnumerable<Latest_Staff_Portal.ViewModel.StudentAttendance>
<table id="DataTB" class="table table-bordered nowrap table-hover" style="border-collapse: collapse; font-size:14px; border-spacing: 0; width: 100%;">
    <thead>
        <tr>
            <th>#</th>
            <th>Week</th>
            <th>Attendance</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            if (Model != null)
            {
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @i
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Week)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Attendance)
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="color:red">
                                No Records Found
                            </td>
                        </tr>
                    }
                }
            }
        }
    </tbody>
</table>
