@model Latest_Staff_Portal.ViewModel.CourseEval
@{
    ViewBag.Title = "CourseEvaluationReports";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<div class="card pre-scrollable">
    <div class="card-title">Course Evaluation Reports</div>
    <div class="card-body">
        <hr />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.Label("Semester :", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Code, Model.ListOfSemester, "--select Semester--", new { @class = "form-control", @id = "ddlSemester" })
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <br />
                <input type="button" class="btn btn-primary" value="Get Semester Units" onclick="GetEvalReportReport();" />
            </div>
            <div class="col-md-4">               
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <div id="divSemesterUnits"></div>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">Course Evaluation Report</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody" style="width:100%;height:450px">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">    
    var GetEvalReportReport = function () {
        var Semester = $("#ddlSemester").children("option:selected").val();
        if (Semester == "") {
            Swal.fire('Warning', 'Select Semester', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                url: '/Lecturer/EvaluationRListCourse',
                async: true,
                type: "POST",
                datatype: "json",
                contentType: "application/json; charset = utf-8",
                processData: false,
                data: JSON.stringify({ Semester: Semester }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    $("#divSemesterUnits").html(data);
                    HideProgress();              
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var GetCourseEvaluationReport = function (Unit, Sem, Section, Campus, RType) {
        ShowProgress();
        $.ajax({
            url: '/Lecturer/GetEvaluationReport',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Unit: Unit, Sem: Sem, Section: Section, Campus: Campus, RType: RType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    var viewer = $("#modalBody");
                    PDFObject.embed(data.message, viewer);
                    $("#myModalUnits").modal("show");
                    HideProgress();
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

