@model IEnumerable<Latest_Staff_Portal.ViewModel.CustomerList>
<style>
    .table-hover {
        background-color: lightgray;
    }

    .dt-body-left {
        text-align: left;
    }

    .dt-body-center {
        text-align: center;
    }

    .greenColor {
        background-color: green;
        color: wheat;
    }

    .redColor {
        background-color: red;
        color: white;
    }
</style>
<div class="pre-scrollable">
    <table id="DataTB" class="table table-bordered nowrap table-hover" style="border-collapse: collapse; font-size:14px; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>#</th>
                <th>Student No</th>
                <th>Name</th>
                <th style="text-align:center">Percentage(%)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                if (Model != null)
                {
                    {
                        if (Model.Count() > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @i
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.No)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td align="center">
                                        <span class="badge badge-info" style="font-size: 16px; cursor: pointer" onclick="ViewStudentAttendance('@item.No');">@Html.DisplayFor(modelItem => item.Per_Attendance)</span>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnitsP" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-info">
            <div class="modal-header">
                <h4 class="modal-title">Student Attendance Entries</h4>
                <button type="button" class="close" onclick="$('#myModalUnitsP').modal('hide');" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyP">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect" onclick="$('#myModalUnitsP').modal('hide');">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#DataTB").DataTable({
            lengthChange: !1,
            pageLength: 60
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)");
    });
    var ViewStudentAttendance = function (StdNo) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ StudentNo: StdNo }),
            url: '/lecturer/LoadStudentAttendanceENTRY',
            success: function (data) {
                $("#modalBodyP").html(data);
                HideProgress();
                $("#myModalUnitsP").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>


