@model IEnumerable<Latest_Staff_Portal.ViewModel.LecturerAssignedUnits>
<table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
    <thead>
        <tr>
            <th>Code</th>
            <th>Stage</th>
            <th>Semester</th>
            <th>Unit</th>
            <th>Unit Name</th>
            <th>Campus</th>
            <th>Settlement Type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Code)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Stage)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Semester)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Campus_Code)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Student_Type)
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="DeleteAssignedUnit('@item.Code', '@item.Stage', '@item.Semester', '@item.Unit', '@item.Campus_Code', '@item.LnNo');">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No lecturer Records Found
                            </td>
                        </tr>
                    }
                }
            }
        }
    </tbody>
</table>
