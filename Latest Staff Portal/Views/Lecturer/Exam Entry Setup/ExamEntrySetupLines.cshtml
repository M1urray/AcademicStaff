@model IEnumerable<Latest_Staff_Portal.ViewModel.ExamSetupEntry>
<div class="row" style="font-size: 11px">
    <div class="col-md-12">
        <table class="table table-hover" id="ExamSetUpLines">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Max. Score(%)</th>
                    <th>Weight(%)</th>
                    @*<th>Order</th>*@
                    <th style="text-align:right" width="10%">Action</th>
                </tr>
            </thead>
            <tbody>
            <tbody>
                @{
                    int i = 1;
                    if (Model != null && Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Type)
                                </td>
                                <td>
                                    @Html.TextBoxFor(modelItem => item.MaxScore, new { Style = "text-align:center;width:100px", @class = "form-control textboxWidth" })
                                </td>
                                <td>
                                    @Html.TextBoxFor(modelItem => item.Contr, new { Style = "text-align:center;width:100px", @class = "form-control textboxWidth" })
                                </td>
                                @*<td>
                                    @Html.TextBox("txtOrder", i, new { Style = "text-align:center;width:50px", @class = "form-control textboxWidth" })
                                </td>*@
                                <td>
                                    <button id="btnDelete" class="btn btn-danger btn-sm">Remove</button>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="color:red">
                                No Records Found
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<hr />
<div align="center">
    <input type="button" class="btn btn-warning" value="Update Setup" onclick="UpdateExamEntrySetup();" />
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        <span style="font-weight: bold">Category</span>
        <select class="form-control" id="Category" name="Category" onchange="ToAddMoreEntriess()">
            <option value="0">--Select Category--</option>
            <option value="ASS">Assignments</option>
            <option value="CAT">CAT</option>
            <option value="EXAM">EXAM</option>
        </select>
    </div>
    <div class="col-md-6">
        <div id="divTotalNo">
            <span style="font-weight: bold">Total Number</span>
            <input type="text" class="form-control" id="txtTotal" onkeypress="return functionx(event)" />
        </div>
    </div>
</div>
<hr />
<div align="center">
    <input type="button" class="btn btn-primary waves-effect waves-light" value="Add" onclick="AddSetup();" />
</div>
