@{
    ViewBag.Title = "ClassAttendanceList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";

    string Prog = "", Unit = "", UnitName = "", Sem = "";
    if (Session["Unit"] != null)
    {
        //Prog = Session["Prog"].ToString();
        Unit = Session["Unit"].ToString();
        Sem = Session["Sem"].ToString();
        // UnitName = Session["UnitName"].ToString();
        string Lec = Session["Username"].ToString();
        string classCode = "";// Session["ClassCode"].ToString();
    }
    else
    {
        Url.Action("CourseAllocationUnits", "lecturer");
    }
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .textboxWidth {
        width: 50px;
    }

    .table td {
        padding: 0.1rem;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader2.gif" alt="" />
</div>
<div style="background-color: black;">
    <a href="#" onclick="BackToUnitsAllocation();" style="color:yellow"><<< Back To Units Allocation</a>
</div>
<hr />
<div>
    <b>Unit => @Html.Label(Unit, new { @id = "lblUnit" }) (@Html.Label(UnitName))</b>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <a href="#" onclick="NewAttendance('');" class="btn btn-primary BtnPadding">New Attendance</a>
    </div>
    <div class="col-md-8">
    </div>
</div>
<hr />
<div id="divAttendanceList"></div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModalAttendance" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Lecturer List'
                },
                {
                    extend: 'pdf',
                    title: 'Lecturer List'
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)");

        LoadAttendanceList("");
    });
    var LoadAttendanceList = function (message) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("LoadClassAttendanceList", "lecturer")',
            success: function (data) {
                $("#divAttendanceList").html(data);
                if (message != "") {
                    Swal.fire('Success', message, 'success');
                }
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewAttendance = function (DocNo) {
        //var SettmentType = $("#ddlSettlement").children("option:selected").val();
        if (DocNo != "") {
            $("#labelF").text("Update Attendance Form");
        }
        else {
            $("#labelF").text("New Attendance Form");
        }

        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("LoadClassAtteanceStudents", "lecturer")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalAttendance").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SaveClassAttendance = function (DocNo) {
        var week = $("#ddlWeek").children("option:selected").val();
        //var SettmnT = $("#ddlSettlement").children("option:selected").val();
        var WkLesson = $("#ddlLesson").children("option:selected").val();
        if (week == "") {
            Swal.fire('Warning', "Select Week", 'warning');
            return;
        }
        else if (WkLesson == "") {
            Swal.fire('Warning', "Select Lesson", 'warning');
            return;
        }
        else {
            var myTableArray = [];
            var trs = $('#TbAttendance').dataTable();

            trs.$('tr').each(function () {
                var arrayOfThisRow = [];
                var tableData = $(this).find('td');
                if (tableData.length > 0) {
                    tableData.each(function () {
                        if ($(this).find("input[type=text]").length) {
                            var myText = $(this).find("input[type=text]").val();
                            arrayOfThisRow.push(myText);
                        }
                        else if ($(this).find("select").length) {
                            var myText = $(this).find("select").val();
                            arrayOfThisRow.push(myText);
                        }
                        else arrayOfThisRow.push($(this).text());
                    });

                    myTableArray.push(arrayOfThisRow);
                }
            });
            ShowProgress();
            $.ajax({
                type: "post",
                url: '@Url.Action("SaveClassAttendance", "lecturer")',
                data: { DocNo: DocNo, Wk: week, Lesson: WkLesson, Rows: myTableArray },
                contenttype: "text/plain; charset=utf-8",
                success: function (data) {
                    if (data.success == true) {
                        if (data.failed == false) {
                            HideProgress();
                            LoadAttendanceList(data.message);
                            $("#myModalAttendance").modal("hide");
                        }
                        else {
                            if (data.redirect == true) {
                                window.location = data.message;
                            }
                            else {
                                HideProgress();
                                Swal.fire('Warning', data.message, 'warning');
                            }
                        }
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    if (data.success == false) {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                }
            });
        }
    }
    var BackToUnitsAllocation = function () {
        ShowProgress();
        window.location = '@Url.Action("CourseAllocationUnits", "lecturer")';
    }
    var PostAttendanceList = function (DocNo, wk) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, Wk: wk }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("PostClassAttendance", "lecturer")',
            success: function (data) {
                if (data.success) {
                    HideProgress();
                    LoadAttendanceList(data.message);
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var RemoveAttendance = function (DocNo) {
        Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this attandance!",
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Delete!'
            }).then((result) => {
                if (result.value) {
                    ShowProgress();
                    $.ajax({
                        async: true,
                        type: "POST",
                        datatype: "json",
                        data: JSON.stringify({ DocNo: DocNo }),
                        contentType: "application/json; charset = utf-8",
                        processData: false,
                        url: '@Url.Action("DeleteAttendance", "lecturer")',
                        success: function (data) {
                            if (data.success == true) {
                                HideProgress();
                                LoadAttendanceList(data.message);
                            }
                            else {
                                HideProgress();
                                Swal.fire('Warning', data.message, 'warning');
                            }
                        },
                        error: function (err) {
                            HideProgress();
                            Swal.fire('Warning', err, 'warning');
                        }
                    });
                }
                else {
                    Swal.fire('Cancelled', 'Action Reverted', 'error');
                }
            });
    }
</script>

