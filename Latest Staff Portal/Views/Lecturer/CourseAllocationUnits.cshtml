@model IEnumerable<Latest_Staff_Portal.ViewModel.LecturerAssignedUnits>
@{
    ViewBag.Title = "CourseAllocationUnits";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<a href="#" onclick="StudentUnitList();" class="btn btn-primary BtnPadding disabled">Assign Marks</a>
<a href="#" onclick="EnterClassAttendance();" class="btn btn-primary BtnPadding disabled">Class Attendance</a></a>
<a href="#" onclick="PrintUnitReports('CLATT');" class="btn btn-danger BtnPadding disabled">Print Class List</a>
<a href="#" onclick="PrintUnitReports('EXAMATT');" class="btn btn-primary BtnPadding disabled">Print Exam Attendance</a>

<hr />
<table id="datatable-buttons" class="table table-bordered nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%; font-size:12px">
    <thead>
        <tr>
            <th>Action</th>
            <th>Code</th>
            <th>Stage</th>
            <th>Semester</th>
            <th>Unit</th>
            <th>Unit Name</th>
            <th>Campus</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a href="#" onclick="SelectedRow('@item.Code');">Select</a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Code)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Stage)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Semester)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Campus_Code)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="color:red">
                                No lecturer Records Found
                            </td>
                        </tr>
                    }
                }
            }
        }
    </tbody>
</table>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody" style="width:100%;height:450px">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    }
                },
                {
                    extend: 'pdf',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6, 7]
                    }
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            ShowProgress();
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            $(".BtnPadding").removeClass("disabled");
            AssignSessions();
            HideProgress();
        });
    }
    var AssignSessions = function () {
        var row = $('#datatable-buttons tr.selectedTableRow');
        var Prog = row.find("td").eq(1).html();
        var Stage = row.find("td").eq(2).html();
        var Sem = row.find("td").eq(3).html();
        var Unit = row.find("td").eq(4).html();
        var UnitName = row.find("td").eq(5).html();
        var Campus = row.find("td").eq(6).html();

        var UnitStudentListFilters = {};
        UnitStudentListFilters.Prog = Prog;
        UnitStudentListFilters.Stage = Stage;
        UnitStudentListFilters.Sem = Sem;
        UnitStudentListFilters.Unit = Unit;
        UnitStudentListFilters.UnitName = UnitName;
        UnitStudentListFilters.Campus = Campus;
        $.ajax({
            url: '@Url.Action("AssignAssignedUnitSessions", "Lecturer")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ StudentUnitFilters: UnitStudentListFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {

                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                Swal.fire('Error', err, 'error');

            }
        });
    }
    //var AssignMarks = function () {
    //    ShowProgress();
    //    window.location = "/Lecturer/StudentUnitList?Prog=" + Prog + "&Descr=" + Descr + "";
    //}
    var EnterClassAttendance = function () {
        ShowProgress();
        window.location ='@Url.Action("ClassAttendanceList", "lecturer")';
    }
    var StudentUnitList = function () {
        var row = $('#datatable-buttons tr.selectedTableRow');
        var prog = row.find("td").eq(1).html().trim();
        var unit = row.find("td").eq(4).html().trim();
        debugger
        ShowProgress();
        $.ajax({
            type: "POST",
            url: '@Url.Action("ProgrammeExamSetup", "Lecturer")',
            data: JSON.stringify({ Prog: prog, Unit: unit }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    window.location = '@Url.Action("StudentUnitList", "Lecturer")';
                }
                else {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('error', err.message, 'error');
            }
        });
    }
    var PrintUnitReports = function (ReportType) {
        var row = $('#datatable-buttons tr.selectedTableRow');
        var Unit = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            url: '@Url.Action("GetUnitReports", "Lecturer")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ ReportType: ReportType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    var viewer = $("#modalBody");
                    PDFObject.embed(data.message, viewer);
                    $("#myModalUnits").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
                HideProgress();
            }
        });
    }
</script>
