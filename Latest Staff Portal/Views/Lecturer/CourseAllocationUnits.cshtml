    var AssignMarks = function () {
        ShowProgress();
        window.location = '@Url.Action("StudentUnitList", "lecturer")?Prog=' + Prog + '&Descr=' + Descr;
    }
    var StudentUnitList = function () {
        ShowProgress();
        window.location = '@Url.Action("StudentUnitList", "lecturer")';
    }
    var EnterClassAttendance = function () {
        ShowProgress();
        window.location ='@Url.Action("ClassAttendanceList", "lecturer")';
    }
    var PrintUnitReports = function (ReportType) {
        ShowProgress();
        $.ajax({
            url: '@Url.Action("GetUnitReports", "lecturer")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ ReportType: ReportType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    var viewer = $("#modalBody");
                    PDFObject.embed(data.message, viewer);
                    $("#myModalUnits").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
                HideProgress();
            }
        });
    }
</script>
