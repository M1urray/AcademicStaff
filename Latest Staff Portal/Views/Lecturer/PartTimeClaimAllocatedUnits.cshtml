@model IEnumerable<Latest_Staff_Portal.ViewModel.LecturerAssignedUnits>
<table id="dtClaimUnits" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
    <thead>
        <tr>
            <th>Code</th>
            <th>Stage</th>
            <th>Unit</th>
            <th>Unit Name</th>
            <th>Campus</th>
            <th>GSSP<br /> Students</th>
            <th>PSSP<br /> Students</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Code)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Stage)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Campus_Code)
                                </td>
                                <td align="center">
                                    <input type="text" class="form-control" style="text-align:center;width:60px" onkeypress="return functionx(event)" />
                                </td>
                                <td align="center">
                                    <input type="text" class="form-control" style="text-align:center;width:60px" onkeypress="return functionx(event)" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="color:red">
                                No lecturer Records Found
                            </td>
                        </tr>
                    }
                }
            }
        }
    </tbody>
</table>
<script type="text/javascript">
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>