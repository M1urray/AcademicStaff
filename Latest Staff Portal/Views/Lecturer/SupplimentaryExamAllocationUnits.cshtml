@model IEnumerable<Latest_Staff_Portal.ViewModel.LecturerAssignedUnits>
@{
    ViewBag.Title = "SupplimentaryExamAllocationUnits";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">Supplimentary Exam Allocations</div>
    <div class="card-body">
        <table id="datatable-buttons" class="table table-hover nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%; font-size:12px">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Unit</th>
                    <th>Unit Name</th>
                    <th>Semester</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null)
                    {
                        {
                            if (Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <button onclick="SelectedRow('@item.Semester', '@item.Unit', '@item.Unit_Name');" class="btn btn-sm btn-danger">Select</button>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" style="color:red">
                                        No lecturer Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" data-toggle="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody" style="width:100%;height:450px">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3]
                    }
                },
                {
                    extend: 'pdf',
                    title: 'Allocated Unit List',
                    exportOptions: {
                        columns: [1, 2, 3]
                    }
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });
    var SelectedRow = function (Sem, Unit, UnitName) {
        var UnitStudentListFilters = {};
        UnitStudentListFilters.Prog = "";
        UnitStudentListFilters.Stage = "";
        UnitStudentListFilters.Sem = Sem;
        UnitStudentListFilters.Unit = Unit;
        UnitStudentListFilters.UnitName = UnitName;
        UnitStudentListFilters.Campus = "";
        UnitStudentListFilters.ClassCode = "";
        ShowProgress();
        $.ajax({
            url: "/Lecturer/AssignAssignedUnitSessions",
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ StudentUnitFilters: UnitStudentListFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {                
                if (data.success == true) {
                    window.location = "/Lecturer/SupplimentaryExamList";
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Error', err, 'error');
            }
        });
    }
</script>

