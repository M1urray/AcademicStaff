@model Latest_Staff_Portal.ViewModel.DropdownListData
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="title"><b>Standing Imprest Reimbursement Header</b></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    @Html.Label("Standing Imprest Document", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Code, Model.ListOfddlData, "--select Standing Imprest--", new { @class = "form-control", @id = "ddlDoc" })
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    @Html.Label("Remarks", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <textarea id="txtRemarks" class="form-control"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Create Document" onclick="SubmitImprestRequisition();" />
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlDoc").select2({
            width: '100%'
        });
    });
</script>



