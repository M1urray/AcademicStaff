@model Latest_Staff_Portal.ViewModel.CafItemDetails
<style>
    .ui-front {
        z-index: 2000 !important;
    }
</style>
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-6">
            Menu Item
            @Html.DropDownListFor(m => m.ItemDetails.Item, new SelectList(Model.ListOfMenuItems, "Value", "Text", Model.ItemDetails.Item), "--Select Menu Item--", new { @id = "ddlMenuItem", @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
        </div>
        <div class="col-md-6">
            Quantity
            <input type="text" class="form-control" id="txtQuantity" onkeypress="return functionDecimal(event,this.value)" />
        </div>
    </div>
    <hr />
    <div align="center">
        <input type="button" class="btn btn-primary waves-effect waves-light" value="Update Item" onclick="UpdateLineItem('@Model.ItemDetails.No', '@Model.ItemDetails.Item', '@Model.ItemDetails.LnNo');" />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlMenuItem").select2({
            width: '100%'
        });
        $('#txtQuantity').val(`@Model.ItemDetails.Quantity`);
        document.getElementById("ddlMenuItem").disabled = true;
    });
    function functionDecimal(evt, val) {
        try {
            var charCode = (evt.which) ? evt.which : event.keyCode;

            if (charCode == 46) {
                if (!(val.indexOf(".") > -1)) {
                    return true;
                }
                else {
                    Swal.fire('Warning', 'Kindly ensure to specify decimals only', 'warning');
                }
            }
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                Swal.fire('Warning', 'Kindly ensure to specify decimals only', 'warning');
                return false;
            }
            return true;
        } catch (w) {
            Swal.fire(w);
        }
    }
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>


