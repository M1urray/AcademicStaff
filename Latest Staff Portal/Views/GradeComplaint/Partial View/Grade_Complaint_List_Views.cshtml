@model IEnumerable<Latest_Staff_Portal.ViewModel.Grade_Compaint>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <table id="tech-companies-1" class="table table-striped table-hover" style="font-size:12px">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th width="10%">
                            Doc No.
                        </th>
                        <th width="10%">
                            Student No.
                        </th>
                        <th width="30%">
                            Student Name
                        </th>
                        <th width="10%">
                            Unit
                        </th>
                        <th width="30%">
                            Description
                        </th>
                        <th width="20%">
                            Semester
                        </th>
                        <th width="20%">
                            Current Grade
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model != null)
                        {
                            if (Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <input type="button" onclick="SelectedRow('@item.Doc_No','@item.Status');" class="btn btn-sm btn-danger" value="Select" />
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Doc_No)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Student_No)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Student_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Current_Grade)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" style="color:red">
                                        No Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

