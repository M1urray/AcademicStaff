
@{
    ViewBag.Title = "NewVisitorsList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }

    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">New Visitor List</div>
    <hr />
    <div class="card-body">
        <a href="#" onclick="NewVisitorForm();" class="btn btn-primary BtnPadding">New Visitor</a>
        <hr />
        <div id="divVisitorList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">New Visitors Form</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadVisitorsList();
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        var Errormsg = '@Request.RequestContext.HttpContext.Session["ErrorMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success', true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
        if (Errormsg != "") {
            Swal.fire('Warning', Errormsg, 'warning', true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
    });
    var LoadVisitorsList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ Status: "Arrived" }),
            url: "/Visitors/VisitorsListPartialView",
            success: function (data) {
                $("#divVisitorList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewVisitorForm = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Visitors/NewVisitorRequest',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var ViewDoc = function (DocNo) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Visitors/NewVisitDocumentView',
            data: JSON.stringify({ DocNo: DocNo }),
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var CreateVisit = function (DocNo) {
        var Category = $("#ddlcaterory").children("option:selected").val();
        var personToSee = $("#ddlPersontoSee").children("option:selected").val();
        var Department = $("#ddlDepartment").children("option:selected").val();
        var VisitorName = $("#txtVisistorName").val().replace(/(\r\n|\n|\r)/gm, " ");
        var IDNo = $("#txtIDNo").val().replace(/(\r\n|\n|\r)/gm, " ");
        var PhoneNo = $("#txtPhoneNo").val().replace(/(\r\n|\n|\r)/gm, " ");
        var CarNo = $("#txtCarRegNo").val().replace(/(\r\n|\n|\r)/gm, " ");
        var PassNo = $("#txtPassNo").val().replace(/(\r\n|\n|\r)/gm, " ");
        var Purpose = $("#txtPurpose").val().replace(/(\r\n|\n|\r)/gm, " ");

        if (Category == "") {
            Swal.fire('Warning', "Select Visit Category", 'warning');
            return;
        }
        else if (personToSee == "") {
            Swal.fire('Warning', "Select Person to see", 'warning');
            return;
        }
        else if (Department == "") {
            Swal.fire('Warning', "Select Department", 'warning');
            return;
        }
        else if (Department == "") {
            Swal.fire('Warning', "Select Department", 'warning');
            return;
        }
        else if (VisitorName == "") {
            Swal.fire('Warning', "Enter Visitor Name", 'warning');
            return;
        }
        else if (IDNo == "") {
            Swal.fire('Warning', "Enter ID Number", 'warning');
            return;
        }
        else if (PhoneNo == "") {
            Swal.fire('Warning', "Enter Phone Number", 'warning');
            return;
        }
        else if (PassNo == "") {
            Swal.fire('Warning', "Enter Pass Number", 'warning');
            return;
        }
        else if (Purpose.length > 150) {
            Swal.fire('Warning', "Your Reason should have a maximum of 150 characters", 'warning');
            return;
        }
        else {
            var Visitors = {};
            Visitors.No = DocNo;
            Visitors.visitorCat = Category;
            Visitors.VisitorName = VisitorName;
            Visitors.Department = Department;
            Visitors.IDNumber = IDNo;
            Visitors.PhoneNumber = PhoneNo;
            Visitors.CarRegNumber = CarNo;
            Visitors.PersonToSee = personToSee;
            Visitors.VisitorPassNo = PassNo;
            Visitors.PurposeofVisit = Purpose;

            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/Visitors/SubmitVisitorData",
                data: JSON.stringify({ VData: Visitors }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        LoadVisitorsList();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }

                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    };
    var AdmitVisitor = function (DocNo) {
        $.ajaxSetup({ cache: false });
        Swal.fire({
            title: 'Are you sure?',
            text: "You want to admit this visitor!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Admit!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    type: "POST",
                    url: "/Visitors/AdmiVisitor",
                    data: JSON.stringify({ DocNo: DocNo }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.success) {
                            HideProgress();
                            LoadVisitorsList();
                            $("#myModal").modal("hide");
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }

                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Admission cancelled. Visitor not admitted', 'error');
            }
        });
    };
</script>

