
@{
    ViewBag.Title = "GatePassList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">New Visitor List</div>
    <hr />
    <div class="card-body">
        <a href="#" onclick="NewPurchaseRequisition();" class="btn btn-primary BtnPadding">New Gate Pass</a>
        <a href="#" onclick="ViewDoc();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Gate Pass Document</a>
        <hr />
        <div id="divVisitorList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">New Gate Pass Form</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
    LoadPurchaseReqList();
    var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
    var Errormsg = '@Request.RequestContext.HttpContext.Session["ErrorMsg"]';
    if (Successmsg != "") {
        Swal.fire('Success', Successmsg, 'success', true);
        $.ajax({
            type: "POST",
            url: "/Common/NullibySessions"
        });
    }
    if (Errormsg != "") {
        Swal.fire('Warning', Errormsg, 'warning', true);
        $.ajax({
            type: "POST",
            url: "/Common/NullibySessions"
        });
    }
    });
    var LoadPurchaseReqList = function () {
    ShowProgress();
    $.ajax({
        async: true,
        type: "GET",
        dataType: 'HTML',
        contentType: false,
        processData: false,
        url: "/Purchase/PurchaseRequisitionListPartialView",
        success: function (data) {
            $("#divPurchaseRegList").html(data);
            HideProgress();
        },
        error: function () {
            HideProgress();
            alert("There is some problem to process your request. Please try after some time");
        }
    });
    }
    var NewPurchaseRequisition = function () {
    ShowProgress();
    window.location = "/Purchase/NewPurchaseRequest";
    }
    var SelectedRow = function () {
    $('table tbody tr').click(function () {
        $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var Status = row.find("td").eq(4).html().trim();
        $("#ViewDoc").removeClass("disabled");
        if (Status == "Open") {
            $("#SendDocAppr").removeClass("disabled");
            $("#CancelDocAppr").addClass("disabled");
            $("#AppTrail").addClass("disabled");
        }
        else if (Status == "Pending Approval") {
            $("#SendDocAppr").addClass("disabled");
            $("#CancelDocAppr").removeClass("disabled");
            $("#AppTrail").removeClass("disabled");
        }
        else if (Status == "Approved") {
            $("#SendDocAppr").addClass("disabled");
            $("#CancelDocAppr").addClass("disabled");
            $("#AppTrail").addClass("disabled");
        }
        else {
            $("#SendDocAppr").addClass("disabled");
            $("#CancelDocAppr").addClass("disabled");
            $("#AppTrail").addClass("disabled");
        }
    });
    }
    var ViewDoc = function () {
    $("#labelF").text("Purchase Details Document");
    ShowProgress();
    var row = $('#datatable-buttons tr.selectedTableRow');
    var DocNo = row.find("td").eq(1).html().trim();
    window.location = "/Purchase/PurchaseDocumentView?DocNo=" + DocNo;
    }
    var SendDocForApproval = function () {
    $("#labelF").text("Purchase Details Document");
    var row = $('#datatable-buttons tr.selectedTableRow');
    var DocNo = row.find("td").eq(1).html().trim();
    ShowProgress();
    $.ajax({
        async: true,
        type: "POST",
        datatype: "json",
        data: JSON.stringify({ DocNo: DocNo }),
        contentType: "application/json; charset = utf-8",
        processData: false,
        url: '/Purchase/SendPurchaseAppForApproval',
        success: function (data) {
            HideProgress();
            LoadPurchaseReqList();
            if (data.success == true) {
                DiableButtons();
                HideProgress();
                Swal.fire('Success', data.message, 'success');
            }
            else {
                DiableButtons();
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        },
        error: function (err) {
            HideProgress();
            Swal.fire('Warning', err, 'warning');
        }
    });
    }
    var CancelDocForApproval = function () {
    $("#labelF").text("Purchase Details Document");
    var row = $('#datatable-buttons tr.selectedTableRow');
    var DocNo = row.find("td").eq(1).html().trim();
    ShowProgress();
    $.ajax({
        async: true,
        type: "POST",
        datatype: "json",
        data: JSON.stringify({ DocNo: DocNo }),
        contentType: "application/json; charset = utf-8",
        processData: false,
        url: '/Purchase/CancelPurchaseAppForApproval',
        success: function (data) {
            HideProgress();
            LoadPurchaseReqList();
            if (data.success == true) {
                DiableButtons();
                Swal.fire('Success', data.message, 'success');
            }
            else {
                DiableButtons();
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        },
        error: function (err) {
            HideProgress();
            Swal.fire('Warning', err, 'warning');
        }
    });

    }
    var ViewApprovalTrail = function () {
    $("#labelF").text("Document Approval Trail");
    ShowProgress();
    var row = $('#datatable-buttons tr.selectedTableRow');
    var DocNo = row.find("td").eq(1).html().trim();
    $.ajax({
        async: true,
        type: "POST",
        datatype: "json",
        data: JSON.stringify({ DocNo: DocNo }),
        contentType: "application/json; charset = utf-8",
        processData: false,
        url: '/Common/DocumentApprovalTrail',
        success: function (data) {
            $("#modalBody").html(data);
            HideProgress();
            $("#myModal").modal("show");
        },
        error: function (err) {
            HideProgress();
            Swal.fire('Warning', err, 'warning');
        }
    });
    }
    var DiableButtons = function () {
    $("#ViewDoc").addClass("disabled");
    $("#SendDocAppr").addClass("disabled");
    $("#CancelDocAppr").addClass("disabled");
    $("#AppTrail").addClass("disabled");
    $('table tbody tr').siblings().removeClass("selectedTableRow");
}
</script>

