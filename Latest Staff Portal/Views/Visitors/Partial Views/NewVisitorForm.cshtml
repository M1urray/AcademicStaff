@model Latest_Staff_Portal.ViewModel.NewVisiorForm
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-6">
            <span style="font-weight: bold">Visitor Category</span>
            @if (ViewBag.VisitorTypeList != null && ViewBag.VisitorTypeList.Count > 0)
            {
                @Html.DropDownListFor(m => m.VisitDoc.visitorCat, new SelectList(ViewBag.VisitorTypeList, "Value", "Text", Model.VisitDoc.visitorCat), "--Select Visitor Type--", new { @id = "ddlcaterory", @class = "form-control" })
            }
        </div>
        <div class="col-md-6">
            Visitor Name
            @Html.TextBoxFor(m => m.VisitDoc.VisitorName, new { @id = "txtVisistorName", @class = "form-control" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            ID Number
            @Html.TextBoxFor(m => m.VisitDoc.IDNumber, new { @id = "txtIDNo", @class = "form-control" })
        </div>
        <div class="col-md-6">
            Phone Number
            @Html.TextBoxFor(m => m.VisitDoc.PhoneNumber, new { @id = "txtPhoneNo", @class = "form-control" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            Person To See
            @Html.DropDownListFor(m => m.VisitDoc.PersonToSee, new SelectList(Model.ListOfEmployee, "Value", "Text", Model.VisitDoc.PersonToSee), "--Select Person to see--", new { @id = "ddlPersontoSee", @class = "form-control" })
        </div>
        <div class="col-md-6">
            Department
            @Html.DropDownListFor(m => m.VisitDoc.Department, new SelectList(Model.ListOfDepartment, "Value", "Text", Model.VisitDoc.Department), "--Select Department--", new { @id = "ddlDepartment", @class = "form-control" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            Visitor Car Reg. No.
            @Html.TextBoxFor(m => m.VisitDoc.CarRegNumber, new { @id = "txtCarRegNo", @class = "form-control" })
        </div>
        <div class="col-md-6">
            Visitor Pass No
            @Html.TextBoxFor(m => m.VisitDoc.VisitorPassNo, new { @id = "txtPassNo", @class = "form-control" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            Purpose of the Visit
            @Html.TextAreaFor(m => m.VisitDoc.PurposeofVisit, new { @id = "txtPurpose", @class = "form-control" })
        </div>
    </div>
    <hr />
    <div align="center">
        @if (Model.VisitDoc.No != null && Model.VisitDoc.No != "")
        {
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Update Visit" onclick="CreateVisit('@Model.VisitDoc.No');" />
        }
        else
        {
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Create Visit" onclick="CreateVisit('');" />
        }
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlPersontoSee,#ddlDepartment").select2({
            width: '100%',
            placeholder: 'Search...'
        });
    });
</script>


