@model  Latest_Staff_Portal.ViewModel.VisitDetailList
<div class="table-responsive">
    <table class="table table-centered table-nowrap" id="PassengerLines">
        <thead>
            <tr>
                <th>#</th>
                <th style="text-align:center">Actions</th>
                <th>No</th>
                <th>visitor Name</th>
                <th>Purpose</th>
                <th>ID Number</th>
                <th>Phone Number</th>
                <th>Person To See</th>
                <th>Pass No</th>
                <th>Car Reg. No</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.VisitDetails != null && Model.VisitDetails.Count() > 0)
                {
                    int i = 1;
                    foreach (var item in Model.VisitDetails)
                    {
                        <tr>
                            <td>
                                @i
                            </td>
                            <td>
                                @if (Model.Status == "Arrived")
                                {
                                    <button class="btn btn-danger BtnPadding" onclick="AdmitVisitor('@item.No')">Admit</button>
                                }
                                @if (Model.Status == "")
                                {
                                    <button class="btn btn-danger BtnPadding" onclick="ClearVisitor('@item.No')">Clear visitor</button>
                                }
                                <button class="btn btn-primary BtnPadding" onclick="ViewDoc('@item.No')">View Visitor Details</button>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.No)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.VisitorName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PurposeofVisit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IDNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PhoneNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PersonToSee)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.VisitorPassNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CarRegNumber)
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>



