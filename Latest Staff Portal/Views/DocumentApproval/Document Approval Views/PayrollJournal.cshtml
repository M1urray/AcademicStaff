@model IEnumerable<Latest_Staff_Portal.ViewModel.PayrollJournal>
<hr />
<div class="row">
    <div class="col-md-6">
        <b>Reports</b>
        <select class="form-control" id="ddlReportType">
            <option value="">----</option>
            <option value="1">Payroll Summery</option>
            <option value="2">Payment and Deduction Report</option>
            <option value="3">Earnings Deduction Report</option>
        </select>
    </div>
    <div class="col-md-6">
        <br />
        <button class="btn btn-danger BtnPadding" onclick="GePayrollReport();">View Report</button>
    </div>
</div>
<hr style="border:1px solid black" />
<b>Payroll Journal Lines</b>
<hr />
<div class="pre-scrollable">
    <table class="table table-hover" id="PRVLines">
        <thead>
            <tr>
                <th>Posting Date</th>
                <th>Document No</th>
                <th>Account No</th>
                <th>Account Name</th>
                <th>Description</th>
                <th style="text-align:center">Amount</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Posting_Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DocNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.Amount)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

