@model Latest_Staff_Portal.ViewModel.LecAssignUnit
<style>
    .ui-front {
        z-index: 2000 !important;
    }
</style>
<div class="bg-soft-dark" style="color:black">
        <div class="col-md-12">
            Lecturer
            @Html.DropDownListFor(model => model.Code, Model.ListOfLec, "--select Lecturer--", new { @class = "form-control", @id = "ddlLecturer" })
        </div>
    <hr />
    <div align="center">
        <input type="button" class="btn btn-primary waves-effect waves-light" value="Assign Lecture" onclick="SubmitAssignLec('@Model.DocNo', '@Model.Unit', '@Model.Semester', '@Model.Ln');" />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlLecturer").select2({
            width: '100%'
        });
    });
</script>
