@model Latest_Staff_Portal.ViewModel.GraduationReq
<div class="row">
    <div class="col-md-6">
        <b>Document No</b>
        @Html.TextBoxFor(m => m.Code, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Date Requested</b>
        @Html.TextBoxFor(m => m.Date_Requested, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <b>Student No</b>
        @Html.TextBoxFor(m => m.Student_No, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Student Name</b>
        @Html.TextBoxFor(m => m.Names, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <b>Graduating Programme</b>
        @Html.TextBoxFor(m => m.ProgrammeName, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Telephone</b>
        @Html.TextBoxFor(m => m.Telephone, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <b>Current Phone No</b>
        @Html.TextBoxFor(m => m.Current_Phone_No, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Email</b>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <b>Personal Email</b>
        @Html.TextBoxFor(m => m.PersonalEmail, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>Current Profession</b>
        @Html.TextBoxFor(m => m.Currentprofession, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <b>Current Company</b>
        @Html.TextBoxFor(m => m.CurrentInstitustionCompany, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="col-md-6">
        <b>ID Number</b>
        @Html.TextBoxFor(m => m.IDNumber, new { @class = "form-control", @readonly = "readonly" })
    </div>
</div>
<hr />
<div align="center">
    <input type="button" class="btn btn-primary waves-effect waves-light" value="View Audit" onclick="ViewAudit(`@Model.Student_No`, `@Model.Programme`);" />
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="divReport" tabindex="-1" role="dialog" ke aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">Audit Report</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
                <iframe id="iframe" style="width:100%;height:600px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var ViewAudit = function (StdNo,Prog) {
        ShowProgress();
        $.ajax({
            url: '/DocumentApproval/GenerateStudentAudit',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ StudentNo: StdNo, Prog: Prog }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    window.location = '/Common/AttachmentDownload?fileName=' + data.message;
                    Swal.fire('Success', 'Document Downloaded successfully', 'success');
                    HideProgress();
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

