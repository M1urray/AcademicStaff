@model IEnumerable<Latest_Staff_Portal.ViewModel.DocumentsForApproval>
<table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
    <thead style="background-color:black;color:white">
        <tr>
            <th>Action</th>
            <th>Doc No.</th>
            <th>Sender</th>
            <th>Date Sent for Approval</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null && Model.Count() > 0)
            {
                foreach (var item in Model)
                {
                    if (item.CommentFound)
                    {
                        <tr style="background-color:red">
                            <td><a href="#" onclick="ViewDoc('@item.TabelID','@item.Document_No','@item.Sequence','@item.Entry_No');">View Document</a></td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Document_No)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Sender_Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DateSend)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td><a href="#" onclick="ViewDoc('@item.TabelID','@item.Document_No','@item.Sequence','@item.Entry_No');">View Document</a></td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Document_No)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Sender_Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DateSend)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="color:red">
                        No Records Found!
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Pending Approval Documents',
                    exportOptions: {
                        columns: [1, 2, 3, 4]
                    }
                },
                {
                    extend: 'pdf',
                    title: 'Pending Approval Documents',
                    exportOptions: {
                        columns: [1, 2, 3, 4]
                    }
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });
</script>
