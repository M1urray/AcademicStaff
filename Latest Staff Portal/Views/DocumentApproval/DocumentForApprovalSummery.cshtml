@model Latest_Staff_Portal.ViewModel.DocumentCount
@{
    ViewBag.Title = "DocumentForApprovalSummery";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
    bool hasNoPending = false;
}
<div class="card pre-scrollable">
    <div class="card-title">@Model.Status Documents Approval List</div>
    <hr />
    <div class="card-body">
        @if (Model != null)
        {
        <ol class="list-group">
            @if (Model.LeaveCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70134864','Leave Requisition','@Model.Status','N');">Leave Approval Requests (<span class="badge badge-info badge-pill">@Model.LeaveCount</span>)</a></li>
            }
            @if (Model.PRNCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('38','Purchase Requisition','@Model.Status','Quote');">Purchase Approval Requests (<span class="badge badge-info badge-pill">@Model.PRNCount</span>)</a></li>
            }
            @if (Model.LPOCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('38','LPO Requisition','@Model.Status','Order');">LPO/LSO Approval Requests (<span class="badge badge-info badge-pill">@Model.LPOCount</span>)</a></li>
            }
            @if (Model.SRNCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70134954','Store Requisition','@Model.Status','N');">Stores Approval Requests (<span class="badge badge-info badge-pill">@Model.SRNCount</span>)</a></li>
            }
            @if (Model.ImpCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135176','Imprest Requisition','@Model.Status','N');">Imprests Approval Requests (<span class="badge badge-info badge-pill">@Model.ImpCount</span>)</a></li>
            }
            @if (Model.SurrCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135168','Imprest Surrender Requisition','@Model.Status','N');">Imprests Surrender Approval Requests (<span class="badge badge-info badge-pill">@Model.SurrCount</span>)</a></li>
            }
            @if (Model.ClaimCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135169','Staff Claim Requisition','@Model.Status','N');">Staff Claim Approvals (<span class="badge badge-info badge-pill">@Model.ClaimCount</span>)</a></li>
            }
            @if (Model.Transport > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135138','Transport Requisition','@Model.Status','N');">Transport Approval Requests (<span class="badge badge-info badge-pill">@Model.Transport</span>)</a></li>
            }
            @if (Model.Training > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135040','Training Requisition','@Model.Status','N');">Training Approval Requests (<span class="badge badge-info badge-pill">@Model.Training</span>)</a></li>
            }
            @if (Model.TransferOrder > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('5740','Transfer Order Requisition','@Model.Status','N');">Transfer Order Approval Requests (<span class="badge badge-info badge-pill">@Model.TransferOrder</span>)</a></li>
            }
            @if (Model.PVCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135171','Payment Voucher Requisition','@Model.Status','N');">Payment Voucher Approvals (<span class="badge badge-info badge-pill">@Model.PVCount</span>)</a></li>
            }
            @if (Model.PayrollCount > 0)
            {
                hasNoPending = true;
                <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('232','Payroll Journal','@Model.Status','N');">Payroll Journal Approval Requests(<span class="badge badge-info badge-pill">@Model.PayrollCount</span>)</a></li>
            }
        </ol>
        }
        @if (!hasNoPending)
        {
            <p style="color:red">No Records Found!</p>
        }

    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    var GetDocumentApprovalList = function (TbleID, Title, Status, DocType) {
        window.location = "/DocumentApproval/GetDocumentForApprovalList?TbID=" + TbleID + "&Status=" + Status + "&Title=" + Title + "&DocType=" + DocType + "";
    }
</script>



