@model Latest_Staff_Portal.ViewModel.DocumentApprovalCount
@{
    ViewBag.Title = "DocumentForApprovalSummery";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
    bool hasNoPending = false;
}
<div class="card pre-scrollable" style="border: 2px solid #00aeee">
    <div class="card-title">@Model.StdCount.Status Student Requisition Approval List</div>
    <hr />
    <div class="card-body">
        @if (Model.StdCount != null)
        {
            hasNoPending = false;
            <ol class="list-group">           
                @if (Model.StdCount.ClearanceCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135455', 'Student Clearance Requests', '@Model.StdCount.Status', 'Clearance');">Student Clearance Requests (<span class="badge badge-info badge-pill">@Model.StdCount.ClearanceCount</span>)</a></li>
                }
            </ol>
        }
        @if (!hasNoPending)
        {
            <p style="color:red">You have no student requisitions awaiting your approval</p>
        }
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    var GetDocumentApprovalList = function (TbleID, Title, Status, DocType) {
        window.location = "/DocumentApproval/GetDocumentForApprovalList?TbID=" + TbleID + "&Status=" + Status + "&Title=" + Title + "&DocType=" + DocType + "";
    }
</script>



