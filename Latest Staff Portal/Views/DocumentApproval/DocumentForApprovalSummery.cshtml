@model Latest_Staff_Portal.ViewModel.DocumentCount
@{
    ViewBag.Title = "DocumentForApprovalSummery";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
    bool hasNoPending = false;
}
<div class="card pre-scrollable">
    <div class="card-title">@Model.Status Documents Approval List</div>
    <hr />
    <div class="card-body">
        @if (Model != null)
        {
            <ol class="list-group">
                @if (Model.LeaveCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135114','Leave Requisition','@Model.Status');">Leave Applications (<span class="badge badge-info badge-pill">@Model.LeaveCount</span>)</a></li>
                }
                @if (Model.PRNCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('38','Purchase Requisition','@Model.Status');">Purchase Requisitions (<span class="badge badge-info badge-pill">@Model.PRNCount</span>)</a></li>
                }
                @if (Model.SRNCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135010','Store Requisition','@Model.Status');">Store Requisitions (<span class="badge badge-info badge-pill">@Model.SRNCount</span>)</a></li>
                }
                @if (Model.ImpCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135469','Imprest Requisition','@Model.Status');">Imprest Requisitions (<span class="badge badge-info badge-pill">@Model.ImpCount</span>)</a></li>
                }
                @if (Model.SurrCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135450','Imprest Surrender Requisition','@Model.Status');">Imprest Surrender Requisitions (<span class="badge badge-info badge-pill">@Model.SurrCount</span>)</a></li>
                }
                @if (Model.ClaimCount > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70135454','Staff Claim Requisition','@Model.Status');">Staff Claim Requisitions (<span class="badge badge-info badge-pill">@Model.ClaimCount</span>)</a></li>
                }
                @if (Model.Clearance > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('70134894','Student Clearance Requisition','@Model.Status');">Student Clearance Requests (<span class="badge badge-info badge-pill">@Model.Clearance</span>)</a></li>
                }
                @if (Model.TransferOrder > 0)
                {
                    hasNoPending = true;
                    <li class="list-group-item"><a href="#" onclick="GetDocumentApprovalList('5740','Transfer Order Requisition','@Model.Status');">Transfer Order Requests (<span class="badge badge-info badge-pill">@Model.TransferOrder</span>)</a></li>
                }
            </ol>
        }
        @if (!hasNoPending)
        {
            <p style="color:red">You have no requisitions awaiting your approval</p>
        }

    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    var GetDocumentApprovalList = function (TbleID, Title, Status) {
        window.location = '@Url.Action("GetDocumentForApprovalList", "DocumentApproval")?TbID=' + TbleID + '&Status=' + Status + '&Title=' + Title;
    }
</script>



