@model Latest_Staff_Portal.ViewModel.ImprestTypesList
<style>
    .ui-front {
        z-index: 2000 !important;
    }
</style>
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-6">
            Type
            @Html.DropDownListFor(model => model.Code, Model.ListOfImprestTypes, "--select Type--", new { @class = "form-control", @id = "ddlReimbType" })
        </div>
        <div class="col-md-6">
            Amount
            <input type="text" class="form-control" id="txtReimAmount" onkeypress="return functionDecimal(event,this.value)" />
        </div>
    </div>
    <hr />   
    <div align="center">
        <input type="button" class="btn btn-primary waves-effect waves-light" value="Add Line" onclick="AddLineItem();" />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlReimbType").select2({
            width: '100%'
        });
        if (`@Model.Amount` != "" && `@Model.Amount` != null && `@Model.Amount` != "0") {
            $("#txtReimAmount").val(`@Model.Amount`);
            document.getElementById("ddlReimbType").disabled = true;
        }
    });
    function functionDecimal(evt, val) {
        try {
            var charCode = (evt.which) ? evt.which : event.keyCode;

            if (charCode == 46) {
                if (!(val.indexOf(".") > -1)) {
                    return true;
                }
                else {
                    Swal.fire('Warning', 'Kindly ensure to specify decimals only', 'warning');
                }
            }
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                Swal.fire('Warning', 'Kindly ensure to specify decimals only', 'warning');
                return false;
            }
            return true;
        } catch (w) {
            Swal.fire(w);
        }
    }
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>


