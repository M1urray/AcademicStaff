
@model Latest_Staff_Portal.ViewModel.NewExitHeader
<div class="table-responsive">
    <table class="table table-centered table-nowrap" id="ExitQuestions">
        <thead>
            <tr>
                <th>Question</th>
                <th>Answer</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ExitQuestions != null && Model.ExitQuestions.Count() > 0)
                {
                    foreach (var item in Model.ExitQuestions)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Questionare)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Answer)
                            </td>

                            <td style="text-align:right" class="tdAction">
                                <a href="javascript:void(0);" class="mr-3 text-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EditItem('@item.DocNo','@item.LnNo');"><i class="mdi mdi-pencil font-size-16"></i></a>
                                <a href="javascript:void(0);" class="text-danger" data-toggle="tooltip" data-placement="top" title="" data-original-title="Delete" onclick="RemoveItem('@item.DocNo','@item.LnNo');"><i class="mdi mdi-close font-size-16"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div align="right">
    <input type="button" value="Answer Questions" class="btn btn-danger BtnPadding" onclick="AnswerQuestions(@Model.No);" />
</div>
<script type="text/javascript">

</script>

