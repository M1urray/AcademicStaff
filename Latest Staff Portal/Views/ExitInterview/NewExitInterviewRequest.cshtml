@model Latest_Staff_Portal.ViewModel.NewExitHeader
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 7px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<div class="card pre-scrollable">
    <div class="card-body">
        <b>Staff Exit Form</b>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Staff No", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.EmployeeNumber, new { @class = "form-control", @id = "txtStaffNo" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Employee Category", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.EmployeeCategory, new { @class = "form-control", @id = "txtEmpCat" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Length Of Service", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.LengthOfService, new { @class = "form-control", @id = "txtLengthOfService" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Designation", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Designation, new { @class = "form-control", @id = "txtDesignation" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Last Date of Service", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <input type="datetime" class="form-control" placeholder="dd/mm/yyyy" id="txtLastDateOfService" onkeydown="return false;" autocomplete="off" />
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Submit Exit Request" onclick="SubmitExitInterviewRequest();" />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#txtLastDateOfService').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-5:+5',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy'
        });
        document.getElementById("txtStaffNo").disabled = true;
        document.getElementById("txtEmpCat").disabled = true;
        document.getElementById("txtLengthOfService").disabled = true;
        document.getElementById("txtDesignation").disabled = true;
      
    });
</script>

