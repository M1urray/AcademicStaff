@model IEnumerable<Latest_Staff_Portal.ViewModel.NewExitHeader>
<div class="pre-scrollable">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead style="background-color:black;color:white">
            <tr>
                <th>Action</th>
                <th>No</th>
                <th>Staff Name</th>
                <th>Clearance Date</th>
                <th>Length Of Service</th>
                <th>Date Of Leaving</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <input type="button" onclick="SelectedRow('@item.No','Active');" class="btn btn-sm btn-danger" value="Select" />
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.No)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EmployeeNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ClearanceDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LengthOfService)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.LeavingDate)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

