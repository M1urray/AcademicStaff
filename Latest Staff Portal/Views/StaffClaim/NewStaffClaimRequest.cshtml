                School = "";
            }
            var StaffClaimHeader = {};
            StaffClaimHeader.Remarks = Remarks;
            StaffClaimHeader.school = School;
            StaffClaimHeader.Campus = Campus;
            StaffClaimHeader.Department = Department;
            StaffClaimHeader.RespC = RespoC;
            StaffClaimHeader.Project = Project;
            ShowProgress();

            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/StaffClaim/SubmitStaffClaimRequisition",
