@model Latest_Staff_Portal.ViewModel.NewStaffClaimRequisition
@{
    ViewBag.Title = "NewStaffClaimRequest";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div style="background-color: black;">
    <a href="#" onclick="StaffClaimRequisitionLink();" style="color:yellow"><<< Back To Staff Claim Requisition List</a>
</div>
<div class="card pre-scrollable">
    <div class="card-body">
        <b>Staff Claim Header</b>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Campus", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Campus, Model.ListOfCampus, "--select Campus--", new { @class = "form-control", @id = "ddlCampus" })
                        @Html.ValidationMessageFor(model => model.Campus, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("School(Optional)", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.school, Model.ListOfSchool, "--select School--", new { @class = "form-control", @id = "ddlSchool" })
                        @Html.ValidationMessageFor(model => model.school, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Department, Model.ListOfDepartment, "--select Department--", new { @class = "form-control", @id = "ddlDepartment" })
                        @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Responsibility Center", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.RespC, Model.ListOfResponsibility, "--select Responsibility Center--", new { @class = "form-control", @id = "ddlRespC" })
                        @Html.ValidationMessageFor(model => model.RespC, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Project(Optional)", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.DropDownListFor(model => model.Proj, Model.ListOfProjects, "--select Project--", new { @class = "form-control", @id = "ddlProject" })
                        @Html.ValidationMessageFor(model => model.Proj, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Purpose(50 Characters):", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <textarea id="txtRemarks" class="form-control" maxlength="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        @*<b>Staff Claim Lines</b>
            <hr />
            <div class="pre-scrollable">
                <table class="table table-hover" id="StaffClaimLines">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Description</th>
                            <th>Description 2</th>
                            <th style="text-align:center">Amount</th>
                            <th style="text-align:right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr class="NoRecords">
                            <td colspan="4">
                                <span style="color:red" id="NoRecords">No Lines Added</span>
                            </td>
                            <td class="text-right">
                                <input type="button" value="Add Item Line" class="btn btn-danger BtnPadding" onclick="AddStaffClaimLines();" />
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <hr />*@
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Create Document" onclick="SubmitStaffClaimRequisition();" />
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" ke aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel">New Staff Claim Line</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
