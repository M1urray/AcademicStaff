@model Latest_Staff_Portal.ViewModel.TargetActivities
<style>
    .ui-front {
        z-index: 2000 !important;
    }
</style>
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-6">
            Activity
            @Html.TextAreaFor(m => m.Activity, new { @class = "form-control", @id = "txtActivity", @rows = "3" })
        </div>
        <div class="col-md-6">
            Resources Required
            @Html.TextAreaFor(m => m.Resources_Required, new { @class = "form-control", @id = "txtResourceReq", @rows = "3" })
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-6">
            Expected Results
            @Html.TextAreaFor(m => m.Expected_Results, new { @class = "form-control", @id = "txtExpResults", @rows = "3" })
        </div>
        <div class="col-md-6">
            Performance Indicator
            @Html.TextAreaFor(m => m.Performance_Indicator, new { @class = "form-control", @id = "txtKPI", @rows = "3" })
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-6">
            Time Frame
            @if (ViewBag.QList != null && ViewBag.QList.Count > 0)
            {
                @Html.DropDownListFor(m => m.Time_Frame, new SelectList(ViewBag.QList, "Value", "Text", Model.Time_Frame), "----", new { @id = "ddlTimeF", @class = "form-control" })
            }
        </div>
    </div>
    <hr />
    <div align="center">
        @if (Model.Activity != "" && Model.Activity != null)
        {
            <input type="button" class="btn btn-danger waves-effect waves-light" value="Update Activity" onclick="UpdateTargetActivity('@Model.Entry_No');" />
        }
        else
        {
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Add Activity" onclick="SubmitTargetActivity('@Model.Target_Entry_No');" />
        }
    </div>
</div>

