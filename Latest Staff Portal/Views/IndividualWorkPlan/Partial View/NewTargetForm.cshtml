@model Latest_Staff_Portal.ViewModel.ObjTarget
<style>
    .ui-front {
        z-index: 2000 !important;
    }
</style>
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-12">
            <b>Enter Target</b>
            @Html.TextAreaFor(m => m.Target, new { @class = "form-control", @id = "txtNewTarget", @rows = "3" })
        </div>
    </div>
    <hr />
    <div align="center">
        @if (Model.Target != "" && Model.Target != null)
        {
            <input type="button" class="btn btn-danger waves-effect waves-light" value="Update Target" onclick="UpdateTarget(`@Model.EntryNo`);" />
        }
        else
        {
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Add Target" onclick="SubmitTarget();" />
        }
    </div>
</div>



