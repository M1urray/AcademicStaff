@model Latest_Staff_Portal.ViewModel.IndividualObjectives
<style>
    .ui-front {
        z-index: 2000 !important;
    }
</style>
<div class="bg-soft-dark" style="color:black">
    <div class="row">
        <div class="col-md-12">
            <b>Enter Objective</b>
            @Html.TextAreaFor(m => m.Obj, new { @class = "form-control", @id = "txtNewObj", @rows = "3" })
        </div>
    </div>
    <hr />
    <div align="center">
        @if (Model.Obj != "" && Model.Obj != null)
        {
            <input type="button" class="btn btn-danger waves-effect waves-light" value="Update Objective" onclick="UpdateObjective(`@Model.EntryNo`);" />
        }
        else
        {
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Add Objective" onclick="SubmitObjective();" />
        }
    </div>
</div>


