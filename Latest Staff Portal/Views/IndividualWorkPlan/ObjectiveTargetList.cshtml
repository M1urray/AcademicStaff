@model Latest_Staff_Portal.ViewModel.DocTarget
@{
    ViewBag.Title = "ObjectiveTargetList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .tb1 {
        background-color: black;
        color: white;
    }

    .tb2 {
        background-color: #808080;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div style="background-color: black;">
    <a href="#" onclick="WorkplancardLink();" style="color:yellow"><<< Back To Workplan Card</a>
</div>
<hr />
<div>
    <b>Objective :</b>(@Model.Objective)
</div>
<div class="card pre-scrollable">
    <div class="card-title">Objective Target List</div>
    <div class="card-body">
        <a href="#" onclick="NewTargetForm();" class="btn btn-primary BtnPadding">Create New Target</a>
        <hr />
        <div id="divTargetList"></div>
        <div class="row">
            <div class="col-md-12">
                <b>Supervisor Remarks</b>
                @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", @rows = "3", @id = "txtmarks",@readonly="readonly" })
            </div>            
        </div>
    </div>
</div>
@*//////////////////////New Target Modal////////////////////////////*@
<div class="modal fade" id="myModalNewTarget" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">Target Form</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyNewTarget">                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" ke aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel">New Activity Form</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoaTargetListList();
    });
    var LoaTargetListList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "post",
            contentType: "application/json; charset = utf-8",
            data: JSON.stringify({ AppDoc: '@Model.DocNo', ObjEntryNo: '@Model.ObjEntryNo' }),
            url: "/IndividualWorkPlan/LoadObjectiveTarget",
            success: function (data) {
                HideProgress();
                $("#divTargetList").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewTargetForm = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ Target: "", EntryNo: "" }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/IndividualWorkPlan/NewObjectiveTargetForm',
            success: function (data) {
                $("#modalBodyNewTarget").html(data);
                HideProgress();
                $("#myModalNewTarget").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var EditTargetForm = function (Target,EntryNo) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ Target: Target, EntryNo: EntryNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/IndividualWorkPlan/NewObjectiveTargetForm',
            success: function (data) {
                $("#modalBodyNewTarget").html(data);
                HideProgress();
                $("#myModalNewTarget").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var WorkplancardLink = function () {
        var AppDoc = '@Model.DocNo';
        window.location = "/IndividualWorkPlan/IndividualWorkPlanCard?AppDoc=" + AppDoc;
    };
    var SubmitTarget = function () {
        var DocNo = '@Model.DocNo';
        var ObjEntryNo = '@Model.ObjEntryNo';
        var Target = $("#txtNewTarget").val();

        if (Target == "") {
            Swal.fire('error', 'Enter Target', 'error');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/IndividualWorkPlan/SubmitObjectiveTarget",
                data: JSON.stringify({ AppNo: DocNo, ObjEntryNo: ObjEntryNo, Target: Target }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoaTargetListList();
                        $("#myModalNewTarget").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var UpdateTarget = function (EntryNo) {
        var DocNo = '@Model.DocNo';
        var Target = $("#txtNewTarget").val();

        if (Target == "") {
            Swal.fire('error', 'Enter Target', 'error');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/IndividualWorkPlan/UpdateObjectiveTarget",
                data: JSON.stringify({ AppNo: DocNo, EntryNo: EntryNo, Target: Target }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoaTargetListList();
                        $("#myModalNewTarget").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var RemoveTargetItem = function (EntryNo) {
        var DocNo = '@Model.DocNo';
        $.ajaxSetup({ cache: false });
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    type: "post",
                    url: "/IndividualWorkPlan/DeleteObjectiveTarget",
                    data: JSON.stringify({ AppNo: DocNo, EntryNo: EntryNo }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            LoaTargetListList();
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('error', data.message, 'error');
                        }
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Record has not been deleted', 'error');
            }
        });
    };
    var AddTargetActivity = function (TargetEntryNo) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ TargetEntryNo: TargetEntryNo }),
            url: '/IndividualWorkPlan/NewTargetActivityForm',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var UpdateTargetActivityForm = function (EntryNo) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ EntryNo: EntryNo }),
            url: '/IndividualWorkPlan/UpdateTargetActivityForm',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var SubmitTargetActivity = function (TargetEntryNo) {
        var DocNo = '@Model.DocNo';
        var ObjEntryNo = '@Model.ObjEntryNo';
        var TargetEntryNo = TargetEntryNo;
        var Activity = $("#txtActivity").val();
        var ResourceReq = $("#txtResourceReq").val();
        var Results = $("#txtExpResults").val();
        var Kpi = $("#txtKPI").val();
        var TimeF = $("#ddlTimeF").children("option:selected").val();

        if (Activity == "") {
            Swal.fire('error', 'Enter Activity', 'error');
            return;
        }
        else if (ResourceReq == "") {
            Swal.fire('error', 'Enter Resource required', 'error');
            return;
        }
        else if (Results == "") {
            Swal.fire('error', 'Enter Expected results', 'error');
            return;
        }
        else if (Kpi == "") {
            Swal.fire('error', 'Enter Performance Indicator', 'error');
            return;
        }
        else if (TimeF == "") {
            Swal.fire('error', 'Choode Time frame', 'error');
            return;
        }
        else {
            var TargetActivities = {};
            TargetActivities.Objective_Entry_No = ObjEntryNo;
            TargetActivities.Target_Entry_No = TargetEntryNo;
            TargetActivities.Activity = Activity;
            TargetActivities.Resources_Required = ResourceReq;
            TargetActivities.Expected_Results = Results;
            TargetActivities.Time_Frame = TimeF;
            TargetActivities.Performance_Indicator = Kpi;
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/IndividualWorkPlan/SubmitTargetActivity",
                data: JSON.stringify({ AppNo: DocNo, act: TargetActivities }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoaTargetListList();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var UpdateTargetActivity = function (EntryNo) {
        var DocNo = '@Model.DocNo';
        var Activity = $("#txtActivity").val();
        var ResourceReq = $("#txtResourceReq").val();
        var Results = $("#txtExpResults").val();
        var Kpi = $("#txtKPI").val();
        var TimeF = $("#ddlTimeF").children("option:selected").val();

        if (Activity == "") {
            Swal.fire('error', 'Enter Activity', 'error');
            return;
        }
        else if (ResourceReq == "") {
            Swal.fire('error', 'Enter Resource required', 'error');
            return;
        }
        else if (Results == "") {
            Swal.fire('error', 'Enter Expected results', 'error');
            return;
        }
        else if (Kpi == "") {
            Swal.fire('error', 'Enter Performance Indicator', 'error');
            return;
        }
        else if (TimeF == "") {
            Swal.fire('error', 'Choode Time frame', 'error');
            return;
        }
        else {
            var TargetActivities = {};
            TargetActivities.Activity = Activity;
            TargetActivities.Resources_Required = ResourceReq;
            TargetActivities.Expected_Results = Results;
            TargetActivities.Time_Frame = TimeF;
            TargetActivities.Performance_Indicator = Kpi;
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/IndividualWorkPlan/UpdateTargetActivity",
                data: JSON.stringify({ AppNo: DocNo, EntryNo: EntryNo, act: TargetActivities }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoaTargetListList();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var RemoveTargetActivityItem = function (EntryNo) {
        var DocNo = '@Model.DocNo';
        $.ajaxSetup({ cache: false });
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    type: "post",
                    url: "/IndividualWorkPlan/DeleteTargetActivity",
                    data: JSON.stringify({ AppNo: DocNo, EntryNo: EntryNo }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            LoaTargetListList();
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('error', data.message, 'error');
                        }
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Record has not been deleted', 'error');
            }
        });
    };
</script>

