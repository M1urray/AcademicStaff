@model IEnumerable<Latest_Staff_Portal.ViewModel.IndividualObjectives>
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table id="tableScoreCard" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th width="5%">#</th>
                <th width="85%">Objective</th>
                <th width="10%">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @i
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Obj)
                                </td>
                                <td>
                                    <div>
                                        <button class="btn BtnPadding btn-success" onclick="ObjectiveTarget(`@item.EntryNo`);">Objective Targets</button>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" style="color:red">
                                No Objectives Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>




