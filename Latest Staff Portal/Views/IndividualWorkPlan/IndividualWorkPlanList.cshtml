
@{
    ViewBag.Title = "IndividualWorkPlanList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-title">Individual Work Plan List</div>
    <div class="card-body">
        <a href="#" onclick="NewDoc();" class="btn btn-primary BtnPadding">Create New Document</a>
        <a href="#" onclick="ViewDoc();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <hr />
        <div id="divAppList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoaIndividualReqList();
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success', true);
            $.ajax({
                type: "POST",
                url: "/Common/NullibySessions"
            });
        }
    });
    var LoaIndividualReqList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/IndividualWorkPlan/IndividualWorkPlanListView",
            success: function (data) {
                HideProgress();
                $("#divAppList").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewDoc = function () {
        $("#labelF").text("New Document Form");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/IndividualWorkPlan/NewRequisition',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitAppraisalRequisition = function () {
        var ApprisalPeriod = $("#ddlApprPeriod").children("option:selected").val();
        var SupNo = $("#ddlSup").children("option:selected").val();

        if (ApprisalPeriod == "") {
            Swal.fire('error', 'Select Apprisal Period', 'error');
            return;
        }
        else if (SupNo == "") {
            Swal.fire('error', 'Select Your Supervisor', 'error');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/IndividualWorkPlan/SubmitIndividualWkPDocument",
                data: JSON.stringify({ AppPeriod: ApprisalPeriod, Supervisor: SupNo }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        window.location = data.message;
                    }
                    else {
                        HideProgress();
                        $("#myModal").modal("hide");
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            $("#ViewDoc").removeClass("disabled");
        });
    }
    var ViewDoc = function () {
        ShowProgress();
        var row = $('#dtIndTaget tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        window.location = "/IndividualWorkPlan/IndividualWorkPlanCard?AppDoc=" + DocNo;
    }
</script>

