
@{
    ViewBag.Title = "ForgotPassword";
    Layout = "~/Views/Shared/LoginMaster.cshtml";
}
<style>
    .textl-center {
        text-align: right !important;
    }

    .textAnimation {
        animation: alternate;
    }
</style>
<div class="p-2">
    <div class="form-group">
        <label for="username" class="lblClass">Username</label>
        <input type="text" class="form-control" id="username" placeholder="Enter username" required>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary btn-block waves-effect waves-light" id="btnReset" type="submit">Reset Password</button>
    </div>
    <div class="mt-4 textl-center">
        <a href="@Url.Action("Login", "Login")" class="text-muted"><i class="mdi mdi-login mr-1"></i> Login</a>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnReset").click(function () {
            var username = $("#username").val();
            if (username == "") {
                Swal.fire('Warning', 'Enter Username', 'warning');
                return;
            }
            else {
                var Authedication = {};
                Authedication.Username = username;
                ShowProgress();
                debugger
                $.ajax({
                    url: '@Url.Action("ForgotPassword", "Login")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ userlogin: Authedication }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            Swal.fire('Success', data.message, 'success');
                            HideProgress();
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Error', err, 'error');
                    }
                });
            }
        });
    });
    $("#username").keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btnReset").click();
        }
    });
</script>



