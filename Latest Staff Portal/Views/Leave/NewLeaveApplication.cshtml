@model Latest_Staff_Portal.ViewModel.NewLeaveApplication

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label("Leave Type", htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                @Html.DropDownListFor(model => model.Leave_Type, Model.ListOfLeaveTypes, "--select Leave Type--", new { @class = "form-control", @id = "ddlLeaveType", @onchange = "GetLeaveBalance()" })
                @Html.ValidationMessageFor(model => model.Leave_Type, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-6" align="center">
        <div class="form-group">
            <b>Annual Leave Entitlement :</b> <label id="lblAllD">@Model.AllocatedDays</label><br />
            <b>Leave carried forward from previous Year : </b><label id="lblCarrF">@Model.CarryForawrd</label><br />
            <b>Reimbursed Days : </b><label id="lblReimbD">@Model.ReimbDays</label><br />
            <b>Leave Taken : </b><label id="lblLvTaken">@Model.LeaveTaken</label><br />
            @* <b>Earned Days : </b><label id="lblEarnedDays">@Model.EarnedLeaveDays</label><br /> *@
            <b>Leave Balance : </b><label id="lblBalance">@Model.LeaveBal</label>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label("Applied Days", htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                <select class="form-control" id="ddlNoDays" name="ddlNoDays" onchange="GetEndReturnDate()">
                </select>
                @Html.ValidationMessageFor(model => model.AppliedDays, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label("Reliever", htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                @Html.DropDownListFor(model => model.Reliever, Model.ListOfRelievers, "--select Reliever--", new { @class = "form-control", @id = "ddlReliever" })
                @Html.ValidationMessageFor(model => model.AppliedDays, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
</div>
<div class="row" style="background-color:#d5d3d3;color:black">
    <div class="col-md-4">
        <div class="form-group">
            @Html.Label("Start Date", new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                <input type="datetime" class="form-control" placeholder="dd/mm/yyyy" id="dtPicker" onkeydown="return false;" autocomplete="off" onkeyup="DateChanged(this)" />
                <div class='a'></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.Label("End Date", htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                <label id="EndDate" style="color:#6B6A03"></label>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.Label("Return Date", new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                <label id="ReturnDate" style="color:#6B6A03"></label>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label("Hand-Over Report(Optioal)", htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                <input type="file" class="form-control" id="LeavefileAttachment" />
            </div>
        </div>
    </div>
    <div class="col-md-6"></div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            @Html.Label("Remarks", htmlAttributes: new { @class = "control-label col-md-12" })
            <div class="col-md-12">
                <textarea id="txtRemarks" class="form-control"></textarea>
            </div>
        </div>
    </div>
</div>
<hr />
<div align="center">
    <input type="button" class="btn btn-primary waves-effect waves-light" value="Submit Request" onclick="SubmitLeaveRequisition();" />
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#ddlNoDays').empty().append('<option selected="selected" value="0">--No of Days--</option>');
        $('#EndDate').html("dd/mm/yyyy");
        $('#ReturnDate').html("dd/mm/yyyy");

        $('#dtPicker').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-0:+2',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy',
            minDate: 0
        });
        $(window).resize(function () {
            $('#dtPicker').datepicker('hide');
            $('#dtPicker').blur();
        });

        $('#dtPicker').change(function () {
            var StartDate = $('#dtPicker').val();
            var days = $("#ddlNoDays").children("option:selected").val();
            var LvType = $("#ddlLeaveType").children("option:selected").val();
            if (LvType == "") {
                $("#ddlNoDays option").remove();
                $('#ddlNoDays').empty().append('<option selected="selected" value="0">--No of Days--</option>');
                Swal.fire('Warning', 'Select Leave Type', 'warning');
                $('#dtPicker').val("");
                return;
            }
            else if (days == "0") {
                Swal.fire('Warning', 'Select Number of days', 'warning');
                $('#dtPicker').val("");
                return;
            }
            else if (StartDate == "") {
                Swal.fire('Warning', 'Select Leave Start Date', 'warning');
                $('#dtPicker').val("");
                return;
            }
            else {
                ShowProgress();
                $.getJSON("/Leave/End_ReturnDates", { startDate: StartDate, days: days, LvType: LvType },
                    function (data) {
                        if (data.success == true) {
                            $('#EndDate').html(data.ERDate.EndDate);
                            $('#ReturnDate').html(data.ERDate.ReturnDate);
                            HideProgress();
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            $('#dtPicker').val("");
                            HideProgress();
                        }
                    });
            }
        });

        $("#ddlReliever").select2({
            width: '100%'
        });
    });
    var GetLeaveBalance = function () {
        var LeaveType = $("#ddlLeaveType").children("option:selected").val();
        $("#ddlNoDays option").remove();
        $('#ddlNoDays').empty().append('<option selected="selected" value="0">--No of Days--</option>');
        $("#lblAllD").text("0");
        $("#lblReimbD").text("0");
        $("#lblLvTaken").text("0");
        $("#lblBalance").text("0");
        $("#lblEarnedDays").text("0");
        $('#dtPicker').text("");
        $('#EndDate').html("dd/mm/yyyy");
        $('#ReturnDate').html("dd/mm/yyyy");
        if (LeaveType == "") {
            return;
        }
        else {
            ShowProgress();
            $.getJSON("/Leave/GetLeaveBalance", { LvType: LeaveType },
                function (data) {
                    if (data.success == true) {
                        $("#lblAllD").text(data.newBal.AllocatedDays);
                        $("#lblCarrF").text(data.newBal.CarryForawrd);
                        $("#lblReimbD").text(data.newBal.ReimbDays);
                        $("#lblLvTaken").text(data.newBal.LeaveTaken);
                        $("#lblBalance").text(data.newBal.Balance);
                        $("#lblEarnedDays").text(data.newBal.EarnedLeaveDays);
                        $("#ddlNoDays").empty().append('<option selected="selected" value="0">--No of Days--</option>');
                        $.each(data.newBal.ListOfDays, function () {
                            $("#ddlNoDays").append($("<option></option>").val(this['Value']).html(this['Text']));
                        });
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                    }
                    HideProgress();
                });
        }
    }
    var GetEndReturnDate = function () {
        $('#dtPicker').val("");
        $('#EndDate').html("dd/mm/yyyy");
        $('#ReturnDate').html("dd/mm/yyyy");
    }
</script>


