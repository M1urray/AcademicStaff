
@{
    ViewBag.Title = "LeaveRequisitionList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-title">Leave Application List</div>
    <div class="card-body">
        <a href="#" onclick="NewLeaveRequisition();" class="btn btn-primary BtnPadding">New Leave</a>
        <a href="#" onclick="ViewLeaveDoc();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <a href="#" onclick="SendLeaveDocForApproval();" class="btn btn-primary BtnPadding disabled" id="SendDocAppr">Send Approval Request</a>
        <a href="#" onclick="CancelLeaveDocForApproval();" class="btn btn-danger BtnPadding disabled" id="CancelDocAppr">Cancel Approval Request</a>
        <a href="#" onclick="ViewApprovalTrail();" class="btn btn-primary BtnPadding disabled" id="AppTrail">Document Approval Trail</a>
        <a href="#" onclick="ViewDocComments();" class="btn btn-danger BtnPadding disabled" id="AppComments">Document Comments</a>
        <hr />
        <div id="divLeaveRegList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadLeaveReqList();
    });
    var LoadLeaveReqList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("LeaveRequisitionListPartialView", "Leave")',
            success: function (data) {
                $("#divLeaveRegList").html(data);
                HideProgress();
            },
            error: function () {
                Swal.fire("There is some problem to process your request. Please try after some time");
                HideProgress();
            }
        });
    }
    var NewLeaveRequisition = function () {
        $("#labelF").text("New Leave Application");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("NewLeaveApplication", "Leave")',
            success: function (data) {
                $("#modalBody").html(data);
                $("#ddlRespC").select2({
                    width: '100%'
                });
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitLeaveRequisition = function () {
        var StartDate = $('#dtPicker').val();
        var EndDate = $('#EndDate').html();
        var ReturntDate = $('#ReturnDate').html();
        var days = $("#ddlNoDays").children("option:selected").val();
        var LvType = $("#ddlLeaveType").children("option:selected").val();
        var Reliever = $("#ddlReliever").children("option:selected").val();
        var Address = $("#txtAddress").val();
        var PhNo = $("#txtPhoneNo").val();
        var RespC = $("#ddlRespC").children("option:selected").val();
        var Remarks = $("#txtRemarks").val();
        if (LvType == "") {
            Swal.fire('error', 'Select Leave Type', 'error');
            return;
        }
        else if (days == "") {
            Swal.fire('error', 'Select Number of days you want to apply for leave', 'error');
            return;
        }
        else if (Reliever == "") {
            Swal.fire('error', 'Select Reliever', 'error');
            return;
        }
        else if (Address == "") {
            Swal.fire('error', 'Enter Address while on Leave', 'error');
            return;
        }
        else if (PhNo == "") {
            Swal.fire('error', 'Enter Phone Number while on leave', 'error');
            return;
        }
        else if (StartDate == "") {
            Swal.fire('error', 'Select Start Date', 'error');
            return;
        }
        else if (EndDate == "dd/mm/yyyy") {
            Swal.fire('error', 'End Date cannot be empty', 'error');
            return;
        }
        else if (ReturntDate == "dd/mm/yyyy") {
            Swal.fire('error', 'Return Date cannot be empty', 'error');
            return;
        }
        else if (RespC == "") {
            Swal.fire('error', 'Select Responsibility Center', 'error');
            return;
        }
        else {
            var LeaveReqList = {};
            LeaveReqList.Leave_Type = LvType;
            LeaveReqList.Applied_Days = days;
            LeaveReqList.Starting_Date = StartDate;
            LeaveReqList.End_Date = EndDate;
            LeaveReqList.Return_Date = ReturntDate;
            LeaveReqList.Remarks = Remarks;
            LeaveReqList.Address = Address;
            LeaveReqList.phoneNo = PhNo;
            LeaveReqList.Reliever = Reliever;
            LeaveReqList.Responsibility = RespC;
            ShowProgress();
            $.ajax({
                type: "post",
                url: '@Url.Action("SubmitLeaveApplication", "Leave")',
                data: JSON.stringify({ NewApp: LeaveReqList }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadLeaveReqList();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        LoadLeaveReqList();
                        Swal.fire('error', data.message, 'error');
                    }
                    $("#myModal").modal("hide");
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            var row = $('#datatable-buttons tr.selectedTableRow');
            var Status = row.find("td").eq(9).html().trim();
            $("#ViewDoc").removeClass("disabled");
            $("#AppComments").removeClass("disabled");
            if (Status == "Open") {
                $("#SendDocAppr").removeClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else if (Status == "Pending Approval") {
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").removeClass("disabled");
                $("#AppTrail").removeClass("disabled");
            }
            else if (Status == "Approved") {
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else {
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
        });
    }
    var ViewLeaveDoc = function () {
        $("#labelF").text("Leave Details Document");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("LeaveDocumentViewView", "Leave")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SendLeaveDocForApproval = function () {
        $("#labelF").text("Leave Details Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("SendLeaveAppForApproval", "Leave")',
            success: function (data) {
                HideProgress();
                LoadLeaveReqList();
                if (data.success == true) {
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    Swal.fire('Error', data.message, 'error');
                }
                DiableButtons();
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var CancelLeaveDocForApproval = function () {
        $("#labelF").text("Leave Details Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("CancelLeaveAppForApproval", "Leave")',
            success: function (data) {
                HideProgress();
                LoadLeaveReqList();
                if (data.success == true) {
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    Swal.fire('Error', data.message, 'error');
                }
                DiableButtons();
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });

    }
    var ViewApprovalTrail = function () {
        $("#labelF").text("Document Approval Trail");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("DocumentApprovalTrail", "Common")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DiableButtons = function () {
        $("#ViewDoc").addClass("disabled");
        $("#SendDocAppr").addClass("disabled");
        $("#CancelDocAppr").addClass("disabled");
        $("#AppTrail").addClass("disabled");
        $('table tbody tr').siblings().removeClass("selectedTableRow");
    }
    var UpdateLeaveDocument = function (DocNo) {
        var StartDate = $('#txtstartDate').val();
        var EndDate = $('#EndDate').val();
        var ReturntDate = $('#ReturnDate').val();
        var days = $("#ddlNoDays").children("option:selected").val();
        var LvType = $('#txtLeaveType').val();
        var Reliever = $("#ddlReliever").children("option:selected").val();
        var RespC = $("#ddlRespC").children("option:selected").val();
        var Remarks = $("#txtRemarks").val();
        if (LvType == "") {
            Swal.fire('error', 'Select Leave Type', 'error');
            return;
        }
        else if (days == "") {
            Swal.fire('error', 'Select Number of days you want to apply for leave', 'error');
            return;
        }
        else if (Reliever == "") {
            Swal.fire('error', 'Select Reliever', 'error');
            return;
        }
        else if (StartDate == "") {
            Swal.fire('error', 'Select Start Date', 'error');
            return;
        }
        else if (EndDate == "dd/mm/yyyy") {
            Swal.fire('error', 'End Date cannot be empty', 'error');
            return;
        }
        else if (ReturntDate == "dd/mm/yyyy") {
            Swal.fire('error', 'Return Date cannot be empty', 'error');
            return;
        }
        else if (RespC == "") {
            Swal.fire('error', 'Select Responsibility Center', 'error');
            return;
        }
        else {
            var LeaveReqList = {};
            LeaveReqList.No = DocNo;
            LeaveReqList.Leave_Type = LvType;
            LeaveReqList.Applied_Days = days;
            LeaveReqList.Starting_Date = StartDate;
            LeaveReqList.End_Date = EndDate;
            LeaveReqList.Return_Date = ReturntDate;
            LeaveReqList.Remarks = Remarks;
            LeaveReqList.Reliever = Reliever;
            LeaveReqList.Responsibility = RespC;
            ShowProgress();
            $.ajax({
                type: "post",
                url: '@Url.Action("UpdateLeaveApplication", "Leave")',
                data: JSON.stringify({ NewApp: LeaveReqList }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadLeaveReqList();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        LoadLeaveReqList();
                        Swal.fire('error', data.message, 'error');
                    }
                    $("#myModal").modal("hide");
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var ViewDocComments = function () {
        $("#labelF").text("Document Comments");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("DocumentApprovalComments", "Common")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>
