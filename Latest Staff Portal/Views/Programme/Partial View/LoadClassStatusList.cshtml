@model IEnumerable<Latest_Staff_Portal.ViewModel.TimeTableView>
<div class="card-body">
    <table id="datatable-buttons" class="table table-bordered table-hover nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead>
            <tr>
                <th>Unit</th>
                <th>Section</th>
                <th>Description</th>
                <th>No. Students</th>
                <th>Lecturer</th>
                <th>Campus</th>
                <th>Day</th>
                <th>Time</th>
                <th>Room</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Section)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Registered)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Lecturer)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Campus)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Day_of_Week)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Period)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Lecture_Room)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Programme Records Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#datatable").DataTable(), $("#datatable-buttons").DataTable({
            lengthChange: !1,
            buttons: [
                "copy",
                {
                    extend: 'excel',
                    title: 'Programme List'
                },
                {
                    extend: 'pdf',
                    title: 'Programme List'
                }
            ]
        }).buttons().container().appendTo("#datatable-buttons_wrapper .col-md-6:eq(0)")
    });
</script>
