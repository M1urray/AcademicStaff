@model IEnumerable<Latest_Staff_Portal.ViewModel.TrainingList>
<div class="pre-scrollable">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
        <thead style="background-color:black;color:white">
            <tr>
                <th></th>
                <th>No</th>
                <th>Training Category</th>
                <th>Course Title</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <input type="button" onclick="SelectedRow('@item.ApplicationNo','@item.Status');" class="btn btn-sm btn-danger" value="Select" />
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ApplicationNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TrainingCategory)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CourseTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>



