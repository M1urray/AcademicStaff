
@{
    ViewBag.Title = "TransportRequisitionList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 4px;
        font-size: 12px;
    }
</style>
<div class="card pre-scrollable">
    <div class="card-title">Transport Requisition List</div>
    <div class="card-body">
        <a href="#" onclick="NewTrasnportRequisition();" class="btn btn-primary BtnPadding">New Transport Request</a>
        <a href="#" onclick="ViewTransporteDoc();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <a href="#" onclick="SendDocForApproval();" class="btn btn-primary BtnPadding disabled" id="SendDocAppr">Send Approval Request</a>
        <a href="#" onclick="CancelDocForApproval();" class="btn btn-danger BtnPadding disabled" id="CancelDocAppr">Cancel Approval Request</a>
        <a href="#" onclick="ViewApprovalTrail();" class="btn btn-primary BtnPadding disabled" id="AppTrail">Document Approval Status</a>
        <hr />
        <div id="divTransportRegList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title">New Transport Requisition</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadTransportReqList();
    });
    var LoadTransportReqList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("TransportRequisitionListPartialView", "Transport")',
            success: function (data) {
                $("#divTransportRegList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            var row = $('#datatable-buttons tr.selectedTableRow');
            var Status = row.find("td").eq(8).html().trim();
            if (Status == "Open") {
                $("#ViewDoc").removeClass("disabled");
                $("#SendDocAppr").removeClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else if (Status == "Pending Approval") {
                $("#ViewDoc").removeClass("disabled");
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").removeClass("disabled");
                $("#AppTrail").removeClass("disabled");
            }
            else if (Status == "Approved") {
                $("#ViewDoc").removeClass("disabled");
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else {
                $("#ViewDoc").addClass("disabled");
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
        });
    }
    var NewTrasnportRequisition = function () {
        $("#labelF").text("New Transport Requisition");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("NewTransportApplication", "Transport")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitTransportRequisition = function () {
        var Commencement = $("#txtCommence").val();
        var Destination = $("#txtDestination").val();
        var ResponC = $("#ddlRespC").children("option:selected").val();
        var DateTrip = $("#dtPicker").val();
        var TimeTrip = $("#txtTime").val();
        var NoOfDays = $("#txtNoOfDays").val();
        var Purpose = $("#txtRemarks").val();
        if (Commencement == "") {
            Swal.fire('error', 'Enter Place of Commencement', 'error');
            return;
        }
        else if (Destination == "") {
            Swal.fire('error', 'Enter Place of Destination', 'error');
            return;
        }
        else if (ResponC == "") {
            Swal.fire('error', 'Select Responsibility Center', 'error');
            return;
        }
        else if (DateTrip == "") {
            Swal.fire('error', 'Select Date of Trip', 'error');
            return;
        }
        else if (TimeTrip == "") {
            Swal.fire('error', 'Select Time of Departure', 'error');
            return;
        }
        else if (NoOfDays == "") {
            Swal.fire('error', 'Enter No of Days', 'error');
            return;
        }
        else if (Purpose == "") {
            Swal.fire('error', 'Enter Purpose of the Trip', 'error');
            return;
        }
        else {
            var NewTransportDocument = {};
            NewTransportDocument.Commencement = Commencement;
            NewTransportDocument.Destination = Destination;
            NewTransportDocument.RespC = ResponC;
            NewTransportDocument.DateTrip = DateTrip;
            NewTransportDocument.TimeTrip = TimeTrip;
            NewTransportDocument.NoOfDays = NoOfDays;
            NewTransportDocument.Purpose = Purpose;
            ShowProgress();
            $.ajax({
                type: "post",
                url: '@Url.Action("SubmitTransportDocument", "Transport")',
                data: JSON.stringify({ NewApp: NewTransportDocument }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        //window.location = data.message;
                        LoadTransportReqList();
                        $("#myModal").modal("hide");
                    }
                    else {
                        LoadTransportReqList();
                        $("#myModal").modal("hide");
                        HideProgress();
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var ViewTransporteDoc = function () {
        //$("#labelF").text("Leave Details Document");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        window.location = '@Url.Action("TransportDocumentDetails", "Transport")?AppDoc=' + DocNo;
    }
    var SendDocForApproval = function () {
        $("#labelF").text("Leave Details Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("SendDocAppForApproval", "Transport")',
            success: function (data) {
                LoadLeaveReqList();
                if (data.success == true) {
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                Swal.fire('Warning', err, 'warning');
            }
        });
        DiableButtons();
        HideProgress();
    }
    var CancelDocForApproval = function () {
        $("#labelF").text("Leave Details Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("CancelLeaveAppForApproval", "Transport")',
            success: function (data) {
                LoadLeaveReqList();
                if (data.success == true) {
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });

    }
    var ViewApprovalTrail = function () {
        $("#labelF").text("Document Approval Status");
        ShowProgress();
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("LeaveDocumentApprovalTrail", "Common")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DiableButtons = function () {
        $("#ViewDoc").addClass("disabled");
        $("#SendDocAppr").addClass("disabled");
        $("#CancelDocAppr").addClass("disabled");
        $("#AppTrail").addClass("disabled");
        $('table tbody tr').siblings().removeClass("selectedTableRow");
    }
</script>

