@model Latest_Staff_Portal.ViewModel.TransportReqList
@{
    ViewBag.Title = "TransportDocumentDetails";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div style="background-color: black;">
    <a href="#" onclick="TransportRequisitionLink();" style="color:yellow"><<< Back To Transport Requisition List</a>
</div>
<div class="card pre-scrollable">
    <div class="card-title">Transport Document Details</div>
    <div class="card-body">
        <hr />
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Document No</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning" id="DocNo">@Model.No</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Commencement</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.Commencement</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Destination</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.Destination</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Date of Trip</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.DateOfTrip</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Status</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning" id="AppPeriod">@Model.Status</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Vehicle Allocated</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.Vehicle</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Driver Allocated</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning" id="AppPeriod">@Model.Driver</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">No of Days</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.NoOfDays</span>
                    </div>
                </div>
            </div>
        </div>
        <hr style="border:1px solid black" />
        <b>Passenger Lines</b>
        <hr />
        <div id="divPassengerLines"></div>
        <hr style="border:1px solid black" />
        <div align="right" id="DivSendForApproval">
            <input type="button" class="btn btn-danger BtnPadding" value="Send For Approval >>>" onclick="SendDocForApproval();" />
        </div>
        <hr />
    </div>
</div>

@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" ke aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mt-0" id="myModalLabel"><label id="labelF"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script src="~/assets/js/pdfobject.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadPassengersLines(`@Model.No`, `@Model.Status`);
        HideHeaderEditInput();
        var status = `@Model.Status`;
        if (status == "Open") {
            $("#HideEditButton").show();
            $("#HideLineButton").show();
            $("#DivSendForApproval").show();
        }
        else {
            $("#HideEditButton").hide();
            $("#HideLineButton").hide();
            $("#DivSendForApproval").hide();
        }
    });
    var LoadPassengersLines = function (DocNo, Status) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ DocNo: DocNo, Status: Status }),
            url: "/Transport/TransportPassengers",
            success: function (data) {
                $("#divPassengerLines").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var TransportRequisitionLink = function () {
        ShowProgress();
        window.location = "/Transport/TransportRequisitionList";
    }
    var EditDocument = function () {
        if ($("#btnEdit").val() == "Edit Header") {
            var Campus = `@Model.Destination`;
            var Department = `@Model.Destination`;
            var RespC = `@Html.Raw(HttpUtility.HtmlDecode(Model.Destination).Replace("'", "\\'"))`;
            ShowProgress();
            $('#ddlCampus').empty().append('<option selected="selected" value="">--Select Campus--</option>');
            $('#ddlDepartment').empty().append('<option selected="selected" value="">--Select Department--</option>');
            $('#ddlRespC').empty().append('<option selected="selected" value="">--Select Responsibility Center--</option>');

            $.getJSON("/Common/GetCommonDropdwnListData", null,
                function (data) {
                    $('#ddlCampus').empty().append('<option selected="selected" value="">--Select Campus--</option>');
                    $('#ddlDepartment').empty().append('<option selected="selected" value="">--Select Department--</option>');
                    $('#ddlRespC').empty().append('<option selected="selected" value="">--Select Responsibility Center--</option>');
                    $.each(data.DropDownData.ListOfCampus, function () {
                        $("#ddlCampus").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    $('#ddlCampus').val(Campus.trim());
                    $.each(data.DropDownData.ListOfDepartments, function () {
                        $("#ddlDepartment").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    $("#ddlDepartment").val(Department.trim());
                    $.each(data.DropDownData.ListOfRespC, function () {
                        $("#ddlRespC").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    $("#ddlRespC").val(RespC.trim());
                    HideProgress();
                });
            $("#btnEdit").val("Clear Header Edit");
            $("#ddlDepartment,#ddlRespC").select2({
                width: '100%'
            });
            ShowHeaderEditInput();
        }
        else {
            HideHeaderEditInput();
            $("#btnEdit").val("Edit Header");
        }
    }
    var HideHeaderEditInput = function () {
    $("#txtCampus,#txtDepartment,#txtRespC,#DivPurchaseRegLines").show();
    $("#ddlCampus,#divDepartment,#divRespC,#DivUpdateButton").hide();
    $("#dtPicker,#txtPurpose").css("background-color", "#dedeb");
    $("#txtPurpose").attr("readonly", true);
    }
    var ShowHeaderEditInput = function () {
    $("#txtCampus,#txtDepartment,#txtRespC,#DivPurchaseRegLines").hide();
    $("#ddlCampus,#divDepartment,#divRespC,#DivUpdateButton").show();
    $("#dtPicker,#txtPurpose").css("background", "white");
    $("#txtPurpose").attr("readonly", false);
    }
    var AddAttachment = function () {
    $("#lblTitl").text("File Upload");
    ShowProgress();
    $.ajax({
        async: true,
        type: "GET",
        datatype: "html",
        url: '/Purchase/FileUploadForm',
        success: function (data) {
            $("#modalBody").html(data);
            HideProgress();
            $("#myModal").modal("show");
        },
        error: function (err) {
            HideProgress();
            Swal.fire('Warning', err, 'warning');
        }
    });
    };
    var AddPassengerLines = function () {
        $("#labelF").text("Passenger Form");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Transport/NewPassgerForm',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var SubmitPassengerLine = function () {
        var DocNo = `@Model.No`;
        var EmpType = $("#PassengerType").children("option:selected").val();
        var EmpNo = $("#ddlPassenger").children("option:selected").val();
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/Transport/SubmitPassengerLine",
            data: JSON.stringify({ DocNo: DocNo , PassengerType: EmpType, PassengerNo: EmpNo }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success) {
                    HideProgress();
                    LoadPassengersLines(DocNo, 'Open');
                    $("#myModal").modal("hide");
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var RemoveItem = function (DocNo, EmpNo) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
        if (result.value) {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: "/Transport/RemovePassengerLine",
                data: JSON.stringify({ DocNo: DocNo, PassengerNo: EmpNo }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        LoadPassengersLines(DocNo, 'Open');
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
        else {
            Swal.fire('Cancelled', 'Purchase line has not been deleted', 'error');
        }
    });
    };
    var SendDocForApproval = function () {
        var rowCount = $('#PassengerLines tr').length;
        if (rowCount < 1) {
            Swal.fire('Warning', 'You have not Added any passenger line(s)', 'warning');
            return;
        }
        else {
            var DocNo = `@Model.No`;
            ShowProgress();
            $.ajax({
                async: true,
                type: "POST",
                datatype: "json",
                data: JSON.stringify({ DocNo: DocNo }),
                contentType: "application/json; charset = utf-8",
                processData: false,
                url: '/Transport/SendDocAppForApproval',
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        HideHeaderEditInput();
                        LoadClaimDocumentLines('@Model.No', 'Pending Approval');
                        $("#txtStatus").val("Pending Approval");
                        $("#HideEditButton").hide();
                        $("#HideLineButton").hide();
                        $("#DivSendForApproval").hide();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
</script>


