@model Latest_Staff_Portal.ViewModel.TransportReqList
@{
    ViewBag.Title = "TransportDocumentDetails";
    //Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-title">Transport Document Details</div>
    <div class="card-body">
        <hr />
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Document No</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning" id="DocNo">@Model.No</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Commencement</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.Commencement</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Destination</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.Destination</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Date of Trip</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.DateRequested</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Responsibility Center</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.respC</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Vehicle Allocated</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.Vehicle</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Driver Allocated</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning" id="AppPeriod">@Model.Driver</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">No of Days</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning">@Model.NoOfDays</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding: 2px">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">
                        <label style="font-size: 12px; font-weight: bold">Status</label>
                    </div>
                    <div class="col-md-8">
                        <span class="label label-warning" id="AppPeriod">@Model.Status</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-md-4">

                    </div>
                    <div class="col-md-8">

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


