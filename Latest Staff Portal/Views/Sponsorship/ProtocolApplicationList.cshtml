
@{
    ViewBag.Title = "ProtocolApplicationList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<link href="~/assets/css/Loader.css" rel="stylesheet" />
<div class="loading" align="center" id="divLoader">
    <br />
    <img src="~/assets/images/ajax-loader.gif" alt="" />
</div>
<div class="card pre-scrollable">
    <div class="card-title">My Protocol Application List</div>
    <div class="card-body">
        <a href="#" onclick="NewSponrshipDoc();" class="btn btn-primary BtnPadding">New Protocol Application</a>
        <a href="#" onclick="ViewDocDetails();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <hr />
        <div id="divAppraisalList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadSponsorshipReqList();
    });
    var LoadSponsorshipReqList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/Sponsorship/SponsorshipRequisitionListPartialView",
            success: function (data) {
                HideProgress();
                $("#divAppraisalList").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewSponrshipDoc = function () {
        $("#labelF").text("New Protocol form");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Sponsorship/NewConceptRequisition',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitConceptRequisition = function () {
        var Title = $("#txtTitle").val();
        var AppLevel = $("#ddlAppLevel").children("option:selected").val();
        var Address = $("#txtAddress").val();
        var Email = $("#txtEmail").val();
        var Campus = $("#ddlCampus").children("option:selected").val();
        var School = $("#ddlSchool").children("option:selected").val();
        var Department = $("#ddlDepartment").children("option:selected").val();
        var UploadsCount = 0;
        $("#tableAttachments").find("input[type=file]").each(function (index, field) {
            UploadsCount = field.files.length;
        });
        if (Title == "") {
            Swal.fire('error', 'Enter Concept Title', 'error');
            return;
        }
        else if (AppLevel == "") {
            Swal.fire('error', 'Select Application Level', 'error');
            return;
        }
        else if (Address == "") {
            Swal.fire('error', 'Enter Your Address', 'error');
            return;
        }
        else if (Email == "") {
            Swal.fire('error', 'Enter Your Email', 'error');
            return;
        }
        else if (Campus == "") {
            Swal.fire('error', 'Select Campus', 'error');
            return;
        }
        else if (School == "") {
            Swal.fire('error', 'Select School', 'error');
            return;
        }
        else if (UploadsCount < 1) {
            Swal.fire('error', 'You need to attach document(s)', 'error');
            return;
        }
        else {
            var NewSponsorshipDocument = {};
            NewSponsorshipDocument.Title = Title;
            NewSponsorshipDocument.ApplicationLevel = AppLevel;
            NewSponsorshipDocument.Address = Address;
            NewSponsorshipDocument.Email = Email;
            //NewSponsorshipDocument.PInvest = PInvst;
            NewSponsorshipDocument.School = School;
            NewSponsorshipDocument.Dim1 = Campus;
            NewSponsorshipDocument.Dim2 = Department;

            ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "post",
                url: "/Sponsorship/SubmitSponsorshipDocumentDocument",
                data: JSON.stringify({ NewApp: NewSponsorshipDocument }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        var s = UploadAttachments(data.message);
                        LoadSponsorshipReqList();
                        if (s == true) {
                            $("#myModal").modal("hide");
                            Swal.fire('Success', "Protocol Requisition, Document No: " + data.message + ", Submitted Successfully and attachment File Uploaded Successfully", 'success');
                        }
                        else {
                            Swal.fire('Error', "Protocol Requisition, Document No: " + data.message + ", Submitted Successfully but error encountered while uploading attachment", 'error');
                        }
                    }
                    else {
                        HideProgress();
                        $("#myModal").modal("hide");
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var UploadAttachments = function (DocNo) {
        var s = false;
        ShowProgress();
        $("#tableAttachments").find("input[type=file]").each(function (index, field) {
            for (var i = 0; i < field.files.length; i++) {
                s = false;                
                var file = field.files[i];
                setupReader(file, DocNo);
                s = true
            }
        });
        HideProgress();
        return s;
    }
    function setupReader(file, DocNo) {
        var filename; var base64String; var filetype;
        var blob = file.slice();
        filetype = file.type;
        filename = file.name;

        var reader = new FileReader();
        var reader = new FileReader();
        reader.onloadend = function (evt) {
            if (evt.target.readyState == FileReader.DONE) { // DONE == 2
                var cont = evt.target.result
                base64String = getB64Str(cont);
            };
            //ShowProgress();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/Common/SaveAttachedFile",
                data: JSON.stringify({ DocNo: DocNo, base64Upload: base64String, fileName: filename, Extn: filetype, TableID: 50053 }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                    }
                    //HideProgress();
                },
                error: function () {
                    //HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        };
        reader.readAsArrayBuffer(blob);       
    }
    function getB64Str(buffer) {
        var binary = '';
        var bytes = new Uint8Array(buffer);
        var len = bytes.byteLength;
        for (var i = 0; i < len; i++) {
            binary += String.fromCharCode(bytes[i]);
        }
        return window.btoa(binary);
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            var row = $('#dtSponsorship tr.selectedTableRow');
            //var Status = row.find("td").eq(4).html().trim();
            $("#ViewDoc").removeClass("disabled");
            //AssignSessions();
            //if (Status == "Concept Formulation") {
            //    $("#ViewDoc").removeClass("disabled");
            //    $("#SendDocAppr").removeClass("disabled");
            //    $("#CancelDocAppr").addClass("disabled");
            //    $("#AppTrail").addClass("disabled");
            //}
            //else if (Status == "Pending Approval") {
            //    $("#ViewDoc").removeClass("disabled");
            //    $("#SendDocAppr").addClass("disabled");
            //    $("#CancelDocAppr").removeClass("disabled");
            //    $("#AppTrail").removeClass("disabled");
            //}
            //else if (Status == "Approved") {
            //    $("#ViewDoc").removeClass("disabled");
            //    $("#SendDocAppr").addClass("disabled");
            //    $("#CancelDocAppr").addClass("disabled");
            //    $("#AppTrail").addClass("disabled");
            //}
            //else {
            //    $("#ViewDoc").addClass("disabled");
            //    $("#SendDocAppr").addClass("disabled");
            //    $("#CancelDocAppr").addClass("disabled");
            //    $("#AppTrail").addClass("disabled");
            //}
        });
    }
    var ViewDocDetails = function () {
        $("#labelF").text("Protocol Document Details");
        ShowProgress();
        var row = $('#dtSponsorship tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Sponsorship/SponsorshipDocumentDetails',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                GetImportantDownloads('50053', DocNo);
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetImportantDownloads = function (TableID, DocNo) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ DocNo: DocNo, TableID: TableID, Status: "Open" }),
            url: "/Common/DocumentAttachments",
            success: function (data) {
                HideProgress();
                $("#divAttachDocs").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var ViewAttachment = function (tbl, No, Id, fName, ext) {
        $.ajaxSetup({ cache: false });
        ShowProgress();
        $.ajax({
            cache: false,
            url: '/Common/DocumentAttachmentview',
            type: "POST",
            datatype: "json",
            cache: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            data: JSON.stringify({ tblID: tbl, No: No, ID: Id, fileName: fName, ext: ext }),
            success: function (data) {
                if (data.success == true) {
                    if (data.view == true) {
                        var viewer = $("#modalAttachmentBody");
                        if (ext == "pdf") {
                            PDFObject.embed("data:application/" + ext + ";base64," + data.message + "", viewer);
                        }
                        if (ext == "png" || ext == "jpg") {
                            PDFObject.embed("data:image/" + ext + ";base64," + data.message + "", viewer);
                        }
                        $("#myModalAttachment").modal("show");
                        HideProgress();
                    }
                    else {
                        window.location = '/Common/AttachmentDownload?fileName=' + data.message;
                        Swal.fire('Success', 'Document Downloaded successfully', 'success');
                        HideProgress();
                    }
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var DeleteAttachment = function (tbl, No, Id) {
        $.ajaxSetup({ cache: false });
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    cache: false,
                    url: '/Common/DeleteAttachedDocument',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ DocNo: No, tblID: tbl, DocID: Id }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            GetImportantDownloads('50053', No);
                            Swal.fire('Success', 'File Deleted Successfully', 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Attachment File has not been deleted', 'error');
            }
        });
    };
    var SendDocForApproval = function () {
        $("#labelF").text("Sponsorship Document Details");
        var row = $('#dtSponsorship tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Sponsorship/SendDocAppForApproval',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadSponsorshipReqList
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
        DiableButtons();
        HideProgress();
    }
    var CancelLeaveDocForApproval = function () {
        $("#labelF").text("Leave Details Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Leave/CancelLeaveAppForApproval',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadSponsorshipReqList();
                    DiableButtons();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });

    }
    var ViewLeaveApprovalTrail = function () {
        $("#labelF").text("Document Approval Status");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Leave/LeaveDocumentApprovalTrail',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DiableButtons = function () {
        $("#ViewDoc").addClass("disabled");
        $("#SendDocAppr").addClass("disabled");
        $("#CancelDocAppr").addClass("disabled");
        $("#AppTrail").addClass("disabled");
        $('table tbody tr').siblings().removeClass("selectedTableRow");
    }
</script>


