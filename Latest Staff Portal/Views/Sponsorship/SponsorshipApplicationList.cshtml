
@{
    ViewBag.Title = "SponsorshipApplicationList";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    .selectedTableRow {
        background-color: #74788d;
        color: white;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div style="background-color:black">
    <a href="#" onclick="SponsorshipRequisitionLink();" style="color:yellow"><<< Back To Sponsorship Application</a>
</div>
<div class="card pre-scrollable">
    <div class="card-title">My Sponsorship Application List</div>
    <div class="card-body">
        <a href="#" onclick="NewSponrshipDoc();" class="btn btn-primary BtnPadding">New Sponsorship Application</a>
        <a href="#" onclick="ViewDocDetails();" class="btn btn-danger BtnPadding disabled" id="ViewDoc">View Document</a>
        <a href="#" onclick="SendDocForApproval();" class="btn btn-primary BtnPadding disabled" id="SendDocAppr">Send Approval Request</a>
        <a href="#" onclick="CancelDocForApproval();" class="btn btn-danger BtnPadding disabled" id="CancelDocAppr">Cancel Approval Request</a>
        <a href="#" onclick="ViewApprovalTrail();" class="btn btn-primary BtnPadding disabled" id="AppTrail">Document Approval Status</a>
        <hr />
        <div id="divAppraisalList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content bg-white">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelF"></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect " data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadSponsorshipReqList();
    });
    var LoadSponsorshipReqList = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/Sponsorship/SponsorshipRequisitionListPartialView",
            success: function (data) {
                HideProgress();
                $("#divAppraisalList").html(data);
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewSponrshipDoc = function () {
        $("#labelF").text("New Concept Document");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Sponsorship/NewConceptRequisition',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SubmitConceptRequisition = function () {
        var Title = $("#txtTitle").val();
        var Objective = $("#txtObjective").val();
        var Address = $("#txtAddress").val();
        var Email = $("#txtEmail").val();
        var PInvst = $("#ddlPInvest").children("option:selected").val();
        var ResponC = $("#ddlRespC").children("option:selected").val();
        var Campus = $("#ddlCampus").children("option:selected").val();
        var Department = $("#ddlDepartment").children("option:selected").val();
        if (Title == "") {
            Swal.fire('error', 'Enter Concept Title', 'error');
            return;
        }
        else if (Objective == "") {
            Swal.fire('error', 'Enter Concept Objective', 'error');
            return;
        }
        else if (Address == "") {
            Swal.fire('error', 'Enter Your Address', 'error');
            return;
        }
        else if (Email == "") {
            Swal.fire('error', 'Enter Your Email', 'error');
            return;
        }
        else if (PInvst == "") {
            Swal.fire('error', 'Select Principal Investigator', 'error');
            return;
        }
        else if (ResponC == "") {
            Swal.fire('error', 'Select Responsibility Center', 'error');
            return;
        }
        else if (Campus == "") {
            Swal.fire('error', 'Select Campus', 'error');
            return;
        }
        else if (Department == "") {
            Swal.fire('error', 'Select Department', 'error');
            return;
        }
        else {
            var NewSponsorshipDocument = {};
            NewSponsorshipDocument.Title = Title;
            NewSponsorshipDocument.Objective = Objective;
            NewSponsorshipDocument.Address = Address;
            NewSponsorshipDocument.Email = Email;
            NewSponsorshipDocument.PInvest = PInvst;
            NewSponsorshipDocument.RespC = ResponC;
            NewSponsorshipDocument.Dim1 = Campus;
            NewSponsorshipDocument.Dim2 = Department;
            ShowProgress();
            $.ajax({
                type: "post",
                url: "/Sponsorship/SubmitSponsorshipDocumentDocument",
                data: JSON.stringify({ NewApp: NewSponsorshipDocument }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadSponsorshipReqList();
                        $("#myModal").modal("hide");                        
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        $("#myModal").modal("hide");                        
                        Swal.fire('error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('error', data.message, 'error');
                }
            });
        }
    }
    var SelectedRow = function () {
        $('table tbody tr').click(function () {
            $(this).addClass("selectedTableRow").siblings().removeClass("selectedTableRow");
            var row = $('#dtSponsorship tr.selectedTableRow');
            var Status = row.find("td").eq(4).html().trim();
            //AssignSessions();
            if (Status == "Concept Formulation") {
                $("#ViewDoc").removeClass("disabled");
                $("#SendDocAppr").removeClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else if (Status == "Pending Approval") {
                $("#ViewDoc").removeClass("disabled");
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").removeClass("disabled");
                $("#AppTrail").removeClass("disabled");
            }
            else if (Status == "Approved") {
                $("#ViewDoc").removeClass("disabled");
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
            else {
                $("#ViewDoc").addClass("disabled");
                $("#SendDocAppr").addClass("disabled");
                $("#CancelDocAppr").addClass("disabled");
                $("#AppTrail").addClass("disabled");
            }
        });
    }
    var ViewDocDetails = function () {
        $("#labelF").text("Sponsorship Document Details");
        ShowProgress();
        var row = $('#dtSponsorship tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Sponsorship/SponsorshipDocumentDetails',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var SendDocForApproval = function () {
        $("#labelF").text("Sponsorship Document Details");
        var row = $('#dtSponsorship tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Sponsorship/SendDocAppForApproval',
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadSponsorshipReqList
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
        DiableButtons();
        HideProgress();
    }    
    var CancelLeaveDocForApproval = function () {
        $("#labelF").text("Leave Details Document");
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Leave/CancelLeaveAppForApproval',
            success: function (data) {                
                if (data.success == true) {
                    HideProgress();
                    LoadSponsorshipReqList();
                    DiableButtons();                    
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    DiableButtons();
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });

    }
    var ViewLeaveApprovalTrail = function () {
        $("#labelF").text("Document Approval Status");        
        var row = $('#datatable-buttons tr.selectedTableRow');
        var DocNo = row.find("td").eq(1).html().trim();
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Leave/LeaveDocumentApprovalTrail',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var DiableButtons = function () {
        $("#ViewDoc").addClass("disabled");
        $("#SendDocAppr").addClass("disabled");
        $("#CancelDocAppr").addClass("disabled");
        $("#AppTrail").addClass("disabled");
        $('table tbody tr').siblings().removeClass("selectedTableRow");
    }
    var SponsorshipRequisitionLink = function () {
        ShowProgress();
        window.location = "/Sponsorship/ConceptApplicationList";
    }
</script>

