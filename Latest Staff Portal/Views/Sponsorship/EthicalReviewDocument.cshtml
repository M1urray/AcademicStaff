@model Latest_Staff_Portal.ViewModel.NewSponsorshipDocument
<div class="row" style="padding: 2px">
    <div class="col-md-6">
        Document No
        @Html.TextBoxFor(m => m.No, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
    <div class="col-md-6">
        Protocol Title
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
</div>
<div class="row" style="padding: 2px">
    <div class="col-md-6">
        Application Level
        @Html.TextBoxFor(m => m.ApplicationLevel, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
    <div class="col-md-6">
        Address
        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
</div>
<div class="row" style="padding: 2px">
    <div class="col-md-6">
        Email
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
    <div class="col-md-6">
        School
        @Html.TextBoxFor(m => m.School, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
</div>
<div class="row" style="padding: 2px">
    <div class="col-md-6">
        Campus
        @Html.TextBoxFor(m => m.Dim1, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
    <div class="col-md-6">
        Department
        @Html.TextBoxFor(m => m.Dim2, new { @class = "form-control", @readonly = "readonly", @style = "background-color:#dedebd" })
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <b>Attachments</b>
        <div id="divAttachDocs"></div>
    </div>
</div>
<hr />
<div class="container" style="border:2px solid black">
    <h4>CRITERIA OF REVIEW</h4>
    <hr />
    <div class="row">
        <div class="col-md-12">
            1. The scientific validity of the research question
            <textarea rows="3" id="txtCr1" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            2. The relevance of the proposed study to the health needs of the study community
            <textarea rows="3" id="txtCr2" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            3. The risks to potential research participants and how they will be minimized
            <textarea rows="3" id="txtCr3" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            4. Protection rights and welfare of vulnerable participants
            <textarea rows="3" id="txtCr4" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            5. Obtaining informed consent/assent from research participants
            <textarea rows="3" id="txtCr5" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            6. The use of identifiable or potentially identifiable information
            <textarea rows="3" id="txtCr6" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            7. Plans for collection, storage and protection of research data and biological samples
            <textarea rows="3" id="txtCr7" class="form-control"></textarea>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12">
            8. Provisions for compensation of research participants for their time, transport costs or lost wages
            <textarea rows="3" id="txtCr8" class="form-control"></textarea>
        </div>
    </div>
    <hr />
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        Recommendations
        <select class="form-control" id="Recomm">
            <option value="">----</option>
            <option value="1">Approved</option>
            <option value="2">Rejected</option>
            <option value="3">Conditionally Approved</option>
        </select>
    </div>
    <div class="col-md-6"></div>
</div>

<hr />
<div align="center">
    <input type="button" class="btn btn-primary waves-effect waves-light" value="Submit Review" onclick="SubmitConceptReview('@Model.ProposalNo');" />
</div>
