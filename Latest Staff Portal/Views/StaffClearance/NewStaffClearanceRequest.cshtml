@model Latest_Staff_Portal.ViewModel.StaffClearance
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 7px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<div class="card pre-scrollable">
    <div class="card-body">
        <b>Staff Clearance Form</b>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Staff No", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.StaffNo, new { @class = "form-control", @id = "txtStaffNo" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Staff Name", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.StaffName, new { @class = "form-control", @id = "txtStaffName" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Department, new { @class = "form-control", @id = "txtDepartment" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("DepartmentName", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.DepartmentName, new { @class = "form-control", @id = "txtDepartmentName" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("ID Number", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.IDNo, new { @class = "form-control", @id = "txtIDNo" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Date of Appointment", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.DateOfAppointment, new { @class = "form-control", @id = "txtAppointDate" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Phone Number", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", @id = "txtPhoneNumber" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Personal Email", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @id = "txtEmail" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Address", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Address, new { @class = "form-control", @id = "txtAddress" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Last Date of Service", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.LastDateOfService, new { @class = "form-control", @id = "txtLastDateOfService" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Reason for Clearing", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <textarea id="txtReason" class="form-control"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Submit Clearance" onclick="SubmitClearanceRequest();" />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#txtLastDateOfService,#txtAppointDate').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-5:+5',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy'
        });
        document.getElementById("txtStaffNo").disabled = true;
        document.getElementById("txtStaffName").disabled = true;
        document.getElementById("txtDepartment").disabled = true;
        document.getElementById("txtDepartmentName").disabled = true;
        document.getElementById("txtIDNo").disabled = true;
        document.getElementById("txtPhoneNumber").disabled = true;
        document.getElementById("txtEmail").disabled = true;
        document.getElementById("txtAddress").disabled = true;
    });
</script>

