@model Latest_Staff_Portal.ViewModel.StaffClearance
<style>
    thead {
        background-color: black;
        color: white;
    }

    .BtnPadding {
        padding: 7px;
        font-size: 12px;
    }

    .NoRecords {
        background-color: #dedbdb
    }
</style>
<div class="card pre-scrollable">
    <div class="card-body">
        <b>Staff Clearance Form</b>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Staff No", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.StaffNo, new { @class = "form-control", @id = "txtStaffNo" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Staff Name", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.StaffName, new { @class = "form-control", @id = "txtStaffName" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Department", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Department, new { @class = "form-control", @id = "txtDepartment" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("DepartmentName", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.DepartmentName, new { @class = "form-control", @id = "txtDepartmentName" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("ID Number", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.IDNo, new { @class = "form-control", @id = "txtIDNo" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Date of Appointment", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.DateOfAppointment, new { @class = "form-control", @id = "txtAppointDate" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Phone Number", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", @id = "txtPhoneNumber" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Personal Email", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @id = "txtEmail" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Address", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.Address, new { @class = "form-control", @id = "txtAddress" })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Last Date of Service", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        @Html.TextBoxFor(model => model.LastDateOfService, new { @class = "form-control", @id = "txtLastDateOfService" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Reason for Clearing", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <select id="txtReason" class="form-control">
                            <option value="">Select an option</option>
                            <option value="Resignation">Resignation</option>
                            <option value="Termination">Termination</option>
                            <option value="Dismissal">Dismissal</option>
                            <option value="Retirement">Retirement</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <b>Provident Fund </b>
        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Member’s benefits (please tick)", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <select id="member_benefits" name="member_benefits">
                            <option value="">Select an option</option>
                            <option value="Cash">Full cash surrender</option>
                            <option value="Retain">Retain my accumulated contributions in the scheme until further notice</option>
                            <option value="Transfer">Transfer to: New employer’s scheme Pension Plan</option>
                            <option value="Transfer2">Transfer to: Personal Pension Plan</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Employer’s Benefits(please select whichever is applicable)", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <select id="employer_benefit_option" name="employer_benefit_option" onchange="showHideEmployerBalanceOption()">
                            <!-- ... options ... -->
                            <option value="Immediate">Immediate payment of fifty percent (50%) of your employer’s contributions and the investment income accrued thereon;</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("The fifty percent (50%) balance of the employer portion of the member’s entitlement would either be", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <select id="employer_balance_option_select" name="employer_benefit_option" onchange="showHideEmployerBalanceOption()">
                            <!-- ... options ... -->
                            <option value="Transfer3">Transfer to: New employer’s scheme Pension Plan</option>
                            <option value="Transfer4">Transfer to: Personal Pension Plan</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <hr />

        <div align="center">
            <input type="button" class="btn btn-primary waves-effect waves-light" value="Submit Clearance" onclick="SubmitClearanceRequest();" />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#txtLastDateOfService,#txtAppointDate').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-5:+5',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy'
        });
        document.getElementById("txtStaffNo").disabled = true;
        document.getElementById("txtStaffName").disabled = true;
        document.getElementById("txtDepartment").disabled = true;
        document.getElementById("txtDepartmentName").disabled = true;
        document.getElementById("txtIDNo").disabled = true;
        document.getElementById("txtPhoneNumber").disabled = true;
        document.getElementById("txtEmail").disabled = true;
        document.getElementById("txtAddress").disabled = true;
        document.getElementById("employer_balance_option").disabled = true;
    });
    function showHideEmployerBalanceOption() {
        var employerBenefitOption = document.getElementById("employer_benefit_option");
        var employerBalanceOption = document.getElementById("employer_balance_option");

        if (employerBenefitOption.value === "Immediate") {
            employerBalanceOption.style.display = "block";
        } else {
            employerBalanceOption.style.display = "none";
        }
    }
</script>

