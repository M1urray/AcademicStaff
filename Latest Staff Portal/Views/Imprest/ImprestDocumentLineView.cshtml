@model Latest_Staff_Portal.ViewModel.ImprestLinesList
<div class="table-responsive">
    <table id="datatable-buttons" class="table table-bordered dt-responsive nowrap">
        <thead>
            <tr>
                <th>Advance Type</th>
                <th>Account No</th>
                <th>Account Name</th>
                <th>Description</th>
                <th style="text-align:center">No. Days</th>
                <th style="text-align:center">Unit Amount</th>
                <th style="text-align:center">Amount</th>
                @if (Model.Status == "Open" || Model.Status == "Pending")
                {
                    <th class="tdAction">Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfImprestLines != null && Model.ListOfImprestLines.Count() > 0)
                {
                    foreach (var item in Model.ListOfImprestLines)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.AdvanceType)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Item)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ItemDesc)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ItemDesc2)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.NoDays)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.UnitAmount)
                            </td>
                            <td style="text-align:center">
                                @Html.DisplayFor(modelItem => item.Amount)
                            </td>
                            @if (Model.Status == "Open" || Model.Status == "Pending")
                            {
                                <td style="text-align:right" class="tdAction">
                                    <a href="javascript:void(0);" class="mr-3 text-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit" onclick="EditItem('@item.DocNo','@item.LnNo');"><i class="mdi mdi-pencil font-size-16"></i></a>
                                    <a href="javascript:void(0);" class="text-danger" data-toggle="tooltip" data-placement="top" title="" data-original-title="Delete" onclick="RemoveItem('@item.DocNo','@item.LnNo');"><i class="mdi mdi-close font-size-16"></i></a>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@if (Model.Status == "Open" || Model.Status == "Pending")
{
    <div style="text-align:right">
        <input type="button" value="Add Item Line" class="btn btn-danger BtnPadding" onclick="AddImprestLines();" />
    </div>
}

